diff --git a/kernel/persistenceaudit.c b/kernel/persistenceaudit.c
new file mode 100644
index 0000000000000000000000000000000000000000..8f2ab83ee514c08a965194ede449d314658e453e
--- /dev/null
+++ b/kernel/persistenceaudit.c
@@ -0,0 +1,416 @@
+#include "types.h"
+#include "param.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "sleeplock.h"
+#include "proc.h"
+#include "defs.h"
+#include "fs.h"
+#include "buf.h"
+#include "persistenceaudit.h"
+
+extern int cacheproject_partition(uint, uint);
+struct pa_holder {
+  int active;
+  int pid;
+  int released;
+};
+
+static struct {
+  struct spinlock lock;
+  int active;
+  int capture_cache;
+  int capture_log;
+  uint64 generation;
+  uint64 next_seq;
+  int count;
+  int error;
+  int pair;
+  int target1;
+  int target2;
+  int domain1;
+  int domain2;
+  int arrived;
+  int gate_open;
+  int log_n;
+  int outstanding;
+  int committing;
+  struct pa_holder holder[PA_MAX_HOLDERS];
+  struct pa_record record[PA_MAX_RECORDS];
+} audit;
+
+void
+persistenceaudit_init(void)
+{
+  initlock(&audit.lock, "persistenceaudit");
+}
+
+static void
+reset_locked(uint64 generation)
+{
+  memset(audit.record, 0, sizeof(audit.record));
+  memset(audit.holder, 0, sizeof(audit.holder));
+  audit.active = generation != 0;
+  audit.capture_cache = 0;
+  audit.capture_log = 0;
+  audit.generation = generation;
+  audit.next_seq = 1;
+  audit.count = 0;
+  audit.error = 0;
+  audit.pair = 0;
+  audit.target1 = 0;
+  audit.target2 = 0;
+  audit.domain1 = -1;
+  audit.domain2 = -1;
+  audit.arrived = 0;
+  audit.gate_open = 0;
+  audit.log_n = 0;
+  audit.outstanding = 0;
+  audit.committing = 0;
+}
+
+static int
+target_locked(int pid)
+{
+  if (!audit.pair)
+    return 1;
+  return pid == audit.target1 || pid == audit.target2;
+}
+
+static void
+record_locked(int point, int domain, int slot, uint dev, uint blockno,
+              uint64 buffer_generation, int refcnt, int log_n,
+              int outstanding, int committing, int aux)
+{
+  struct pa_record *r;
+  struct proc *p;
+
+  if (!audit.active)
+    return;
+  if (audit.count >= PA_MAX_RECORDS) {
+    audit.error = 1;
+    audit.gate_open = 1;
+    return;
+  }
+  r = &audit.record[audit.count++];
+  p = myproc();
+  r->generation = audit.generation;
+  r->seq = audit.next_seq++;
+  r->point = point;
+  r->pid = p ? p->pid : 0;
+  r->hart = cpuid();
+  r->domain = domain;
+  r->slot = slot;
+  r->refcnt = refcnt;
+  r->dev = dev;
+  r->blockno = blockno;
+  r->buffer_generation = buffer_generation;
+  r->log_n = log_n;
+  r->outstanding = outstanding;
+  r->committing = committing;
+  r->aux = aux;
+}
+
+void
+persistenceaudit_cache_event(int point, int domain, int slot, uint dev,
+                             uint blockno, uint64 buffer_generation, int refcnt)
+{
+  struct proc *p = myproc();
+
+  acquire(&audit.lock);
+  if (audit.active && audit.capture_cache && p != 0 && target_locked(p->pid))
+    record_locked(point, domain, slot, dev, blockno, buffer_generation,
+                  refcnt, audit.log_n, audit.outstanding, audit.committing, 0);
+  release(&audit.lock);
+}
+
+void
+persistenceaudit_cache_gate(int point, int domain, uint dev, uint blockno)
+{
+  struct proc *p = myproc();
+  int expected_point;
+  int bit = 0;
+  uint64 spins = 0;
+
+  acquire(&audit.lock);
+  expected_point = audit.domain1 == audit.domain2 ? PA_CACHE_SLEEP
+                                                  : PA_CACHE_GUARD;
+  if (audit.active && audit.capture_cache && audit.pair &&
+      point == expected_point && p != 0) {
+    if (p->pid == audit.target1 && domain == audit.domain1)
+      bit = 1;
+    else if (p->pid == audit.target2 && domain == audit.domain2)
+      bit = 2;
+    if (bit != 0 && (audit.arrived & bit) == 0) {
+      audit.arrived |= bit;
+      if (audit.arrived == 3) {
+        audit.gate_open = 1;
+        wakeup(&audit);
+      }
+    }
+  }
+  if (bit == 0) {
+    release(&audit.lock);
+    return;
+  }
+  if (expected_point == PA_CACHE_SLEEP) {
+    while (!audit.gate_open && !audit.error && audit.active)
+      sleep(&audit, &audit.lock);
+    release(&audit.lock);
+    return;
+  }
+  release(&audit.lock);
+  for (;;) {
+    int open;
+    acquire(&audit.lock);
+    if (++spins == 10000000 && !audit.gate_open) {
+      audit.error = 2;
+      audit.gate_open = 1;
+    }
+    open = audit.gate_open || audit.error || !audit.active;
+    release(&audit.lock);
+    if (open)
+      break;
+  }
+}
+
+void
+persistenceaudit_log_event(int point, uint blockno, int log_n,
+                           int outstanding, int committing, int aux)
+{
+  acquire(&audit.lock);
+  audit.log_n = log_n;
+  audit.outstanding = outstanding;
+  audit.committing = committing;
+  if (audit.active && audit.capture_log)
+    record_locked(point, -1, -1, ROOTDEV, blockno, 0, -1, log_n,
+                  outstanding, committing, aux);
+  release(&audit.lock);
+}
+
+void
+persistenceaudit_io_event(int point, struct buf *b, int write)
+{
+  struct cacheproject_view view;
+
+  if (cacheproject_snapshot_buffer(b, &view) < 0) {
+    acquire(&audit.lock);
+    if (audit.active)
+      audit.error = 3;
+    release(&audit.lock);
+    return;
+  }
+  acquire(&audit.lock);
+  if (audit.active && (audit.capture_cache || audit.capture_log))
+    record_locked(point, view.partition, view.slot, view.dev, view.blockno,
+                  view.generation, view.refcnt, audit.log_n,
+                  audit.outstanding, audit.committing, write);
+  release(&audit.lock);
+}
+
+static int
+holder_wait(int transaction, uint blockno)
+{
+  struct pa_holder *h = 0;
+  struct buf *b = 0;
+  int i, value = 0;
+
+  if (transaction) {
+    begin_op();
+    if (blockno != 0) {
+      b = bread(ROOTDEV, blockno);
+      b->data[0] ^= 1;
+      log_write(b);
+      brelse(b);
+      b = 0;
+    }
+  } else
+    b = bread(ROOTDEV, blockno);
+  if (b != 0)
+    value = (uchar)b->data[0];
+  acquire(&audit.lock);
+  for (i = 0; i < PA_MAX_HOLDERS; i++) {
+    if (!audit.holder[i].active) {
+      h = &audit.holder[i];
+      h->active = 1;
+      h->pid = myproc()->pid;
+      h->released = 0;
+      break;
+    }
+  }
+  if (h == 0) {
+    release(&audit.lock);
+    if (transaction)
+      end_op();
+    else
+      brelse(b);
+    return -1;
+  }
+  while (!h->released)
+    sleep(h, &audit.lock);
+  h->active = 0;
+  release(&audit.lock);
+  if (transaction)
+    end_op();
+  else
+    brelse(b);
+  return transaction ? 0 : value;
+}
+
+static void
+release_holders(int pid)
+{
+  int i;
+
+  for (i = 0; i < PA_MAX_HOLDERS; i++) {
+    if (audit.holder[i].active && (pid == 0 || audit.holder[i].pid == pid)) {
+      audit.holder[i].released = 1;
+      wakeup(&audit.holder[i]);
+    }
+  }
+}
+
+static int
+copy_status(uint64 out)
+{
+  struct pa_status status;
+  int i;
+
+  acquire(&audit.lock);
+  memset(&status, 0, sizeof(status));
+  status.generation = audit.generation;
+  status.count = audit.count;
+  status.error = audit.error;
+  status.arrived = audit.arrived;
+  status.gate_open = audit.gate_open;
+  status.log_n = audit.log_n;
+  status.outstanding = audit.outstanding;
+  status.committing = audit.committing;
+  for (i = 0; i < PA_MAX_HOLDERS; i++)
+    status.holders += audit.holder[i].active;
+  release(&audit.lock);
+  return copyout(myproc()->pagetable, out, (char *)&status, sizeof(status));
+}
+
+static int
+copy_records(int cursor, uint64 out, int max)
+{
+  struct pa_record local[16];
+  int count, i;
+
+  if (cursor < 0 || max < 0 || max > 16)
+    return -1;
+  acquire(&audit.lock);
+  count = audit.count - cursor;
+  if (count < 0)
+    count = 0;
+  if (count > max)
+    count = max;
+  for (i = 0; i < count; i++)
+    local[i] = audit.record[cursor + i];
+  release(&audit.lock);
+  if (count > 0 && copyout(myproc()->pagetable, out, (char *)local,
+                           count * sizeof(local[0])) < 0)
+    return -1;
+  return count;
+}
+
+static int
+copy_cache(uint64 out)
+{
+  struct cacheproject_view view[NBUF];
+  int i;
+
+  for (i = 0; i < NBUF; i++) {
+    if (cacheproject_snapshot(i, &view[i]) < 0)
+      return -1;
+  }
+  return copyout(myproc()->pagetable, out, (char *)view, sizeof(view));
+}
+
+int
+persistenceaudit_command(int op, uint64 a, uint64 b, uint64 c, uint64 d,
+                         uint64 e)
+{
+  struct buf *bp;
+  int i;
+
+  if (op == PA_RESET) {
+    acquire(&audit.lock);
+    for (i = 0; i < PA_MAX_HOLDERS; i++) {
+      if (audit.holder[i].active) {
+        release(&audit.lock);
+        return -1;
+      }
+    }
+    reset_locked(0);
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == PA_ARM) {
+    if (a == 0 || b < 1 || b > 3)
+      return -1;
+    acquire(&audit.lock);
+    reset_locked(a);
+    audit.capture_cache = b & 1;
+    audit.capture_log = b & 2;
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == PA_ARM_PAIR) {
+    if (a == 0 || b == 0 || c == 0)
+      return -1;
+    acquire(&audit.lock);
+    reset_locked(a);
+    audit.pair = 1;
+    audit.target1 = b;
+    audit.target2 = c;
+    audit.domain1 = d;
+    audit.domain2 = e;
+    audit.capture_cache = 1;
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == PA_READ_BLOCK) {
+    if (a >= FSSIZE)
+      return -1;
+    bp = bread(ROOTDEV, a);
+    int value = (uchar)bp->data[0];
+    brelse(bp);
+    return value;
+  }
+  if (op == PA_HOLD_BLOCK)
+    return a < FSSIZE ? holder_wait(0, a) : -1;
+  if (op == PA_HOLD_TXN)
+    return holder_wait(1, 0);
+  if (op == PA_HOLD_TXN_BLOCK)
+    return a > 0 && a < FSSIZE ? holder_wait(1, a) : -1;
+  if (op == PA_RELEASE_PID || op == PA_RELEASE_ALL) {
+    acquire(&audit.lock);
+    release_holders(op == PA_RELEASE_PID ? (int)a : 0);
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == PA_STATUS)
+    return copy_status(a);
+  if (op == PA_FETCH)
+    return copy_records(a, b, c);
+  if (op == PA_CACHE_SNAPSHOT)
+    return copy_cache(a);
+  if (op == PA_LOG_TWICE) {
+    if (a >= FSSIZE)
+      return -1;
+    begin_op();
+    bp = bread(ROOTDEV, a);
+    bp->data[0] = 0x51;
+    log_write(bp);
+    bp->data[1] = 0x52;
+    log_write(bp);
+    brelse(bp);
+    end_op();
+    return 0;
+  }
+  if (op == PA_PARTITION)
+    return a < FSSIZE ? cacheproject_partition(ROOTDEV, a) : -1;
+  return -1;
+}
diff --git a/kernel/persistenceaudit.h b/kernel/persistenceaudit.h
new file mode 100644
index 0000000000000000000000000000000000000000..b966b2f5a4f3df904d8225c7595e83ead4e3d8ff
--- /dev/null
+++ b/kernel/persistenceaudit.h
@@ -0,0 +1,88 @@
+#define PA_ABI 1
+#define PA_MAX_RECORDS 512
+#define PA_MAX_HOLDERS NBUF
+
+#define PA_RESET          1
+#define PA_ARM            2
+#define PA_ARM_PAIR       3
+#define PA_READ_BLOCK     4
+#define PA_HOLD_BLOCK     5
+#define PA_HOLD_TXN       6
+#define PA_RELEASE_PID    7
+#define PA_RELEASE_ALL    8
+#define PA_STATUS         9
+#define PA_FETCH          10
+#define PA_CACHE_SNAPSHOT 11
+#define PA_LOG_TWICE      12
+#define PA_PARTITION      13
+#define PA_HOLD_TXN_BLOCK 14
+
+#define PA_CACHE_LOOKUP  1
+#define PA_CACHE_GUARD   2
+#define PA_CACHE_HIT     3
+#define PA_CACHE_PUBLISH 4
+#define PA_CACHE_SLEEP   5
+#define PA_CACHE_RELEASE 6
+#define PA_CACHE_PIN     7
+#define PA_CACHE_UNPIN   8
+
+#define PA_LOG_WAIT_COMMIT 20
+#define PA_LOG_WAIT_SPACE  21
+#define PA_LOG_ADMIT       22
+#define PA_LOG_END         23
+#define PA_LOG_APPEND      24
+#define PA_LOG_ABSORB      25
+#define PA_LOG_PAYLOAD     26
+#define PA_LOG_HEADER      27
+#define PA_LOG_HOME        28
+#define PA_LOG_CLEAR       29
+#define PA_LOG_COMMIT_DONE 30
+
+#define PA_IO_SUBMIT   40
+#define PA_IO_COMPLETE 41
+
+struct pa_record {
+  uint64 generation;
+  uint64 seq;
+  int point;
+  int pid;
+  int hart;
+  int domain;
+  int slot;
+  int refcnt;
+  uint dev;
+  uint blockno;
+  uint64 buffer_generation;
+  int log_n;
+  int outstanding;
+  int committing;
+  int aux;
+};
+
+struct pa_status {
+  uint64 generation;
+  int count;
+  int error;
+  int arrived;
+  int gate_open;
+  int holders;
+  int log_n;
+  int outstanding;
+  int committing;
+};
+
+struct cacheproject_view {
+  int slot;
+  int partition;
+  int named;
+  int refcnt;
+  int valid;
+  int disk;
+  int locked;
+  uint dev;
+  uint blockno;
+  uint64 generation;
+};
+
+void persistenceaudit_cache_event(int, int, int, uint, uint, uint64, int);
+void persistenceaudit_cache_gate(int, int, uint, uint);
