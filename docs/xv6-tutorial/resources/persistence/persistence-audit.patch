diff --git a/user/persisttrace.c b/user/persisttrace.c
new file mode 100644
index 0000000000000000000000000000000000000000..c66b6c5c24445e27492aa5d9c59e1a26ac9c5ee1
--- /dev/null
+++ b/user/persisttrace.c
@@ -0,0 +1,386 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/param.h"
+#include "kernel/persistenceaudit.h"
+#include "user/user.h"
+
+static void
+fail(char *message)
+{
+  printf("PERSIST FAIL reason=%s\n", message);
+  exit(1);
+}
+
+static void
+status(struct pa_status *s)
+{
+  if (persistenceaudit(PA_STATUS, (uint64)s, 0, 0, 0, 0) < 0)
+    fail("status");
+}
+
+static void
+wait_holders(int expected)
+{
+  struct pa_status s;
+  int i;
+
+  for (i = 0; i < 500; i++) {
+    status(&s);
+    if (s.error)
+      fail("audit-error");
+    if (s.holders == expected)
+      return;
+    pause(1);
+  }
+  fail("holders-watchdog");
+}
+
+static int
+have_event(int pid, int point, int refcnt)
+{
+  struct pa_status s;
+  struct pa_record r[16];
+  int cursor = 0, n, i;
+
+  status(&s);
+  while (cursor < s.count) {
+    n = persistenceaudit(PA_FETCH, cursor, (uint64)r, 16, 0, 0);
+    if (n < 0)
+      fail("fetch");
+    for (i = 0; i < n; i++) {
+      if ((pid == 0 || r[i].pid == pid) && r[i].point == point &&
+          (refcnt < 0 || r[i].refcnt == refcnt))
+        return 1;
+    }
+    cursor += n;
+  }
+  return 0;
+}
+
+static void
+wait_event(int pid, int point, int refcnt)
+{
+  int i;
+
+  for (i = 0; i < 500; i++) {
+    if (have_event(pid, point, refcnt))
+      return;
+    pause(1);
+  }
+  fail("event-watchdog");
+}
+
+static void
+print_evidence(char *name, uint64 generation)
+{
+  struct pa_status s;
+  struct pa_record r[16];
+  struct cacheproject_view view[NBUF];
+  int cursor = 0, n, i, refs = 0, locks = 0, disk = 0;
+
+  status(&s);
+  printf("PERSIST META case=%s abi=%d generation=%ld count=%d error=%d arrived=%d gate=%d holders=%d\n",
+         name, PA_ABI, generation, s.count, s.error, s.arrived, s.gate_open,
+         s.holders);
+  while (cursor < s.count) {
+    n = persistenceaudit(PA_FETCH, cursor, (uint64)r, 16, 0, 0);
+    if (n <= 0)
+      fail("print-fetch");
+    for (i = 0; i < n; i++) {
+      printf("PERSIST EVENT generation=%ld seq=%ld point=%d pid=%d hart=%d domain=%d slot=%d ref=%d dev=%u block=%u buffer_generation=%ld log_n=%d outstanding=%d committing=%d aux=%d\n",
+             r[i].generation, r[i].seq, r[i].point, r[i].pid, r[i].hart,
+             r[i].domain, r[i].slot, r[i].refcnt, r[i].dev, r[i].blockno,
+             r[i].buffer_generation, r[i].log_n, r[i].outstanding,
+             r[i].committing, r[i].aux);
+    }
+    cursor += n;
+  }
+  if (persistenceaudit(PA_CACHE_SNAPSHOT, (uint64)view, 0, 0, 0, 0) < 0)
+    fail("cache-snapshot");
+  for (i = 0; i < NBUF; i++) {
+    printf("PERSIST BUFFER generation=%ld slot=%d domain=%d named=%d ref=%d valid=%d disk=%d locked=%d dev=%u block=%u buffer_generation=%ld\n",
+           generation, view[i].slot, view[i].partition, view[i].named,
+           view[i].refcnt, view[i].valid, view[i].disk, view[i].locked,
+           view[i].dev, view[i].blockno, view[i].generation);
+    refs += view[i].refcnt;
+    locks += view[i].locked;
+    disk += view[i].disk;
+  }
+  printf("PERSIST LEDGER case=%s generation=%ld refs=%d locks=%d disk=%d log_n=%d outstanding=%d committing=%d error=%d\n",
+         name, generation, refs, locks, disk, s.log_n, s.outstanding,
+         s.committing, s.error);
+}
+
+static int
+spawn_reader(int block, int hold, int startfd, int resultfd)
+{
+  int pid = fork();
+  if (pid < 0)
+    fail("fork");
+  if (pid == 0) {
+    char c;
+    int result;
+    if (startfd >= 0 && read(startfd, &c, 1) != 1)
+      exit(2);
+    result = persistenceaudit(hold ? PA_HOLD_BLOCK : PA_READ_BLOCK,
+                              block, 0, 0, 0, 0);
+    if (resultfd >= 0 && write(resultfd, &result, sizeof(result)) != sizeof(result))
+      exit(3);
+    exit(result < 0 ? 4 : 0);
+  }
+  return pid;
+}
+
+static void
+wait_ok(int count)
+{
+  int i, status_value;
+  for (i = 0; i < count; i++) {
+    if (wait(&status_value) < 0 || status_value != 0)
+      fail("child-status");
+  }
+}
+
+static void
+run_log(void)
+{
+  if (persistenceaudit(PA_ARM, 1, 3, 0, 0, 0) < 0)
+    fail("arm-log");
+  if (persistenceaudit(PA_LOG_TWICE, 1990, 0, 0, 0, 0) < 0)
+    fail("log-twice");
+  print_evidence("tx", 1);
+}
+
+static void
+run_admission_empty(void)
+{
+  struct pa_status s;
+  int pids[4], i, status_value;
+
+  if (persistenceaudit(PA_ARM, 2, 2, 0, 0, 0) < 0)
+    fail("arm-admission");
+  for (i = 0; i < 3; i++) {
+    pids[i] = fork();
+    if (pids[i] == 0)
+      exit(persistenceaudit(PA_HOLD_TXN, 0, 0, 0, 0, 0) < 0);
+    if (pids[i] < 0)
+      fail("fork-admission");
+  }
+  wait_holders(3);
+  pids[3] = fork();
+  if (pids[3] == 0)
+    exit(persistenceaudit(PA_HOLD_TXN, 0, 0, 0, 0, 0) < 0);
+  if (pids[3] < 0)
+    fail("fork-fourth");
+  wait_event(pids[3], PA_LOG_WAIT_SPACE, -1);
+  if (persistenceaudit(PA_RELEASE_PID, pids[0], 0, 0, 0, 0) < 0)
+    fail("release-one");
+  if (wait(&status_value) != pids[0] || status_value != 0)
+    fail("wait-first");
+  wait_holders(3);
+  wait_event(pids[3], PA_LOG_ADMIT, -1);
+  if (persistenceaudit(PA_RELEASE_ALL, 0, 0, 0, 0, 0) < 0)
+    fail("release-all");
+  wait_ok(3);
+  status(&s);
+  if (s.holders != 0 || s.outstanding != 0 || s.committing != 0)
+    fail("admission-cleanup");
+  print_evidence("admission-empty", 2);
+}
+
+static int
+spawn_transaction(int block)
+{
+  int pid = fork();
+
+  if (pid < 0)
+    fail("fork-transaction");
+  if (pid == 0) {
+    int op = block == 0 ? PA_HOLD_TXN : PA_HOLD_TXN_BLOCK;
+    exit(persistenceaudit(op, block, 0, 0, 0, 0) < 0);
+  }
+  return pid;
+}
+
+static void
+run_admission_used(void)
+{
+  struct pa_status s;
+  int pids[3], status_value;
+
+  if (persistenceaudit(PA_ARM, 3, 2, 0, 0, 0) < 0)
+    fail("arm-admission-used");
+  pids[0] = spawn_transaction(1988);
+  wait_holders(1);
+  status(&s);
+  if (s.log_n != 1 || s.outstanding != 1)
+    fail("used-first-state");
+  pids[1] = spawn_transaction(0);
+  wait_holders(2);
+  status(&s);
+  if (s.log_n != 1 || s.outstanding != 2)
+    fail("used-second-state");
+  pids[2] = spawn_transaction(0);
+  wait_event(pids[2], PA_LOG_WAIT_SPACE, -1);
+  status(&s);
+  if (s.log_n != 1 || s.outstanding != 2 || s.holders != 2)
+    fail("used-wait-state");
+  if (persistenceaudit(PA_RELEASE_PID, pids[1], 0, 0, 0, 0) < 0)
+    fail("used-release-one");
+  if (wait(&status_value) != pids[1] || status_value != 0)
+    fail("used-wait-one");
+  wait_holders(2);
+  wait_event(pids[2], PA_LOG_ADMIT, -1);
+  status(&s);
+  if (s.log_n != 1 || s.outstanding != 2)
+    fail("used-admit-state");
+  if (persistenceaudit(PA_RELEASE_ALL, 0, 0, 0, 0, 0) < 0)
+    fail("used-release-all");
+  wait_ok(2);
+  status(&s);
+  if (s.holders != 0 || s.log_n != 0 || s.outstanding != 0 ||
+      s.committing != 0)
+    fail("used-cleanup");
+  print_evidence("admission-used", 3);
+}
+
+static void
+run_same(void)
+{
+  int a, b, gota, gotb, resa[2], resb[2];
+
+  if (pipe(resa) < 0 || pipe(resb) < 0)
+    fail("same-pipes");
+  if (persistenceaudit(PA_ARM, 4, 1, 0, 0, 0) < 0)
+    fail("arm-same");
+  a = spawn_reader(1989, 1, -1, resa[1]);
+  wait_holders(1);
+  b = spawn_reader(1989, 0, -1, resb[1]);
+  wait_event(b, PA_CACHE_HIT, 2);
+  if (persistenceaudit(PA_RELEASE_PID, a, 0, 0, 0, 0) < 0)
+    fail("same-release");
+  wait_ok(2);
+  close(resa[1]);
+  close(resb[1]);
+  if (read(resa[0], &gota, sizeof(gota)) != sizeof(gota) ||
+      read(resb[0], &gotb, sizeof(gotb)) != sizeof(gotb))
+    fail("same-results");
+  close(resa[0]);
+  close(resb[0]);
+  printf("PERSIST RESULT case=same block1=1989 block2=1989 pid1=%d pid2=%d domain1=%d domain2=%d expected1=%d expected2=%d value1=%d value2=%d\n",
+         a, b, persistenceaudit(PA_PARTITION, 1989, 0, 0, 0, 0),
+         persistenceaudit(PA_PARTITION, 1989, 0, 0, 0, 0), gota, gotb,
+         gota, gotb);
+  print_evidence("same", 4);
+}
+
+static void
+find_pair(int same_domain, int *one, int *two, int *vone, int *vtwo)
+{
+  int a, b, da, db, va, vb;
+
+  for (a = 2; a < 80; a++) {
+    da = persistenceaudit(PA_PARTITION, a, 0, 0, 0, 0);
+    va = persistenceaudit(PA_READ_BLOCK, a, 0, 0, 0, 0);
+    for (b = a + 1; b < 100; b++) {
+      db = persistenceaudit(PA_PARTITION, b, 0, 0, 0, 0);
+      if ((da == db) != same_domain)
+        continue;
+      vb = persistenceaudit(PA_READ_BLOCK, b, 0, 0, 0, 0);
+      if (va != vb) {
+        *one = a;
+        *two = b;
+        *vone = va;
+        *vtwo = vb;
+        return;
+      }
+    }
+  }
+  fail("pair-discovery");
+}
+
+static void
+run_pair(int parallel)
+{
+  int start[2], result1[2], result2[2], one, two, vone, vtwo;
+  int got1, got2, p1, p2, d1, d2;
+  char bytes[2] = {'a', 'b'};
+  char *name = parallel ? "parallel" : "collision";
+  uint64 generation = parallel ? 6 : 5;
+
+  persistenceaudit(PA_RESET, 0, 0, 0, 0, 0);
+  find_pair(!parallel, &one, &two, &vone, &vtwo);
+  d1 = persistenceaudit(PA_PARTITION, one, 0, 0, 0, 0);
+  d2 = persistenceaudit(PA_PARTITION, two, 0, 0, 0, 0);
+  if (pipe(start) < 0 || pipe(result1) < 0 || pipe(result2) < 0)
+    fail("pipe");
+  p1 = spawn_reader(one, 0, start[0], result1[1]);
+  p2 = spawn_reader(two, 0, start[0], result2[1]);
+  if (persistenceaudit(PA_ARM_PAIR, generation, p1, p2, d1, d2) < 0)
+    fail("arm-pair");
+  if (write(start[1], bytes, 2) != 2)
+    fail("start-write");
+  close(start[0]);
+  close(start[1]);
+  wait_ok(2);
+  close(result1[1]);
+  close(result2[1]);
+  if (read(result1[0], &got1, sizeof(got1)) != sizeof(got1) ||
+      read(result2[0], &got2, sizeof(got2)) != sizeof(got2))
+    fail("pair-results");
+  close(result1[0]);
+  close(result2[0]);
+  printf("PERSIST RESULT case=%s block1=%d block2=%d pid1=%d pid2=%d domain1=%d domain2=%d expected1=%d expected2=%d value1=%d value2=%d\n",
+         name, one, two, p1, p2, d1, d2, vone, vtwo, got1, got2);
+  print_evidence(name, generation);
+}
+
+static void
+run_full(void)
+{
+  struct pa_status s;
+  int pid, i;
+
+  if (persistenceaudit(PA_ARM, 7, 1, 0, 0, 0) < 0)
+    fail("arm-full");
+  for (i = 0; i < NBUF; i++) {
+    pid = spawn_reader(1000 + i, 1, -1, -1);
+    if (pid <= 0)
+      fail("full-fork");
+    wait_holders(i + 1);
+  }
+  status(&s);
+  if (s.holders != NBUF)
+    fail("full-holders");
+  print_evidence("cache-full", 7);
+  printf("PERSIST FULL generation=7 holders=%d next=%d\n", s.holders,
+         1000 + NBUF);
+  persistenceaudit(PA_READ_BLOCK, 1000 + NBUF, 0, 0, 0, 0);
+  fail("full-no-panic");
+}
+
+int
+main(int argc, char **argv)
+{
+  if (argc != 2)
+    fail("usage");
+  if (strcmp(argv[1], "log") == 0)
+    run_log();
+  else if (strcmp(argv[1], "admission-empty") == 0)
+    run_admission_empty();
+  else if (strcmp(argv[1], "admission-used") == 0)
+    run_admission_used();
+  else if (strcmp(argv[1], "same") == 0)
+    run_same();
+  else if (strcmp(argv[1], "collision") == 0)
+    run_pair(0);
+  else if (strcmp(argv[1], "parallel") == 0)
+    run_pair(1);
+  else if (strcmp(argv[1], "cache-full") == 0)
+    run_full();
+  else
+    fail("unknown-case");
+  printf("PERSIST PASS case=%s\n",
+         strcmp(argv[1], "log") == 0 ? "tx" : argv[1]);
+  exit(0);
+}
