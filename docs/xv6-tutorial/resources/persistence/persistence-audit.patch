+uint64
+sys_persistenceaudit(void)
+{
+  int op;
+  uint64 a, b, c, d, e;
+
+  argint(0, &op);
+  argaddr(1, &a);
+  argaddr(2, &b);
+  argaddr(3, &c);
+  argaddr(4, &d);
+  argaddr(5, &e);
+  return persistenceaudit_command(op, a, b, c, d, e);
+}
