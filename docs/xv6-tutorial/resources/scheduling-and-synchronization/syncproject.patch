diff --git a/kernel/syncproject.c b/kernel/syncproject.c
new file mode 100644
index 0000000000000000000000000000000000000000..ae3fb67d89adb4875542b8f271145f4432d40f07
--- /dev/null
+++ b/kernel/syncproject.c
@@ -0,0 +1,466 @@
+#include "types.h"
+#include "param.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "proc.h"
+#include "defs.h"
+#include "syncproject.h"
+
+struct syncprojectstate {
+  struct spinlock condition;
+  int channel;
+  volatile int active;
+  volatile int generation;
+  volatile int mode;
+  volatile int ready;
+  volatile int target_pid;
+  volatile int origin_hart;
+  volatile int resume_hart;
+  volatile int producer_attempt;
+  volatile int producer_started;
+  volatile int wait_plock_ready;
+  volatile int condition_released;
+  volatile int producer_acquired;
+  volatile int sleep_published;
+  volatile int wake_done;
+  volatile int force_migrate;
+  volatile int origin_skip_seen;
+  volatile int resume_allowed;
+  volatile int rescuing;
+  volatile int wake_misses;
+  volatile int wake_matches;
+  volatile int rescues;
+  volatile int next_event;
+  struct syncevent events[SYNC_MAX_EVENTS];
+};
+
+static struct syncprojectstate project;
+extern struct proc proc[NPROC];
+
+static int
+aload(volatile int *value)
+{
+  return __atomic_load_n(value, __ATOMIC_SEQ_CST);
+}
+
+static void
+astore(volatile int *value, int next)
+{
+  __atomic_store_n(value, next, __ATOMIC_SEQ_CST);
+}
+
+static int
+target_event(struct proc *p, void *chan)
+{
+  return aload(&project.active) && p &&
+         p->pid == aload(&project.target_pid) && chan == &project.channel;
+}
+
+static void
+record_event(int kind, struct proc *target, int state, int chan_match,
+             int proc_locked)
+{
+  int slot = __atomic_fetch_add(&project.next_event, 1, __ATOMIC_SEQ_CST);
+  if (slot >= SYNC_MAX_EVENTS)
+    return;
+
+  int interrupt_enabled = intr_get();
+  push_off();
+  struct cpu *c = mycpu();
+  struct proc *current = c->proc;
+  struct syncevent *event = &project.events[slot];
+  event->valid = 0;
+  event->seq = slot;
+  event->kind = kind;
+  event->pid = target ? target->pid : (current ? current->pid : 0);
+  event->hart = cpuid();
+  event->state = state;
+  event->ready = aload(&project.ready);
+  event->chan_match = chan_match;
+  event->condition_locked = __atomic_load_n(&project.condition.locked,
+                                            __ATOMIC_SEQ_CST);
+  struct cpu *condition_owner = __atomic_load_n(&project.condition.cpu,
+                                                 __ATOMIC_SEQ_CST);
+  event->condition_owner_hart = condition_owner ? condition_owner - cpus : -1;
+  event->proc_locked = proc_locked;
+  struct cpu *proc_owner = target ? __atomic_load_n(&target->lock.cpu,
+                                                     __ATOMIC_SEQ_CST) : 0;
+  event->proc_owner_hart = proc_owner ? proc_owner - cpus : -1;
+  event->interrupt_enabled = interrupt_enabled;
+  event->noff = c->noff - 1;
+  __atomic_store_n(&event->valid, 1, __ATOMIC_RELEASE);
+  pop_off();
+}
+
+void
+syncprojectinit(void)
+{
+  initlock(&project.condition, "syncproject condition");
+  project.origin_hart = -1;
+  project.resume_hart = -1;
+}
+
+static void
+reset_fields(int mode)
+{
+  int generation = aload(&project.generation) + 1;
+  memset(project.events, 0, sizeof(project.events));
+  astore(&project.mode, mode);
+  astore(&project.ready, 0);
+  astore(&project.target_pid, 0);
+  astore(&project.origin_hart, -1);
+  astore(&project.resume_hart, -1);
+  astore(&project.producer_attempt, 0);
+  astore(&project.producer_started, 0);
+  astore(&project.wait_plock_ready, 0);
+  astore(&project.condition_released, 0);
+  astore(&project.producer_acquired, 0);
+  astore(&project.sleep_published, 0);
+  astore(&project.wake_done, 0);
+  astore(&project.force_migrate, 0);
+  astore(&project.origin_skip_seen, 0);
+  astore(&project.resume_allowed, 0);
+  astore(&project.rescuing, 0);
+  astore(&project.wake_misses, 0);
+  astore(&project.wake_matches, 0);
+  astore(&project.rescues, 0);
+  astore(&project.next_event, 0);
+  astore(&project.generation, generation);
+  astore(&project.active, 1);
+}
+
+int
+syncprojectreset(int mode)
+{
+  if (mode != SYNC_MODE_FIXED && mode != SYNC_MODE_BROKEN)
+    return -1;
+  if (aload(&project.active) ||
+      __atomic_load_n(&project.condition.locked, __ATOMIC_SEQ_CST))
+    return -1;
+  reset_fields(mode);
+  return 0;
+}
+
+void
+syncproject_sleep_before_release(struct proc *p, void *chan)
+{
+  if (!target_event(p, chan) || aload(&project.mode) != SYNC_MODE_FIXED)
+    return;
+  record_event(SYNC_EVENT_WAIT_PLOCK, p, p->state, p->chan == chan, 1);
+  astore(&project.wait_plock_ready, 1);
+  while (!aload(&project.producer_attempt))
+    ;
+  record_event(SYNC_EVENT_WAIT_RELEASE_BOUNDARY, p, p->state,
+               p->chan == chan, 1);
+}
+
+void
+syncproject_sleep_after_release(struct proc *p, void *chan)
+{
+  if (!target_event(p, chan) || aload(&project.mode) != SYNC_MODE_FIXED)
+    return;
+  astore(&project.condition_released, 1);
+  while (!aload(&project.producer_acquired))
+    ;
+}
+
+void
+syncproject_sleep_published(struct proc *p, void *chan)
+{
+  if (!target_event(p, chan))
+    return;
+  record_event(SYNC_EVENT_WAIT_PUBLISH, p, p->state, p->chan == chan, 1);
+  astore(&project.origin_skip_seen, 0);
+  astore(&project.force_migrate, 1);
+  astore(&project.sleep_published, 1);
+}
+
+void
+syncproject_sleep_resumed(struct proc *p, void *chan)
+{
+  if (!target_event(p, chan))
+    return;
+  while (!aload(&project.resume_allowed))
+    ;
+  record_event(SYNC_EVENT_WAIT_RESUME, p, p->state, p->chan == chan, 1);
+}
+
+void
+syncproject_wakeup_scan(struct proc *p, void *chan, int matched)
+{
+  if (!target_event(p, chan))
+    return;
+  if (aload(&project.rescuing)) {
+    if (matched) {
+      __atomic_fetch_add(&project.rescues, 1, __ATOMIC_SEQ_CST);
+      record_event(SYNC_EVENT_RESCUE_MATCH, p, p->state, 1, 1);
+    }
+    return;
+  }
+  if (matched) {
+    __atomic_fetch_add(&project.wake_matches, 1, __ATOMIC_SEQ_CST);
+    record_event(SYNC_EVENT_WAKE_MATCH, p, p->state, 1, 1);
+  } else {
+    __atomic_fetch_add(&project.wake_misses, 1, __ATOMIC_SEQ_CST);
+    record_event(SYNC_EVENT_WAKE_MISS, p, p->state, p->chan == chan, 1);
+  }
+}
+
+int
+syncproject_scheduler_skip(struct proc *p)
+{
+  if (!aload(&project.active) || p->pid != aload(&project.target_pid) ||
+      !aload(&project.force_migrate) || aload(&project.resume_hart) >= 0)
+    return 0;
+  if (cpuid() == aload(&project.origin_hart)) {
+    if (aload(&project.wake_done) && !aload(&project.origin_skip_seen)) {
+      record_event(SYNC_EVENT_ORIGIN_SKIP, p, p->state,
+                   p->chan == &project.channel, 1);
+      astore(&project.origin_skip_seen, 1);
+    }
+    return 1;
+  }
+  return !aload(&project.origin_skip_seen) || !aload(&project.resume_allowed);
+}
+
+void
+syncproject_scheduler_select(struct proc *p)
+{
+  if (!aload(&project.active) || p->pid != aload(&project.target_pid) ||
+      !aload(&project.force_migrate) || aload(&project.resume_hart) >= 0)
+    return;
+  if (cpuid() == aload(&project.origin_hart) ||
+      !aload(&project.origin_skip_seen) || !aload(&project.resume_allowed))
+    return;
+  astore(&project.resume_hart, cpuid());
+  record_event(SYNC_EVENT_MIGRATE_SELECT, p, p->state,
+               p->chan == &project.channel, 1);
+}
+
+static void
+broken_sleep(void)
+{
+  struct proc *p = myproc();
+  push_off();
+  release(&project.condition);
+  record_event(SYNC_EVENT_WAIT_RELEASED, p, p->state, 0, 0);
+  astore(&project.condition_released, 1);
+  while (!aload(&project.wake_done))
+    ;
+
+  acquire(&p->lock);
+  pop_off();
+  p->chan = &project.channel;
+  p->state = SLEEPING;
+  syncproject_sleep_published(p, &project.channel);
+  sched();
+  syncproject_sleep_resumed(p, &project.channel);
+  p->chan = 0;
+  release(&p->lock);
+  acquire(&project.condition);
+}
+
+int
+syncprojectwait(void)
+{
+  if (!aload(&project.active))
+    return -1;
+  struct proc *p = myproc();
+  int expected = 0;
+  if (!__atomic_compare_exchange_n(&project.target_pid, &expected, p->pid, 0,
+                                   __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST) &&
+      expected != p->pid)
+    return -1;
+
+  push_off();
+  astore(&project.origin_hart, cpuid());
+  pop_off();
+
+  acquire(&project.condition);
+  record_event(SYNC_EVENT_WAIT_CHECK, p, p->state, 0, 0);
+  while (!aload(&project.ready)) {
+    if (aload(&project.mode) == SYNC_MODE_FIXED)
+      sleep(&project.channel, &project.condition);
+    else
+      broken_sleep();
+  }
+  record_event(SYNC_EVENT_WAIT_RECHECK, p, p->state, 0, 0);
+  release(&project.condition);
+  return 0;
+}
+
+int
+syncprojectproduce(void)
+{
+  if (!aload(&project.active))
+    return -1;
+  push_off();
+  record_event(SYNC_EVENT_PRODUCER_ARMED, 0, -1, 0, 0);
+  astore(&project.producer_started, 1);
+  int mode = aload(&project.mode);
+  if (mode == SYNC_MODE_FIXED) {
+    while (!aload(&project.wait_plock_ready))
+      ;
+    record_event(SYNC_EVENT_PRODUCER_ATTEMPT, 0, -1, 0, 0);
+    astore(&project.producer_attempt, 1);
+  } else {
+    while (!aload(&project.condition_released))
+      ;
+    record_event(SYNC_EVENT_PRODUCER_ATTEMPT, 0, -1, 0, 0);
+  }
+
+  acquire(&project.condition);
+  while (!aload(&project.condition_released))
+    ;
+  record_event(SYNC_EVENT_PRODUCER_ACQUIRE, 0, -1, 0, 0);
+  astore(&project.producer_acquired, 1);
+  if (mode == SYNC_MODE_FIXED)
+    while (!aload(&project.sleep_published))
+      ;
+
+  astore(&project.ready, 1);
+  record_event(SYNC_EVENT_PRODUCER_READY, 0, -1, 0, 0);
+  wakeup(&project.channel);
+  record_event(SYNC_EVENT_WAKE_DONE, 0, -1, 0, 0);
+  astore(&project.wake_done, 1);
+
+  if (mode == SYNC_MODE_FIXED) {
+    while (!aload(&project.origin_skip_seen))
+      ;
+    record_event(SYNC_EVENT_MIGRATE_RELEASE, 0, -1, 0, 0);
+    astore(&project.resume_allowed, 1);
+  }
+  release(&project.condition);
+  pop_off();
+  return 0;
+}
+
+static int
+bad_state_recorded(void)
+{
+  int found = 0;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == aload(&project.target_pid) && p->state == SLEEPING &&
+        p->chan == &project.channel && aload(&project.ready) == 1 &&
+        aload(&project.wake_misses) == 1 && p->killed == 0) {
+      record_event(SYNC_EVENT_BAD_ORACLE, p, p->state, 1, 1);
+      found = 1;
+    }
+    release(&p->lock);
+  }
+  return found;
+}
+
+int
+syncprojectrescue(void)
+{
+  if (aload(&project.mode) != SYNC_MODE_BROKEN || !bad_state_recorded())
+    return -1;
+  astore(&project.wake_done, 0);
+  astore(&project.rescuing, 1);
+  record_event(SYNC_EVENT_RESCUE_BEGIN, 0, -1, 0, 0);
+  wakeup(&project.channel);
+  record_event(SYNC_EVENT_RESCUE_DONE, 0, -1, 0, 0);
+  astore(&project.wake_done, 1);
+  while (!aload(&project.origin_skip_seen))
+    ;
+  record_event(SYNC_EVENT_MIGRATE_RELEASE, 0, -1, 0, 0);
+  astore(&project.resume_allowed, 1);
+  astore(&project.rescuing, 0);
+  return 0;
+}
+
+void
+syncprojectsnapshot(struct syncsnapshot *out)
+{
+  memset(out, 0, sizeof(*out));
+  out->active = aload(&project.active);
+  out->generation = aload(&project.generation);
+  out->mode = aload(&project.mode);
+  out->target_pid = aload(&project.target_pid);
+  out->ready = aload(&project.ready);
+  out->condition_locked = __atomic_load_n(&project.condition.locked,
+                                          __ATOMIC_SEQ_CST);
+  out->wake_misses = aload(&project.wake_misses);
+  out->wake_matches = aload(&project.wake_matches);
+  out->rescues = aload(&project.rescues);
+  out->origin_hart = aload(&project.origin_hart);
+  out->resume_hart = aload(&project.resume_hart);
+  out->migrated = out->origin_hart >= 0 && out->resume_hart >= 0 &&
+                  out->origin_hart != out->resume_hart;
+  out->producer_started = aload(&project.producer_started);
+  out->gate_pending = aload(&project.producer_attempt) +
+                      aload(&project.producer_started) +
+                      aload(&project.wait_plock_ready) +
+                      aload(&project.condition_released) +
+                      aload(&project.producer_acquired) +
+                      aload(&project.sleep_published) +
+                      aload(&project.wake_done) +
+                      aload(&project.force_migrate) +
+                      aload(&project.origin_skip_seen) +
+                      aload(&project.resume_allowed) +
+                      aload(&project.rescuing);
+
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED)
+      out->used++;
+    if (out->target_pid > 0 && p->state != UNUSED &&
+        p->pid == out->target_pid) {
+      out->target_present = 1;
+      out->target_state = p->state;
+      out->target_chan_match = p->chan == &project.channel;
+      out->target_killed = p->killed;
+    }
+    release(&p->lock);
+  }
+
+  int count = aload(&project.next_event);
+  if (count > SYNC_MAX_EVENTS)
+    count = SYNC_MAX_EVENTS;
+  for (int i = 0; i < count; i++) {
+    if (__atomic_load_n(&project.events[i].valid, __ATOMIC_ACQUIRE)) {
+      out->events[out->trace_count] = project.events[i];
+      out->trace_count++;
+    }
+  }
+}
+
+int
+syncprojectclear(void)
+{
+  if (!aload(&project.active) ||
+      __atomic_load_n(&project.condition.locked, __ATOMIC_SEQ_CST))
+    return -1;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    int target_present = p->pid == aload(&project.target_pid);
+    release(&p->lock);
+    if (target_present)
+      return -1;
+  }
+  memset(project.events, 0, sizeof(project.events));
+  astore(&project.active, 0);
+  astore(&project.mode, 0);
+  astore(&project.ready, 0);
+  astore(&project.target_pid, 0);
+  astore(&project.origin_hart, -1);
+  astore(&project.resume_hart, -1);
+  astore(&project.producer_attempt, 0);
+  astore(&project.producer_started, 0);
+  astore(&project.wait_plock_ready, 0);
+  astore(&project.condition_released, 0);
+  astore(&project.producer_acquired, 0);
+  astore(&project.sleep_published, 0);
+  astore(&project.wake_done, 0);
+  astore(&project.force_migrate, 0);
+  astore(&project.origin_skip_seen, 0);
+  astore(&project.resume_allowed, 0);
+  astore(&project.rescuing, 0);
+  astore(&project.wake_misses, 0);
+  astore(&project.wake_matches, 0);
+  astore(&project.rescues, 0);
+  astore(&project.next_event, 0);
+  return 0;
+}
