+#define SYNC_MODE_FIXED 1
+#define SYNC_MODE_BROKEN 2
+
+#define SYNC_OP_RESET 1
+#define SYNC_OP_WAIT 2
+#define SYNC_OP_PRODUCE 3
+#define SYNC_OP_SNAPSHOT 4
+#define SYNC_OP_RESCUE 5
+#define SYNC_OP_CLEAR 6
+
+#define SYNC_EVENT_WAIT_CHECK 1
+#define SYNC_EVENT_WAIT_PLOCK 2
+#define SYNC_EVENT_PRODUCER_ATTEMPT 3
+#define SYNC_EVENT_WAIT_RELEASE_BOUNDARY 4
+#define SYNC_EVENT_PRODUCER_ACQUIRE 5
+#define SYNC_EVENT_WAIT_PUBLISH 6
+#define SYNC_EVENT_PRODUCER_READY 7
+#define SYNC_EVENT_WAKE_MATCH 8
+#define SYNC_EVENT_WAKE_MISS 9
+#define SYNC_EVENT_WAKE_DONE 10
+#define SYNC_EVENT_BAD_ORACLE 11
+#define SYNC_EVENT_RESCUE_BEGIN 12
+#define SYNC_EVENT_RESCUE_MATCH 13
+#define SYNC_EVENT_RESCUE_DONE 14
+#define SYNC_EVENT_ORIGIN_SKIP 15
+#define SYNC_EVENT_MIGRATE_RELEASE 16
+#define SYNC_EVENT_MIGRATE_SELECT 17
+#define SYNC_EVENT_WAIT_RESUME 18
+#define SYNC_EVENT_WAIT_RECHECK 19
+#define SYNC_EVENT_PRODUCER_ARMED 20
+#define SYNC_EVENT_WAIT_RELEASED 21
+
+#define SYNC_MAX_EVENTS 32
+
+struct syncevent {
+  int valid;
+  int seq;
+  int kind;
+  int pid;
+  int hart;
+  int state;
+  int ready;
+  int chan_match;
+  int condition_locked;
+  int condition_owner_hart;
+  int proc_locked;
+  int proc_owner_hart;
+  int interrupt_enabled;
+  int noff;
+};
+
+struct syncsnapshot {
+  int active;
+  int generation;
+  int mode;
+  int used;
+  int target_pid;
+  int target_present;
+  int target_state;
+  int target_chan_match;
+  int target_killed;
+  int ready;
+  int condition_locked;
+  int gate_pending;
+  int trace_count;
+  int wake_misses;
+  int wake_matches;
+  int rescues;
+  int origin_hart;
+  int resume_hart;
+  int migrated;
+  int producer_started;
+  struct syncevent events[SYNC_MAX_EVENTS];
+};
