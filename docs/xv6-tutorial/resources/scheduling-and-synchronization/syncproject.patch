diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 73ff1f3a2fca413fcf9d22f3bdc00bda74815825..eb796a05bdec3d525f1314a2a57f75eec0baadbb 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -8,0 +9 @@
+#include "syncproject.h"
@@ -109,0 +111,31 @@ sys_uptime(void)
+
+uint64
+sys_syncproject(void)
+{
+  int operation;
+  int value;
+  uint64 address;
+  struct syncsnapshot snapshot;
+
+  argint(0, &operation);
+  argint(1, &value);
+  argaddr(2, &address);
+  switch (operation) {
+  case SYNC_OP_RESET:
+    return syncprojectreset(value);
+  case SYNC_OP_WAIT:
+    return syncprojectwait();
+  case SYNC_OP_PRODUCE:
+    return syncprojectproduce();
+  case SYNC_OP_SNAPSHOT:
+    syncprojectsnapshot(&snapshot);
+    return copyout(myproc()->pagetable, address, (char *)&snapshot,
+                   sizeof(snapshot));
+  case SYNC_OP_RESCUE:
+    return syncprojectrescue();
+  case SYNC_OP_CLEAR:
+    return syncprojectclear();
+  default:
+    return -1;
+  }
+}
diff --git a/user/schedtrace.c b/user/schedtrace.c
new file mode 100644
index 0000000000000000000000000000000000000000..00e95e7d5ca895bffd56b6cc6b2be63e6a12020d
--- /dev/null
+++ b/user/schedtrace.c
@@ -0,0 +1,174 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/syncproject.h"
+#include "user/user.h"
+
+static struct syncsnapshot snapshot;
+
+static void
+fail(char *message)
+{
+  printf("SYNC FAIL %s\n", message);
+  exit(1);
+}
+
+static char *
+event_name(int kind)
+{
+  switch (kind) {
+  case SYNC_EVENT_WAIT_CHECK: return "WAIT_CHECK";
+  case SYNC_EVENT_WAIT_PLOCK: return "WAIT_PLOCK";
+  case SYNC_EVENT_PRODUCER_ATTEMPT: return "PRODUCER_ATTEMPT";
+  case SYNC_EVENT_WAIT_RELEASE_BOUNDARY: return "WAIT_RELEASE_BOUNDARY";
+  case SYNC_EVENT_PRODUCER_ACQUIRE: return "PRODUCER_ACQUIRE";
+  case SYNC_EVENT_WAIT_PUBLISH: return "WAIT_PUBLISH";
+  case SYNC_EVENT_PRODUCER_READY: return "PRODUCER_READY";
+  case SYNC_EVENT_WAKE_MATCH: return "WAKE_MATCH";
+  case SYNC_EVENT_WAKE_MISS: return "WAKE_MISS";
+  case SYNC_EVENT_WAKE_DONE: return "WAKE_DONE";
+  case SYNC_EVENT_BAD_ORACLE: return "BAD_ORACLE";
+  case SYNC_EVENT_RESCUE_BEGIN: return "RESCUE_BEGIN";
+  case SYNC_EVENT_RESCUE_MATCH: return "RESCUE_MATCH";
+  case SYNC_EVENT_RESCUE_DONE: return "RESCUE_DONE";
+  case SYNC_EVENT_ORIGIN_SKIP: return "ORIGIN_SKIP";
+  case SYNC_EVENT_MIGRATE_RELEASE: return "MIGRATE_RELEASE";
+  case SYNC_EVENT_MIGRATE_SELECT: return "MIGRATE_SELECT";
+  case SYNC_EVENT_WAIT_RESUME: return "WAIT_RESUME";
+  case SYNC_EVENT_WAIT_RECHECK: return "WAIT_RECHECK";
+  case SYNC_EVENT_PRODUCER_ARMED: return "PRODUCER_ARMED";
+  case SYNC_EVENT_WAIT_RELEASED: return "WAIT_RELEASED";
+  }
+  return "UNKNOWN";
+}
+
+static void
+read_snapshot(void)
+{
+  if (syncproject(SYNC_OP_SNAPSHOT, 0, &snapshot) < 0)
+    fail("snapshot");
+}
+
+static void
+dump_events(char *mode)
+{
+  for (int i = 0; i < snapshot.trace_count; i++) {
+    struct syncevent *event = &snapshot.events[i];
+    printf("SYNC EVENT mode=%s gen=%d seq=%d kind=%s pid=%d hart=%d state=%d ready=%d chan=%d cond=%d cond_owner=%d plock=%d proc_owner=%d intr=%d noff=%d\n",
+           mode, snapshot.generation, event->seq, event_name(event->kind),
+           event->pid, event->hart, event->state, event->ready,
+           event->chan_match, event->condition_locked,
+           event->condition_owner_hart, event->proc_locked,
+           event->proc_owner_hart, event->interrupt_enabled, event->noff);
+  }
+}
+
+static void
+wait_child(void)
+{
+  int status = -999;
+  if (wait(&status) < 0 || status != 0)
+    fail("child status");
+}
+
+static void
+run_case(int mode, char *name)
+{
+  if (syncproject(SYNC_OP_RESET, mode, 0) < 0)
+    fail("reset");
+  read_snapshot();
+  int baseline_used = snapshot.used;
+
+  int producer = fork();
+  if (producer < 0)
+    fail("fork producer");
+  if (producer == 0) {
+    int result = syncproject(SYNC_OP_PRODUCE, 0, 0);
+    exit(result < 0 ? 1 : 0);
+  }
+
+  int start_deadline = uptime() + 50;
+  do {
+    read_snapshot();
+    if (uptime() >= start_deadline)
+      fail("producer-start watchdog");
+  } while (!snapshot.producer_started);
+
+  int waiter = fork();
+  if (waiter < 0)
+    fail("fork waiter");
+  if (waiter == 0) {
+    int result = syncproject(SYNC_OP_WAIT, 0, 0);
+    exit(result < 0 ? 1 : 0);
+  }
+
+  if (mode == SYNC_MODE_BROKEN) {
+    int deadline = uptime() + 50;
+    for (;;) {
+      read_snapshot();
+      if (snapshot.ready == 1 && snapshot.target_present &&
+          snapshot.target_state == 2 && snapshot.target_chan_match &&
+          snapshot.wake_misses == 1 && snapshot.target_killed == 0)
+        break;
+      if (uptime() >= deadline)
+        fail("bad-state watchdog");
+      pause(1);
+    }
+    printf("SYNC BADSTATE mode=%s gen=%d ready=%d state=%d chan=%d miss=%d killed=%d\n",
+           name, snapshot.generation, snapshot.ready, snapshot.target_state,
+           snapshot.target_chan_match, snapshot.wake_misses,
+           snapshot.target_killed);
+    if (syncproject(SYNC_OP_RESCUE, 0, 0) < 0)
+      fail("rescue");
+  }
+
+  wait_child();
+  wait_child();
+  read_snapshot();
+  dump_events(name);
+  printf("SYNC FINAL mode=%s gen=%d used_before=%d used_after=%d target=%d ready=%d miss=%d match=%d rescue=%d origin=%d resume=%d migrated=%d events=%d cond=%d\n",
+         name, snapshot.generation, baseline_used, snapshot.used,
+         snapshot.target_present, snapshot.ready, snapshot.wake_misses,
+         snapshot.wake_matches, snapshot.rescues, snapshot.origin_hart,
+         snapshot.resume_hart, snapshot.migrated, snapshot.trace_count,
+         snapshot.condition_locked);
+
+  if (snapshot.used != baseline_used || snapshot.target_present ||
+      snapshot.condition_locked || !snapshot.migrated)
+    fail("final resources");
+  if (mode == SYNC_MODE_FIXED &&
+      (snapshot.wake_misses != 0 || snapshot.wake_matches != 1 ||
+       snapshot.rescues != 0))
+    fail("fixed oracle");
+  if (mode == SYNC_MODE_BROKEN &&
+      (snapshot.wake_misses != 1 || snapshot.wake_matches != 0 ||
+       snapshot.rescues != 1))
+    fail("broken oracle");
+
+  int generation = snapshot.generation;
+  if (syncproject(SYNC_OP_CLEAR, 0, 0) < 0)
+    fail("clear");
+  read_snapshot();
+  printf("SYNC CLEAN mode=%s gen=%d used=%d baseline=%d active=%d target=%d ready=%d cond=%d trace=%d gates=%d\n",
+         name, generation, snapshot.used, baseline_used, snapshot.active,
+         snapshot.target_present, snapshot.ready, snapshot.condition_locked,
+         snapshot.trace_count, snapshot.gate_pending);
+  if (snapshot.used != baseline_used || snapshot.active ||
+      snapshot.target_present || snapshot.ready || snapshot.condition_locked ||
+      snapshot.trace_count || snapshot.gate_pending)
+    fail("cleanup");
+  printf("SYNC PASS mode=%s\n", name);
+}
+
+int
+main(int argc, char **argv)
+{
+  if (argc != 2)
+    fail("usage: schedtrace fixed|broken");
+  if (strcmp(argv[1], "fixed") == 0)
+    run_case(SYNC_MODE_FIXED, "fixed");
+  else if (strcmp(argv[1], "broken") == 0)
+    run_case(SYNC_MODE_BROKEN, "broken");
+  else
+    fail("unknown mode");
+  exit(0);
+}
