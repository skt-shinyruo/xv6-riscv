diff --git a/user/fstrace.c b/user/fstrace.c
new file mode 100644
index 0000000..aed010d
--- /dev/null
+++ b/user/fstrace.c
@@ -0,0 +1,346 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/fcntl.h"
+#include "kernel/fs.h"
+#include "kernel/param.h"
+#include "kernel/fsaudit.h"
+#include "user/user.h"
+
+static struct fs_audit_snapshot base;
+static struct fs_audit_snapshot snap;
+static struct fs_audit_snapshot before;
+static struct stat st0;
+static struct stat st1;
+static char block[BSIZE];
+
+static void
+fail(int code)
+{
+  printf("FS FAIL code=%d\n", code);
+  exit(1);
+}
+
+static void
+fetch(struct fs_audit_snapshot *out)
+{
+  if (fsaudit(FSAUDIT_FETCH, 0, out) < 0)
+    fail(90);
+}
+
+static int
+same_ledger(struct fs_audit_snapshot *a, struct fs_audit_snapshot *b)
+{
+  return a->blocks == b->blocks && a->inodes == b->inodes &&
+         a->itable_active == b->itable_active &&
+         a->itable_refs == b->itable_refs &&
+         a->file_objects == b->file_objects &&
+         a->file_refs == b->file_refs && a->buf_refs == b->buf_refs;
+}
+
+static void
+print_after(char *phase)
+{
+  fetch(&snap);
+  if (!same_ledger(&base, &snap))
+    fail(91);
+  printf("FS AFTER phase=%s blocks=%d inodes=%d itable_active=%d "
+         "itable_refs=%d file_objects=%d file_refs=%d buf_refs=%d\n",
+         phase, snap.blocks, snap.inodes, snap.itable_active,
+         snap.itable_refs, snap.file_objects, snap.file_refs, snap.buf_refs);
+}
+
+static void
+fill(char value)
+{
+  memset(block, value, sizeof(block));
+}
+
+static void
+cleanup_names(void)
+{
+  unlink("fsd/data");
+  unlink("fsd");
+  unlink("fslink");
+  unlink("fsalias");
+  unlink("fstrunc");
+  unlink("fsfd");
+  unlink("fssrc");
+  unlink("fsbadlink");
+  unlink("fsalloc");
+}
+
+static void
+case_rw(void)
+{
+  int fd, i, n, total, checksum, written = 0;
+
+  if (mkdir("fsd") < 0)
+    fail(1);
+  if (fsaudit(FSAUDIT_RESET, 1, 0) < 0)
+    fail(2);
+  fd = open("fsd/data", O_CREATE | O_RDWR);
+  if (fd < 0)
+    fail(3);
+  for (i = 0; i < NDIRECT; i++) {
+    fill('A' + i);
+    n = write(fd, block, BSIZE);
+    if (n != BSIZE)
+      fail(4);
+    written += n;
+  }
+  fill('Z');
+  n = write(fd, block, 17);
+  if (n != 17)
+    fail(5);
+  written += n;
+  if (fstat(fd, &st0) < 0 || fsaudit(FSAUDIT_INSPECT_FD, fd, 0) < 0)
+    fail(6);
+  close(fd);
+
+  fd = open("fsd/data", O_RDONLY);
+  if (fd < 0)
+    fail(7);
+  total = 0;
+  checksum = 0;
+  while ((n = read(fd, block, sizeof(block))) > 0) {
+    total += n;
+    for (i = 0; i < n; i++)
+      checksum += (uchar)block[i];
+  }
+  if (n < 0 || total != NDIRECT * BSIZE + 17 || checksum != 867834)
+    fail(8);
+  fetch(&snap);
+  close(fd);
+  printf("FS RW generation=%d path_steps=%d inum=%d type=%d nlink=%d "
+         "size=%d write=%d read=%d checksum=%d direct0=%d direct11=%d "
+         "indirect=%d indirect0=%d data_blocks=%d open_seq=%d "
+         "file_write_seq=%d inode_write_seq=%d direct_seq=%d buffer_seq=%d "
+         "indirect_seq=%d file_read_seq=%d inode_read_seq=%d buffer_block=%d "
+         "buffer_valid=%d buffer_ref=%d buffer_locked=%d status=0 cleanup=1\n",
+         snap.generation, snap.path_steps, snap.inspect_inum, snap.inspect_type,
+         snap.inspect_nlink, snap.inspect_size, written, total,
+         checksum, snap.inspect_direct0, snap.inspect_direct11,
+         snap.inspect_indirect, snap.inspect_indirect0, snap.inspect_data_blocks,
+         snap.open_seq, snap.file_write_seq, snap.inode_write_seq,
+         snap.direct_seq, snap.buffer_seq, snap.indirect_seq,
+         snap.file_read_seq, snap.inode_read_seq, snap.buffer_block,
+         snap.buffer_valid, snap.buffer_ref, snap.buffer_locked);
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  if (unlink("fsd/data") < 0 || unlink("fsd") < 0)
+    fail(9);
+  print_after("RW");
+}
+
+static void
+case_link(void)
+{
+  int fd, old_path, alias_path, got;
+  char data[5];
+  int n0, n1, n2, n3, inum;
+
+  fsaudit(FSAUDIT_RESET, 2, 0);
+  fd = open("fslink", O_CREATE | O_RDWR);
+  if (fd < 0 || write(fd, "hello", 5) != 5)
+    fail(10);
+  close(fd);
+  fd = open("fslink", O_RDWR);
+  if (fd < 0 || fstat(fd, &st0) < 0)
+    fail(11);
+  inum = st0.ino;
+  n0 = st0.nlink;
+  if (link("fslink", "fsalias") < 0 || fstat(fd, &st0) < 0)
+    fail(12);
+  n1 = st0.nlink;
+  if (unlink("fslink") < 0 || fstat(fd, &st0) < 0)
+    fail(13);
+  n2 = st0.nlink;
+  if (unlink("fsalias") < 0 || fstat(fd, &st0) < 0)
+    fail(14);
+  n3 = st0.nlink;
+  old_path = open("fslink", O_RDONLY);
+  alias_path = open("fsalias", O_RDONLY);
+  if (old_path >= 0 || alias_path >= 0)
+    fail(15);
+  got = read(fd, data, sizeof(data));
+  fetch(&snap);
+  if (got != 5 || data[0] != 'h' || data[4] != 'o' ||
+      snap.inodes != base.inodes + 1 || snap.blocks != base.blocks + 1)
+    fail(16);
+  printf("FS LINK generation=2 inum=%d nlink0=%d nlink1=%d nlink2=%d "
+         "nlink3=%d path_old=%d path_alias=%d read=%d first=%d last=%d "
+         "open_fd=%d blocks_held=%d inodes_held=%d status=0 cleanup=1\n",
+         inum, n0, n1, n2, n3, old_path, alias_path, got, data[0], data[4],
+         fd, snap.blocks, snap.inodes);
+  close(fd);
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  print_after("LINK");
+}
+
+static void
+case_trunc(void)
+{
+  int fd0, fd1, before_blocks, after_blocks, rewrite;
+
+  fsaudit(FSAUDIT_RESET, 3, 0);
+  fd0 = open("fstrunc", O_CREATE | O_RDWR);
+  fill('T');
+  if (fd0 < 0 || write(fd0, block, BSIZE) != BSIZE ||
+      write(fd0, block, BSIZE) != BSIZE)
+    fail(20);
+  close(fd0);
+  fd0 = open("fstrunc", O_RDWR);
+  if (fd0 < 0 || fstat(fd0, &st0) < 0 ||
+      fsaudit(FSAUDIT_INSPECT_FD, fd0, 0) < 0)
+    fail(21);
+  fetch(&before);
+  before_blocks = before.inspect_data_blocks;
+  fd1 = open("fstrunc", O_TRUNC | O_RDWR);
+  if (fd1 < 0 || fstat(fd0, &st0) < 0 || fstat(fd1, &st1) < 0 ||
+      fsaudit(FSAUDIT_INSPECT_FD, fd0, 0) < 0)
+    fail(22);
+  fetch(&snap);
+  after_blocks = snap.inspect_data_blocks;
+  rewrite = write(fd0, "new", 3);
+  if (rewrite != 3 || fstat(fd1, &st1) < 0)
+    fail(23);
+  printf("FS TRUNC generation=3 inum_fd0=%d inum_fd1=%d "
+         "before_size=%d before_blocks=%d "
+         "after_size=%d after_blocks=%d peer_size=%d rewrite=%d final_size=%d "
+         "status=0 cleanup=1\n",
+         st0.ino, st1.ino, before.inspect_size, before_blocks,
+         snap.inspect_size, after_blocks, (int)st0.size, rewrite,
+         (int)st1.size);
+  close(fd0);
+  close(fd1);
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  if (unlink("fstrunc") < 0)
+    fail(24);
+  print_after("TRUNC");
+}
+
+static void
+case_fdfail(void)
+{
+  int fd, created, check, filled = 0;
+  int dups[NOFILE];
+
+  fsaudit(FSAUDIT_RESET, 4, 0);
+  fd = open("README", O_RDONLY);
+  if (fd < 0)
+    fail(30);
+  while (filled < NOFILE && (dups[filled] = dup(fd)) >= 0)
+    filled++;
+  created = open("fsfd", O_CREATE | O_RDWR);
+  if (created >= 0 || filled == 0)
+    fail(31);
+  close(dups[filled - 1]);
+  check = open("fsfd", O_RDONLY);
+  if (check < 0 || fstat(check, &st0) < 0)
+    fail(32);
+  fetch(&snap);
+  printf("FS FDFAIL generation=4 filled=%d create=%d check_fd=%d nlink=%d "
+         "size=%d blocks_held=%d inodes_held=%d status=0 cleanup=1\n",
+         filled, created, check, st0.nlink, (int)st0.size, snap.blocks,
+         snap.inodes);
+  close(check);
+  for (int i = 0; i < filled - 1; i++)
+    close(dups[i]);
+  close(fd);
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  if (unlink("fsfd") < 0)
+    fail(33);
+  print_after("FDFAIL");
+}
+
+static void
+case_linkfail(void)
+{
+  int fd, result, target, nlink_before, nlink_after;
+
+  fsaudit(FSAUDIT_RESET, 5, 0);
+  fd = open("fssrc", O_CREATE | O_RDWR);
+  if (fd < 0 || fstat(fd, &st0) < 0)
+    fail(40);
+  nlink_before = st0.nlink;
+  close(fd);
+  fetch(&before);
+  if (fsaudit(FSAUDIT_ARM_DIRLINK, 1, 0) < 0)
+    fail(41);
+  result = link("fssrc", "fsbadlink");
+  target = open("fsbadlink", O_RDONLY);
+  fd = open("fssrc", O_RDONLY);
+  if (result != -1 || target >= 0 || fd < 0 || fstat(fd, &st0) < 0)
+    fail(42);
+  nlink_after = st0.nlink;
+  close(fd);
+  fetch(&snap);
+  printf("FS LINKFAIL generation=5 fail_at=1 eligible=%d fired=%d link=%d "
+         "target=%d nlink_before=%d nlink_after=%d blocks_before=%d "
+         "blocks_after=%d inodes_before=%d inodes_after=%d "
+         "status=0 cleanup=1\n", snap.eligible, snap.fired, result, target,
+         nlink_before, nlink_after, before.blocks, snap.blocks, before.inodes,
+         snap.inodes);
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  if (unlink("fssrc") < 0)
+    fail(43);
+  print_after("LINKFAIL");
+}
+
+static void
+case_allocfail(void)
+{
+  int fd, result;
+
+  fsaudit(FSAUDIT_RESET, 6, 0);
+  fd = open("fsalloc", O_CREATE | O_RDWR);
+  if (fd < 0)
+    fail(50);
+  fill('Q');
+  for (int i = 0; i < NDIRECT; i++)
+    if (write(fd, block, BSIZE) != BSIZE)
+      fail(51);
+  if (fsaudit(FSAUDIT_INSPECT_FD, fd, 0) < 0)
+    fail(52);
+  fetch(&before);
+  if (fsaudit(FSAUDIT_ARM_BALLOC, 2, 0) < 0)
+    fail(53);
+  result = write(fd, block, BSIZE);
+  if (fsaudit(FSAUDIT_INSPECT_FD, fd, 0) < 0)
+    fail(54);
+  fetch(&snap);
+  printf("FS ALLOCFAIL generation=6 fail_at=2 eligible=%d fired=%d write=%d "
+         "size_before=%d size_after=%d indirect_before=%d indirect_after=%d "
+         "indirect_data=%d blocks_before=%d blocks_after=%d "
+         "inodes_before=%d inodes_after=%d status=0 cleanup=1\n",
+         snap.eligible, snap.fired, result, before.inspect_size,
+         snap.inspect_size, before.inspect_indirect, snap.inspect_indirect,
+         snap.inspect_indirect0, before.blocks, snap.blocks, before.inodes,
+         snap.inodes);
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  close(fd);
+  if (unlink("fsalloc") < 0)
+    fail(55);
+  print_after("ALLOCFAIL");
+}
+
+int
+main(void)
+{
+  cleanup_names();
+  fsaudit(FSAUDIT_DISARM, 0, 0);
+  fetch(&base);
+  if (base.buf_refs != 0)
+    fail(99);
+  printf("FS BASE blocks=%d inodes=%d itable_active=%d itable_refs=%d "
+         "file_objects=%d file_refs=%d buf_refs=%d\n", base.blocks,
+         base.inodes, base.itable_active, base.itable_refs,
+         base.file_objects, base.file_refs, base.buf_refs);
+  case_rw();
+  case_link();
+  case_trunc();
+  case_fdfail();
+  case_linkfail();
+  case_allocfail();
+  printf("FS PASS cases=6 cleanup=1\n");
+  exit(0);
+}
