+void
+fs_audit_inode(struct inode *ip, struct fs_audit_snapshot *result)
+{
+  struct buf *bp;
+  uint *entries;
+  int i;
+
+  result->inspect_inum = ip->inum;
+  result->inspect_type = ip->type;
+  result->inspect_nlink = ip->nlink;
+  result->inspect_size = ip->size;
+  result->inspect_direct0 = ip->addrs[0];
+  result->inspect_direct11 = ip->addrs[NDIRECT - 1];
+  result->inspect_indirect = ip->addrs[NDIRECT];
+  for (i = 0; i < NDIRECT; i++)
+    if (ip->addrs[i])
+      result->inspect_data_blocks++;
+  if (ip->addrs[NDIRECT]) {
+    bp = bread(ip->dev, ip->addrs[NDIRECT]);
+    entries = (uint *)bp->data;
+    result->inspect_indirect0 = entries[0];
+    for (i = 0; i < NINDIRECT; i++)
+      if (entries[i])
+        result->inspect_data_blocks++;
+    brelse(bp);
+  }
+}
+
+void
+fs_audit_counts(struct fs_audit_snapshot *result)
+{
+  struct buf *bp;
+  struct dinode *dip;
+  int b, bi, inum;
+
+  result->blocks = 0;
+  for (b = 0; b < sb.size; b += BPB) {
+    bp = bread(ROOTDEV, BBLOCK(b, sb));
+    for (bi = 0; bi < BPB && b + bi < sb.size; bi++)
+      if (bp->data[bi / 8] & (1 << (bi % 8)))
+        result->blocks++;
+    brelse(bp);
+  }
+  result->inodes = 0;
+  for (inum = 1; inum < sb.ninodes; inum++) {
+    bp = bread(ROOTDEV, IBLOCK(inum, sb));
+    dip = (struct dinode *)bp->data + inum % IPB;
+    if (dip->type != 0)
+      result->inodes++;
+    brelse(bp);
+  }
+  result->itable_active = 0;
+  result->itable_refs = 0;
+  acquire(&itable.lock);
+  for (int i = 0; i < NINODE; i++) {
+    if (itable.inode[i].ref > 0)
+      result->itable_active++;
+    result->itable_refs += itable.inode[i].ref;
+  }
+  release(&itable.lock);
+}
diff --git a/kernel/fsaudit.c b/kernel/fsaudit.c
new file mode 100644
index 0000000..222d233
--- /dev/null
+++ b/kernel/fsaudit.c
@@ -0,0 +1,228 @@
+#include "types.h"
+#include "riscv.h"
+#include "defs.h"
+#include "param.h"
+#include "spinlock.h"
+#include "sleeplock.h"
+#include "proc.h"
+#include "fs.h"
+#include "buf.h"
+#include "file.h"
+#include "fsaudit.h"
+
+enum {
+  AUDIT_NONE,
+  AUDIT_BALLOC,
+  AUDIT_DIRLINK,
+};
+
+static struct {
+  struct spinlock lock;
+  int active;
+  int pid;
+  int mode;
+  int fail_at;
+  int seq;
+  int path_steps;
+  uint target_inum;
+  struct fs_audit_snapshot record;
+} audit;
+
+void
+fsauditinit(void)
+{
+  initlock(&audit.lock, "fsaudit");
+}
+
+static int
+ours(void)
+{
+  return audit.active && audit.pid == myproc()->pid;
+}
+
+void
+fsaudit_path_step(void)
+{
+  acquire(&audit.lock);
+  if (ours())
+    audit.path_steps++;
+  release(&audit.lock);
+}
+
+void
+fsaudit_open(struct inode *ip)
+{
+  acquire(&audit.lock);
+  if (ours() && audit.record.generation == 1 && audit.target_inum == 0) {
+    audit.target_inum = ip->inum;
+    audit.seq = 0;
+    audit.record.path_steps = audit.path_steps;
+    audit.record.open_seq = ++audit.seq;
+  }
+  release(&audit.lock);
+}
+
+void
+fsaudit_event(int event, struct inode *ip, uint block, struct buf *bp)
+{
+  int *slot = 0;
+
+  acquire(&audit.lock);
+  if (!ours() || audit.record.generation != 1 ||
+      audit.target_inum == 0 || ip == 0 || ip->inum != audit.target_inum) {
+    release(&audit.lock);
+    return;
+  }
+  switch (event) {
+  case FSE_FILE_WRITE:
+    slot = &audit.record.file_write_seq;
+    break;
+  case FSE_INODE_WRITE:
+    slot = &audit.record.inode_write_seq;
+    break;
+  case FSE_DIRECT:
+    slot = &audit.record.direct_seq;
+    break;
+  case FSE_BUFFER:
+    slot = &audit.record.buffer_seq;
+    break;
+  case FSE_INDIRECT:
+    slot = &audit.record.indirect_seq;
+    break;
+  case FSE_FILE_READ:
+    slot = &audit.record.file_read_seq;
+    break;
+  case FSE_INODE_READ:
+    slot = &audit.record.inode_read_seq;
+    break;
+  }
+  if (slot && *slot == 0)
+    *slot = ++audit.seq;
+  if (event == FSE_BUFFER && audit.record.buffer_block == 0 && bp) {
+    audit.record.buffer_block = block;
+    audit.record.buffer_valid = bp->valid;
+    audit.record.buffer_ref = bp->refcnt;
+    audit.record.buffer_locked = holdingsleep(&bp->lock);
+  }
+  release(&audit.lock);
+}
+
+int
+fsaudit_balloc_fail(void)
+{
+  int fail = 0;
+
+  acquire(&audit.lock);
+  if (ours() && audit.mode == AUDIT_BALLOC) {
+    audit.record.eligible++;
+    if (audit.record.eligible == audit.fail_at) {
+      audit.record.fired = 1;
+      fail = 1;
+    }
+  }
+  release(&audit.lock);
+  return fail;
+}
+
+int
+fsaudit_dirlink_fail(void)
+{
+  int fail = 0;
+
+  acquire(&audit.lock);
+  if (ours() && audit.mode == AUDIT_DIRLINK) {
+    audit.record.eligible++;
+    if (audit.record.eligible == audit.fail_at) {
+      audit.record.fired = 1;
+      fail = 1;
+    }
+  }
+  release(&audit.lock);
+  return fail;
+}
+
+static void
+arm(int generation, int mode, int fail_at)
+{
+  memset(&audit.record, 0, sizeof(audit.record));
+  audit.active = 1;
+  audit.pid = myproc()->pid;
+  audit.mode = mode;
+  audit.fail_at = fail_at;
+  audit.seq = 0;
+  audit.path_steps = 0;
+  audit.target_inum = 0;
+  audit.record.generation = generation;
+}
+
+static int
+inspect_fd(int fd)
+{
+  struct file *f;
+  struct fs_audit_snapshot inspected;
+
+  if (fd < 0 || fd >= NOFILE || (f = myproc()->ofile[fd]) == 0 ||
+      f->type != FD_INODE)
+    return -1;
+  memset(&inspected, 0, sizeof(inspected));
+  ilock(f->ip);
+  fs_audit_inode(f->ip, &inspected);
+  iunlock(f->ip);
+  acquire(&audit.lock);
+  audit.record.inspect_inum = inspected.inspect_inum;
+  audit.record.inspect_type = inspected.inspect_type;
+  audit.record.inspect_nlink = inspected.inspect_nlink;
+  audit.record.inspect_size = inspected.inspect_size;
+  audit.record.inspect_data_blocks = inspected.inspect_data_blocks;
+  audit.record.inspect_direct0 = inspected.inspect_direct0;
+  audit.record.inspect_direct11 = inspected.inspect_direct11;
+  audit.record.inspect_indirect = inspected.inspect_indirect;
+  audit.record.inspect_indirect0 = inspected.inspect_indirect0;
+  release(&audit.lock);
+  return 0;
+}
+
+int
+fsaudit_command(int op, int arg, uint64 out)
+{
+  struct fs_audit_snapshot result;
+
+  if (op == FSAUDIT_RESET) {
+    acquire(&audit.lock);
+    arm(arg, AUDIT_NONE, 0);
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == FSAUDIT_ARM_BALLOC || op == FSAUDIT_ARM_DIRLINK) {
+    acquire(&audit.lock);
+    audit.active = 1;
+    audit.pid = myproc()->pid;
+    audit.mode = op == FSAUDIT_ARM_BALLOC ? AUDIT_BALLOC : AUDIT_DIRLINK;
+    audit.fail_at = arg;
+    audit.record.eligible = 0;
+    audit.record.fired = 0;
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == FSAUDIT_DISARM) {
+    acquire(&audit.lock);
+    audit.active = 0;
+    audit.mode = AUDIT_NONE;
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == FSAUDIT_INSPECT_FD)
+    return inspect_fd(arg);
+  if (op != FSAUDIT_FETCH || out == 0)
+    return -1;
+
+  acquire(&audit.lock);
+  result = audit.record;
+  release(&audit.lock);
+  fs_audit_counts(&result);
+  file_audit_counts(&result);
+  bio_audit_counts(&result);
+  if (copyout(myproc()->pagetable, out, (char *)&result, sizeof(result)) < 0)
+    return -1;
+  return 0;
+}
diff --git a/kernel/fsaudit.h b/kernel/fsaudit.h
new file mode 100644
index 0000000..dc65c7d
--- /dev/null
+++ b/kernel/fsaudit.h
@@ -0,0 +1,52 @@
+#define FSAUDIT_RESET        1
+#define FSAUDIT_FETCH        2
+#define FSAUDIT_ARM_BALLOC   3
+#define FSAUDIT_ARM_DIRLINK  4
+#define FSAUDIT_DISARM       5
+#define FSAUDIT_INSPECT_FD   6
+
+#define FSE_OPEN         1
+#define FSE_FILE_WRITE   2
+#define FSE_INODE_WRITE  3
+#define FSE_DIRECT       4
+#define FSE_BUFFER       5
+#define FSE_INDIRECT     6
+#define FSE_FILE_READ    7
+#define FSE_INODE_READ   8
+
+struct fs_audit_snapshot {
+  int generation;
+  int eligible;
+  int fired;
+  int path_steps;
+  int open_seq;
+  int file_write_seq;
+  int inode_write_seq;
+  int direct_seq;
+  int buffer_seq;
+  int indirect_seq;
+  int file_read_seq;
+  int inode_read_seq;
+  uint buffer_block;
+  int buffer_valid;
+  int buffer_ref;
+  int buffer_locked;
+
+  uint inspect_inum;
+  int inspect_type;
+  int inspect_nlink;
+  uint inspect_size;
+  int inspect_data_blocks;
+  uint inspect_direct0;
+  uint inspect_direct11;
+  uint inspect_indirect;
+  uint inspect_indirect0;
+
+  int blocks;
+  int inodes;
+  int itable_active;
+  int itable_refs;
+  int file_objects;
+  int file_refs;
+  int buf_refs;
+};
