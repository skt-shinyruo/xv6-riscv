@@ -0,0 +1,43 @@
+#define VMPROBE_ARM      1
+#define VMPROBE_FETCH    2
+#define VMPROBE_FREE     3
+#define VMPROBE_SET_X    5
+#define VMPROBE_SPECIAL  6
+
+#define VMACCESS_LOAD    1
+#define VMACCESS_STORE   2
+#define VMACCESS_COPYIN  3
+#define VMACCESS_COPYOUT 4
+#define VMACCESS_EXEC    5
+
+struct vmprobe_record {
