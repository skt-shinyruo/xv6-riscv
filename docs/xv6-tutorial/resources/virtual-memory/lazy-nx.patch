+  uint64 trapframe_va;
+  uint64 user_trampoline_pa;
+  uint64 kernel_trampoline_pa;
+  uint64 trapframe_pa;
+  uint64 trapframe_owner_pa;
+  int user_trampoline_flags;
+  int kernel_trampoline_flags;
+  int trapframe_flags;
+  int kernel_trapframe_flags;
+};
