 }
+
+int
+kfreepages(void)
+{
+  int n = 0;
+  struct run *r;
+
+  acquire(&kmem.lock);
+  for (r = kmem.freelist; r; r = r->next)
+    n++;
+  release(&kmem.lock);
+  return n;
+}
