diff --git a/user/vmtrace.c b/user/vmtrace.c
new file mode 100644
index 0000000..2a253d5
--- /dev/null
+++ b/user/vmtrace.c
@@ -0,0 +1,311 @@
+#include "kernel/param.h"
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/memlayout.h"
+#include "kernel/riscv.h"
+#include "kernel/vmprobe.h"
+
+#define TARGET (1ULL << 30)
+
+static char exec_arg[3000];
+static char exec_arg2[3000];
+
+static void
+fail(const char *why)
+{
+  printf("VM FAIL %s\n", why);
+  exit(1);
+}
+
+static char *
+lazy_page(void)
+{
+  uint64 top = (uint64)sbrk(0);
+  uint64 rem = top % PGSIZE;
+  char *p;
+
+  if (rem != 0 && sbrk((int)(PGSIZE - rem)) == SBRK_ERROR)
+    fail("align");
+  p = sbrklazy(PGSIZE);
+  if (p == SBRK_ERROR)
+    fail("sbrklazy");
+  return p;
+}
+
+static void
+ret_instruction(char *p)
+{
+  *(volatile uint32 *)p = 0x00008067;
+  asm volatile("fence.i" ::: "memory");
+}
+
+static void
+print_record(const char *name, int pid, int status, int base, int after,
+             struct vmprobe_record *r)
+{
+  printf("VM CASE name=%s pid=%d status=%d base=%d after=%d gen=%d access=%d "
+         "result=%d fail_at=%d allocations=%d before=0x%x after_flags=0x%x "
+         "free_before=%d free_after=%d va=0x%lx scause=%ld stval=0x%lx epc=0x%lx\n",
+         name, pid, status, base, after, r->generation, r->access, r->result,
+         r->fail_at, r->allocations, r->before_flags, r->after_flags,
+         r->free_before, r->free_after, r->va, r->scause, r->stval, r->epc);
+}
+
+enum killed_case {
+  KILLED_INVALID,
+  KILLED_PERMISSION,
+  KILLED_NX,
+};
+
+static void
+run_success(const char *name, int generation, int access)
+{
+  int pid, status, base, after;
+  struct vmprobe_record record;
+
+  base = vmprobe(VMPROBE_FREE, 0, 0);
+  pid = fork();
+  if (pid < 0)
+    fail("fork");
+  if (pid == 0) {
+    char *p = lazy_page();
+    if (vmprobe(VMPROBE_ARM, ((uint64)generation << 32), 0) < 0)
+      exit(2);
+    if (access == VMACCESS_LOAD) {
+      if (*(volatile uchar *)p != 0)
+        exit(3);
+    } else if (access == VMACCESS_STORE) {
+      *(volatile uchar *)p = 0x5a;
+    } else {
+      int fds[2];
+      uchar bytes[4] = {0xaa, 0xaa, 0xaa, 0xaa};
+      uchar pattern[4] = {0x11, 0x22, 0x33, 0x44};
+      if (pipe(fds) < 0)
+        exit(4);
+      if (access == VMACCESS_COPYOUT) {
+        if (write(fds[1], pattern, sizeof(pattern)) != sizeof(pattern))
+          exit(5);
+        if (read(fds[0], p, sizeof(pattern)) != sizeof(pattern))
+          exit(6);
+        if (p[0] != 0x11 || p[1] != 0x22 || p[2] != 0x33 || p[3] != 0x44)
+          exit(9);
+      } else {
+        if (write(fds[1], p, sizeof(bytes)) != sizeof(bytes))
+          exit(7);
+        if (read(fds[0], bytes, sizeof(bytes)) != sizeof(bytes))
+          exit(8);
+        if (bytes[0] != 0 || bytes[1] != 0 || bytes[2] != 0 || bytes[3] != 0)
+          exit(10);
+      }
+      close(fds[0]);
+      close(fds[1]);
+    }
+    exit(0);
+  }
+  if (wait(&status) != pid)
+    fail("wait");
+  after = vmprobe(VMPROBE_FREE, 0, 0);
+  if (vmprobe(VMPROBE_FETCH, pid, &record) < 0)
+    fail("fetch");
+  print_record(name, pid, status, base, after, &record);
+  if (status != 0 || after != base || record.result != 1 ||
+      record.before_flags != 0 ||
+      (record.after_flags & (PTE_V | PTE_R | PTE_W | PTE_U | PTE_X)) !=
+          (PTE_V | PTE_R | PTE_W | PTE_U) ||
+      (record.after_flags & PTE_X) != 0 || record.allocations < 1)
+    fail(name);
+}
+
+static void
+run_killed(const char *name, int generation, enum killed_case kind)
+{
+  int pid, status, base, after;
+  struct vmprobe_record record;
+
+  base = vmprobe(VMPROBE_FREE, 0, 0);
+  pid = fork();
+  if (pid < 0)
+    fail("fork");
+  if (pid == 0) {
+    char *p;
+    if (kind == KILLED_INVALID) {
+      uint64 bad = (uint64)sbrk(0);
+      if (vmprobe(VMPROBE_ARM, (uint64)generation << 32, 0) < 0)
+        exit(2);
+      *(volatile uchar *)bad = 1;
+    } else if (kind == KILLED_PERMISSION) {
+      if (vmprobe(VMPROBE_ARM, (uint64)generation << 32, 0) < 0)
+        exit(2);
+      *(volatile uint32 *)(uint64)&fail = 0;
+    } else {
+      p = lazy_page();
+      ret_instruction(p);
+      if (vmprobe(VMPROBE_ARM, (uint64)generation << 32, 0) < 0)
+        exit(2);
+      ((int (*)(void))p)();
+    }
+    exit(9);
+  }
+  if (wait(&status) != pid)
+    fail("wait");
+  after = vmprobe(VMPROBE_FREE, 0, 0);
+  if (vmprobe(VMPROBE_FETCH, pid, &record) < 0)
+    fail("fetch");
+  print_record(name, pid, status, base, after, &record);
+  if (status != -1 || after != base || record.result != 0)
+    fail(name);
+  if (kind == KILLED_INVALID &&
+      (record.scause != 15 || record.allocations != 0))
+    fail("invalid-oracle");
+  if (kind == KILLED_PERMISSION &&
+      (record.scause != 15 || record.allocations != 0))
+    fail("permission-oracle");
+  if (kind == KILLED_NX &&
+      (record.scause != 12 || record.allocations != 0 ||
+       (record.before_flags & PTE_X) != 0))
+    fail("nx-oracle");
+}
+
+static void
+run_oom(int generation, int fail_at)
+{
+  int pid, status, base, after;
+  struct vmprobe_record record;
+
+  base = vmprobe(VMPROBE_FREE, 0, 0);
+  pid = fork();
+  if (pid < 0)
+    fail("fork");
+  if (pid == 0) {
+    uint64 top = (uint64)sbrk(0);
+    if (sbrklazy((int)(TARGET + PGSIZE - top)) == SBRK_ERROR)
+      exit(2);
+    if (vmprobe(VMPROBE_ARM,
+                ((uint64)generation << 32) | (uint64)fail_at, 0) < 0)
+      exit(3);
+    *(volatile uchar *)TARGET = 1;
+    exit(9);
+  }
+  if (wait(&status) != pid)
+    fail("wait");
+  after = vmprobe(VMPROBE_FREE, 0, 0);
+  if (vmprobe(VMPROBE_FETCH, pid, &record) < 0)
+    fail("fetch");
+  print_record("oom", pid, status, base, after, &record);
+  if (status != -1 || after != base || record.result != 0 ||
+      record.allocations != fail_at || record.after_flags != 0)
+    fail("oom-oracle");
+  if (fail_at < 3 && record.free_after != record.free_before)
+    fail("oom-rollback");
+  if (fail_at == 3 && record.free_after != record.free_before - 1)
+    fail("oom-intermediate");
+}
+
+static void
+run_exec_rollback(void)
+{
+  int pid, status, base, after;
+
+  base = vmprobe(VMPROBE_FREE, 0, 0);
+  pid = fork();
+  if (pid < 0)
+    fail("fork");
+  if (pid == 0) {
+    char *p = lazy_page();
+    char *argv[4];
+    int before = getpid();
+    int i;
+    for (i = 0; i < (int)sizeof(exec_arg) - 1; i++)
+      exec_arg[i] = 'x';
+    exec_arg[sizeof(exec_arg) - 1] = 0;
+    for (i = 0; i < (int)sizeof(exec_arg2) - 1; i++)
+      exec_arg2[i] = 'y';
+    exec_arg2[sizeof(exec_arg2) - 1] = 0;
+    *(volatile uchar *)p = 0x42;
+    argv[0] = "echo";
+    argv[1] = exec_arg;
+    argv[2] = exec_arg2;
+    argv[3] = 0;
+    if (exec("echo", argv) != -1 || getpid() != before ||
+        *(volatile uchar *)p != 0x42)
+      exit(3);
+    exit(42);
+  }
+  if (wait(&status) != pid)
+    fail("wait");
+  after = vmprobe(VMPROBE_FREE, 0, 0);
+  printf("VM EXEC pid=%d status=%d base=%d after=%d\n", pid, status, base,
+         after);
+  if (status != 42 || base != after)
+    fail("exec-rollback");
+}
+
+int
+main(void)
+{
+  struct vmprobe_special special;
+
+  if (vmprobe(VMPROBE_SPECIAL, 0, &special) < 0)
+    fail("special");
+  printf("VM SPECIAL user_root=0x%lx kernel_root=0x%lx tramp_va=0x%lx "
+         "trap_va=0x%lx user_tramp_pa=0x%lx kernel_tramp_pa=0x%lx "
+         "trap_pa=0x%lx owner_pa=0x%lx user_tramp_flags=0x%x "
+         "kernel_tramp_flags=0x%x trap_flags=0x%x kernel_trap_flags=0x%x\n",
+         special.user_root, special.kernel_root, special.trampoline_va,
+         special.trapframe_va, special.user_trampoline_pa,
+         special.kernel_trampoline_pa, special.trapframe_pa,
+         special.trapframe_owner_pa, special.user_trampoline_flags,
+         special.kernel_trampoline_flags, special.trapframe_flags,
+         special.kernel_trapframe_flags);
+  if (special.user_root == special.kernel_root ||
+      special.user_trampoline_pa != special.kernel_trampoline_pa ||
+      special.trapframe_pa != special.trapframe_owner_pa ||
+      (special.user_trampoline_flags & (PTE_V | PTE_R | PTE_X | PTE_U)) !=
+          (PTE_V | PTE_R | PTE_X) ||
+      (special.trapframe_flags & (PTE_V | PTE_R | PTE_W | PTE_U)) !=
+          (PTE_V | PTE_R | PTE_W) || special.kernel_trapframe_flags != 0)
+    fail("special-oracle");
+
+  run_success("load", 1, VMACCESS_LOAD);
+  run_success("store", 2, VMACCESS_STORE);
+  run_success("copyout", 3, VMACCESS_COPYOUT);
+  run_success("copyin", 4, VMACCESS_COPYIN);
+  run_killed("invalid", 5, KILLED_INVALID);
+  run_killed("permission", 6, KILLED_PERMISSION);
+  run_killed("nx", 7, KILLED_NX);
+
+  {
+    int pid, status;
+    char *p;
+    struct vmprobe_record record;
+    int base = vmprobe(VMPROBE_FREE, 0, 0);
+    pid = fork();
+    if (pid == 0) {
+      p = lazy_page();
+      ret_instruction(p);
+      if (vmprobe(VMPROBE_ARM, (uint64)8 << 32, 0) < 0 ||
+          vmprobe(VMPROBE_SET_X, (uint64)p, 0) < 0)
+        exit(2);
+      if (((int (*)(void))p)() != 0)
+        exit(3);
+      exit(0);
+    }
+    if (wait(&status) != pid || status != 0)
+      fail("mutation-status");
+    if (vmprobe(VMPROBE_FETCH, pid, &record) < 0 ||
+        (record.after_flags & PTE_X) == 0 || record.result != 1)
+      fail("mutation-oracle");
+    if (vmprobe(VMPROBE_FREE, 0, 0) != base)
+      fail("mutation-ledger");
+    printf("VM MUTATION pid=%d status=%d flags=0x%x\n", pid, status,
+           record.after_flags);
+  }
+
+  run_oom(9, 1);
+  run_oom(10, 2);
+  run_oom(11, 3);
+  run_exec_rollback();
+  printf("VM PASS cases=12\n");
+  exit(0);
+}
