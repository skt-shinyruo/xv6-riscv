+struct {
+  int active;
+  int in_fault;
+  int pid;
+  int generation;
+  int fail_at;
+  int allocations;
+  struct vmprobe_record record;
+} vmprobe_state;
+
+static int
+vmprobe_pte_flags(pagetable_t pagetable, uint64 va)
+{
+  pte_t *pte = walk(pagetable, PGROUNDDOWN(va), 0);
+  if (pte == 0 || (*pte & PTE_V) == 0)
+    return 0;
+  return PTE_FLAGS(*pte);
+}
+
+static uint64
+vmprobe_pte_pa(pagetable_t pagetable, uint64 va)
+{
+  pte_t *pte = walk(pagetable, PGROUNDDOWN(va), 0);
+  if (pte == 0 || (*pte & PTE_V) == 0)
+    return 0;
+  return PTE2PA(*pte);
+}
+
+int
+vmprobe_kalloc_should_fail(void)
+{
+  struct proc *p;
+
+  if (!vmprobe_state.active || !vmprobe_state.in_fault)
+    return 0;
+  p = myproc();
+  if (p == 0 || p->pid != vmprobe_state.pid)
+    return 0;
+  vmprobe_state.allocations++;
+  return vmprobe_state.fail_at != 0 &&
+         vmprobe_state.allocations == vmprobe_state.fail_at;
+}
+
+static void
+vmprobe_begin(int access, uint64 va, int pid)
+{
+  if (!vmprobe_state.active || vmprobe_state.pid != pid)
+    return;
+  vmprobe_state.in_fault = 1;
+  vmprobe_state.allocations = 0;
+  vmprobe_state.record.pid = pid;
+  vmprobe_state.record.access = access;
+  vmprobe_state.record.va = PGROUNDDOWN(va);
+  vmprobe_state.record.fail_at = vmprobe_state.fail_at;
+  vmprobe_state.record.allocations = 0;
+  vmprobe_state.record.before_flags =
+      vmprobe_pte_flags(myproc()->pagetable, va);
+  vmprobe_state.record.free_before = kfreepages();
+  vmprobe_state.record.scause = 0;
+  vmprobe_state.record.stval = 0;
+  vmprobe_state.record.epc = 0;
+  if (access == VMACCESS_LOAD || access == VMACCESS_STORE) {
+    vmprobe_state.record.scause = access == VMACCESS_LOAD ? 13 : 15;
+    vmprobe_state.record.stval = va;
+    vmprobe_state.record.epc = r_sepc();
+  }
+}
+
+static void
+vmprobe_finish(int result, uint64 va, int flags)
+{
+  if (!vmprobe_state.in_fault)
+    return;
+  vmprobe_state.record.result = result;
+  vmprobe_state.record.allocations = vmprobe_state.allocations;
+  vmprobe_state.record.after_flags = result ? flags :
+      vmprobe_pte_flags(myproc()->pagetable, va);
+  vmprobe_state.record.free_after = kfreepages();
+  vmprobe_state.record.generation = vmprobe_state.generation;
+  vmprobe_state.active = 0;
+  vmprobe_state.in_fault = 0;
+}
+
+void
+vmprobe_trap(uint64 scause, uint64 stval, uint64 epc)
+{
+  struct proc *p = myproc();
+
+  if (p == 0 || p->pid != vmprobe_state.pid)
+    return;
+  if (!vmprobe_state.active && vmprobe_state.record.result != 0)
+    return;
+  vmprobe_state.record.pid = p->pid;
+  vmprobe_state.record.scause = scause;
+  vmprobe_state.record.stval = stval;
+  vmprobe_state.record.epc = epc;
+  vmprobe_state.record.result = 0;
+  vmprobe_state.record.allocations = vmprobe_state.allocations;
+  vmprobe_state.record.after_flags =
+      vmprobe_pte_flags(p->pagetable, stval);
+  if (vmprobe_state.record.free_before == 0)
+    vmprobe_state.record.free_before = kfreepages();
+  vmprobe_state.record.free_after = kfreepages();
+  vmprobe_state.record.generation = vmprobe_state.generation;
+  if (scause == 12)
+    vmprobe_state.record.access = VMACCESS_EXEC;
+  vmprobe_state.active = 0;
+  vmprobe_state.in_fault = 0;
+}
+
+int
+vmprobe_command(int op, uint64 arg, uint64 out)
+{
+  struct proc *p = myproc();
+  struct vmprobe_special special;
+  int flags, result;
+
+  if (op == VMPROBE_ARM) {
+    vmprobe_state.active = 1;
+    vmprobe_state.in_fault = 0;
+    vmprobe_state.pid = p->pid;
+    vmprobe_state.generation = arg >> 32;
+    vmprobe_state.fail_at = arg & 0xffffffff;
+    memset(&vmprobe_state.record, 0, sizeof(vmprobe_state.record));
+    vmprobe_state.record.generation = vmprobe_state.generation;
+    vmprobe_state.record.pid = p->pid;
+    vmprobe_state.record.fail_at = vmprobe_state.fail_at;
+    return 0;
+  }
+  if (op == VMPROBE_FREE)
+    return kfreepages();
+  if (op == VMPROBE_SET_X) {
+    pte_t *pte = walk(p->pagetable, arg, 0);
+    if (pte == 0 || (*pte & PTE_V) == 0 || (*pte & PTE_U) == 0)
+      return -1;
+    flags = PTE_FLAGS(*pte);
+    *pte |= PTE_X;
+    sfence_vma();
+    vmprobe_state.record.access = VMACCESS_EXEC;
+    vmprobe_state.record.va = PGROUNDDOWN(arg);
+    vmprobe_state.record.before_flags = flags;
+    vmprobe_state.record.after_flags = flags | PTE_X;
+    vmprobe_state.record.result = 1;
+    vmprobe_state.record.free_before = kfreepages();
+    vmprobe_state.record.free_after = vmprobe_state.record.free_before;
+    vmprobe_state.record.generation = vmprobe_state.generation;
+    vmprobe_state.active = 0;
+    return 0;
+  }
+  if (op == VMPROBE_SPECIAL) {
+    memset(&special, 0, sizeof(special));
+    special.user_root = (uint64)p->pagetable;
+    special.kernel_root = (uint64)kernel_pagetable;
+    special.trampoline_va = TRAMPOLINE;
+    special.trapframe_va = TRAPFRAME;
+    special.user_trampoline_pa = vmprobe_pte_pa(p->pagetable, TRAMPOLINE);
+    special.kernel_trampoline_pa = vmprobe_pte_pa(kernel_pagetable, TRAMPOLINE);
+    special.trapframe_pa = vmprobe_pte_pa(p->pagetable, TRAPFRAME);
+    special.trapframe_owner_pa = (uint64)p->trapframe;
+    special.user_trampoline_flags = vmprobe_pte_flags(p->pagetable, TRAMPOLINE);
+    special.kernel_trampoline_flags = vmprobe_pte_flags(kernel_pagetable, TRAMPOLINE);
+    special.trapframe_flags = vmprobe_pte_flags(p->pagetable, TRAPFRAME);
+    special.kernel_trapframe_flags = vmprobe_pte_flags(kernel_pagetable, TRAPFRAME);
+    return copyout(p->pagetable, out, (char *)&special, sizeof(special));
+  }
+  if (op == VMPROBE_FETCH) {
+    if (arg != (uint64)vmprobe_state.pid)
+      return -1;
+    result = copyout(p->pagetable, out, (char *)&vmprobe_state.record,
+                     sizeof(vmprobe_state.record));
+    vmprobe_state.active = 0;
+    vmprobe_state.in_fault = 0;
+    return result;
+  }
+  return -1;
+}
+
 // allocate and map user memory if process is referencing a page
 // that was lazily allocated in sys_sbrk().
 // returns 0 if va is invalid or already mapped, or if
 // out of physical memory, and physical address if successful.
 uint64
-vmfault(pagetable_t pagetable, uint64 va, int read)
+vmfault(pagetable_t pagetable, uint64 va, int access)
 {
   uint64 mem;
   struct proc *p = myproc();
 
-  if (va >= p->sz)
+  vmprobe_begin(access, va, p->pid);
+  if (va >= p->sz) {
+    vmprobe_finish(0, va, 0);
     return 0;
+  }
   va = PGROUNDDOWN(va);
   if (ismapped(pagetable, va)) {
+    vmprobe_finish(0, va, 0);
     return 0;
   }
   mem = (uint64)kalloc();
-  if (mem == 0)
+  if (mem == 0) {
+    vmprobe_finish(0, va, 0);
     return 0;
+  }
   memset((void *)mem, 0, PGSIZE);
   if (mappages(p->pagetable, va, PGSIZE, mem, PTE_W | PTE_U | PTE_R) != 0) {
     kfree((void *)mem);
+    vmprobe_finish(0, va, 0);
     return 0;
   }
+  vmprobe_finish(1, va, PTE_W | PTE_U | PTE_R | PTE_V);
   return mem;
 }
 
diff --git a/kernel/vmprobe.h b/kernel/vmprobe.h
new file mode 100644
index 0000000..504e9cf
