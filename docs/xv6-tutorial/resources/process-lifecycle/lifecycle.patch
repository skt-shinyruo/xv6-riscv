+
+int
+freepagecount(void)
+{
+  int count = 0;
+  struct run *r;
+
+  acquire(&kmem.lock);
+  for (r = kmem.freelist; r; r = r->next)
+    count++;
+  release(&kmem.lock);
+  return count;
+}
diff --git a/kernel/lifecycle.h b/kernel/lifecycle.h
new file mode 100644
index 0000000..426b1f7
--- /dev/null
+++ b/kernel/lifecycle.h
@@ -0,0 +1,35 @@
+#define LIFE_NAME 16
+#define LIFE_EVENT_BEFORE 1
+#define LIFE_EVENT_AFTER 2
+#define LIFE_EVENT_ORPHAN 3
+
+struct lifeevent {
+  int kind;
+  int pid;
+  int value;
+};
+
+// Read-only process/resource data returned by the tutorial snapshot syscall.
+struct lifesnapshot {
+  int used;
+  int sleeping;
+  int runnable;
+  int running;
+  int zombie;
+  int free_pages;
+  int active_files;
+  int file_refs;
+  int parent_links;
+  int target_present;
+  int target_sleeping;
+  int target_zombie;
+  int target_parent_is_init;
+  int target_parent_is_caller;
+  int target_ofile_slots;
+  uint64 target_sz;
+  uint64 target_pagetable;
+  uint64 target_trapframe;
+  uint64 target_epc;
+  uint64 target_cwd;
+  char target_name[LIFE_NAME];
+};
diff --git a/kernel/proc.c b/kernel/proc.c
index 611e94c..5574e99 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -6,0 +7 @@
+#include "lifecycle.h"
@@ -631,0 +633,47 @@ killed(struct proc *p)
+void
+procsnapshot(int target_pid, struct lifesnapshot *out)
+{
+  struct proc *p;
+  struct proc *caller = myproc();
+
+  memset(out, 0, sizeof(*out));
+  acquire(&wait_lock);
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED) {
+      out->used++;
+      if (p->state == SLEEPING)
+        out->sleeping++;
+      if (p->state == RUNNABLE)
+        out->runnable++;
+      if (p->state == RUNNING)
+        out->running++;
+      if (p->state == ZOMBIE)
+        out->zombie++;
+      if (p->parent)
+        out->parent_links++;
+      if (p->pid == target_pid) {
+        out->target_present = 1;
+        out->target_sleeping = p->state == SLEEPING;
+        out->target_zombie = p->state == ZOMBIE;
+        out->target_parent_is_init = p->parent == initproc;
+        out->target_parent_is_caller = p->parent == caller;
+        out->target_sz = p->sz;
+        out->target_pagetable = (uint64)p->pagetable;
+        out->target_trapframe = (uint64)p->trapframe;
+        out->target_epc = p->trapframe ? p->trapframe->epc : 0;
+        out->target_cwd = (uint64)p->cwd;
+        for (int fd = 0; fd < NOFILE; fd++)
+          if (p->ofile[fd])
+            out->target_ofile_slots++;
+        safestrcpy(out->target_name, p->name, sizeof(out->target_name));
+      }
+    }
+    release(&p->lock);
+  }
+  release(&wait_lock);
+
+  out->free_pages = freepagecount();
+  filerefcount(&out->active_files, &out->file_refs);
+}
+
