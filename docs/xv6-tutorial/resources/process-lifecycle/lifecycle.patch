index 13a4e69..5e7796e 100644
--- a/kernel/file.c
+++ b/kernel/file.c
@@ -27,0 +28,17 @@ fileinit(void)
+void
+filerefcount(int *active, int *refs)
+{
+  struct file *f;
+
+  *active = 0;
+  *refs = 0;
+  acquire(&ftable.lock);
+  for (f = ftable.file; f < ftable.file + NFILE; f++) {
+    if (f->ref > 0) {
+      (*active)++;
+      *refs += f->ref;
+    }
+  }
+  release(&ftable.lock);
+}
+
