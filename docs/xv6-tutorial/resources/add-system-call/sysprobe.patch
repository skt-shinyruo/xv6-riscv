@@ -2766,3 +2766,18 @@
+void
+sysprobetest(char *s)
+{
+  int values[] = {0, 12345, -7};
+
+  for (int i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+    int got = sysprobe(values[i]);
+    if (got != values[i]) {
+      printf("%s: sysprobe(%d) returned %d, expected %d\n", s, values[i], got,
+             values[i]);
+      exit(1);
+    }
+  }
+}
