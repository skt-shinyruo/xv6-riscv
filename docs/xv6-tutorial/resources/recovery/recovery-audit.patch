diff --git a/user/recoverycase.c b/user/recoverycase.c
new file mode 100644
index 0000000..fa3c6b2
--- /dev/null
+++ b/user/recoverycase.c
@@ -0,0 +1,34 @@
+#include "kernel/types.h"
+#include "kernel/recoveryaudit.h"
+#include "user/user.h"
+
+static int
+point_id(char *name)
+{
+  if (strcmp(name, "LOG_DATA_COMPLETE") == 0)
+    return RC_LOG_DATA_COMPLETE;
+  if (strcmp(name, "COMMIT_HEADER_COMPLETE") == 0)
+    return RC_COMMIT_HEADER_COMPLETE;
+  if (strcmp(name, "HOME_INSTALL_COMPLETE") == 0)
+    return RC_HOME_INSTALL_COMPLETE;
+  if (strcmp(name, "HEADER_CLEAR_COMPLETE") == 0)
+    return RC_HEADER_CLEAR_COMPLETE;
+  return -1;
+}
+
+int
+main(int argc, char **argv)
+{
+  int point, epoch;
+
+  if (argc != 3 || (point = point_id(argv[1])) < 0 ||
+      (epoch = atoi(argv[2])) <= 0) {
+    fprintf(2, "usage: recoverycase POINT EPOCH\n");
+    exit(1);
+  }
+  if (recoverycase(point, epoch) < 0) {
+    fprintf(2, "recoverycase: invalid or unfired rule\n");
+    exit(1);
+  }
+  exit(0);
+}
