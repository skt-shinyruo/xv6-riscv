diff --git a/kernel/recoveryaudit.c b/kernel/recoveryaudit.c
new file mode 100644
index 0000000..0c16b44
--- /dev/null
+++ b/kernel/recoveryaudit.c
@@ -0,0 +1,74 @@
+#include "types.h"
+#include "riscv.h"
+#include "defs.h"
+#include "param.h"
+#include "spinlock.h"
+#include "sleeplock.h"
+#include "fs.h"
+#include "buf.h"
+#include "recoveryaudit.h"
+
+static struct {
+  int armed;
+  int fired;
+  int point;
+  int epoch;
+} audit;
+
+static void
+write_pattern(int after, int epoch)
+{
+  uint blocks[RC_HOME_COUNT] = {RC_HOME0, RC_HOME1};
+
+  begin_op();
+  for (int i = 0; i < RC_HOME_COUNT; i++) {
+    struct buf *b = bread(ROOTDEV, blocks[i]);
+    memset(b->data, (after ? 0xa0 : 0x50) + i, BSIZE);
+    ((uint *)b->data)[0] = epoch;
+    ((uint *)b->data)[1] = after;
+    ((uint *)b->data)[2] = i;
+    log_write(b);
+    brelse(b);
+  }
+  end_op();
+}
+
+int
+recoveryaudit_case(int point, int epoch)
+{
+  if (point != RC_LOG_DATA_COMPLETE &&
+      point != RC_COMMIT_HEADER_COMPLETE &&
+      point != RC_HOME_INSTALL_COMPLETE &&
+      point != RC_HEADER_CLEAR_COMPLETE)
+    return -1;
+  if (epoch <= 0 || audit.armed)
+    return -1;
+
+  write_pattern(0, epoch);
+  audit.point = point;
+  audit.epoch = epoch;
+  audit.fired = 0;
+  audit.armed = 1;
+  write_pattern(1, epoch);
+  return -1;
+}
+
+int
+recoveryaudit_armed(void)
+{
+  return audit.armed;
+}
+
+void
+recoveryaudit_hit(int point, int count)
+{
+  (void)point;
+  (void)count;
+}
+
+void
+recoveryaudit_replay(int seen, int installed)
+{
+  printk("RECOVERY REPLAY abi=1 seen_n=%d installed=%d cleared=1 left=%d right=%d\n",
+         seen, installed, RC_HOME0, RC_HOME1);
+}
