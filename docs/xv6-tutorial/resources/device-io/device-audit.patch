diff --git a/kernel/devaudit.c b/kernel/devaudit.c
new file mode 100644
index 0000000000000000000000000000000000000000..79dfb941056688085f60b9be399d8edff859d558
--- /dev/null
+++ b/kernel/devaudit.c
@@ -0,0 +1,472 @@
+#include "types.h"
+#include "param.h"
+#include "spinlock.h"
+#include "sleeplock.h"
+#include "riscv.h"
+#include "memlayout.h"
+#include "defs.h"
+#include "fs.h"
+#include "buf.h"
+#include "virtio.h"
+#include "proc.h"
+#include "devaudit.h"
+
+struct {
+  struct spinlock lock;
+  struct devsnapshot s;
+} devaudit;
+
+void virtio_disk_audit_ledger(int *, int *, int *, uint16 *, uint16 *,
+                              uint64 *, uint64 *, uint64 *, int *);
+int virtio_disk_audit_release(void);
+int bioauditrefs(void);
+
+static uint64
+next_locked(void)
+{
+  devaudit.s.seq++;
+  return devaudit.s.seq;
+}
+
+static void
+held_locked(uint64 *field, int held)
+{
+  *field = held;
+  if (!held)
+    devaudit.s.lock_errors++;
+}
+
+static void
+fresh_locked(int mode, int generation)
+{
+  memset(&devaudit.s, 0, sizeof(devaudit.s));
+  devaudit.s.active = 1;
+  devaudit.s.mode = mode;
+  devaudit.s.generation = generation;
+}
+
+static void
+ledger(struct devsnapshot *out)
+{
+  int free_desc;
+  int info;
+  int deferred;
+  int ready;
+  int buf_refs;
+  uint16 avail;
+  uint16 used;
+  uint64 desc;
+  uint64 avail_addr;
+  uint64 used_addr;
+
+  virtio_disk_audit_ledger(&free_desc, &info, &deferred, &avail, &used,
+                           &desc, &avail_addr, &used_addr, &ready);
+  buf_refs = bioauditrefs();
+  acquire(&devaudit.lock);
+  devaudit.s.free_desc = free_desc;
+  devaudit.s.info_active = info;
+  devaudit.s.deferred = deferred;
+  devaudit.s.queue_desc = desc;
+  devaudit.s.queue_avail = avail_addr;
+  devaudit.s.queue_used = used_addr;
+  devaudit.s.queue_ready = ready;
+  devaudit.s.buf_refs = buf_refs;
+  devaudit.s.avail_after = avail;
+  devaudit.s.used_after = used;
+  if (devaudit.s.mode == DEV_MODE_QUEUE && devaudit.s.reclaims == 3) {
+    devaudit.s.free_after = free_desc;
+    devaudit.s.info_after = info;
+    devaudit.s.deferred_after = deferred;
+    devaudit.s.avail_after = avail;
+    devaudit.s.used_after = used;
+  }
+  *out = devaudit.s;
+  release(&devaudit.lock);
+}
+
+void
+devauditinit(void)
+{
+  initlock(&devaudit.lock, "devaudit");
+  memset(&devaudit.s, 0, sizeof(devaudit.s));
+}
+
+int
+devaudit_command(int op, int arg, struct devsnapshot *out)
+{
+  struct buf *b;
+  int result = 0;
+
+  if (op == DEV_ARM_CONSOLE) {
+    acquire(&devaudit.lock);
+    fresh_locked(DEV_MODE_CONSOLE, 1);
+    devaudit.s.pid = myproc()->pid;
+    release(&devaudit.lock);
+  } else if (op == DEV_DISK_READ) {
+    struct devsnapshot before;
+    ledger(&before);
+    acquire(&devaudit.lock);
+    fresh_locked(DEV_MODE_DISK, 2);
+    devaudit.s.pid = myproc()->pid;
+    devaudit.s.free_before = before.free_desc;
+    devaudit.s.avail_before = before.avail_after;
+    devaudit.s.used_before = before.used_after;
+    devaudit.s.queue_desc = before.queue_desc;
+    devaudit.s.queue_avail = before.queue_avail;
+    devaudit.s.queue_used = before.queue_used;
+    devaudit.s.queue_ready = before.queue_ready;
+    release(&devaudit.lock);
+    b = bread(ROOTDEV, arg);
+    result = b->data[0];
+    brelse(b);
+    acquire(&devaudit.lock);
+    devaudit.s.read_value = result;
+    release(&devaudit.lock);
+  } else if (op == DEV_ARM_QUEUE) {
+    struct devsnapshot before;
+    ledger(&before);
+    acquire(&devaudit.lock);
+    fresh_locked(DEV_MODE_QUEUE, 3);
+    devaudit.s.free_before = before.free_desc;
+    devaudit.s.avail_before = before.avail_after;
+    devaudit.s.used_before = before.used_after;
+    release(&devaudit.lock);
+  } else if (op == DEV_QUEUE_READ) {
+    int slot = (arg >> 16) & 0xff;
+    int block = arg & 0xffff;
+    if (slot < 0 || slot >= 3)
+      return -1;
+    acquire(&devaudit.lock);
+    if (!devaudit.s.active || devaudit.s.mode != DEV_MODE_QUEUE) {
+      release(&devaudit.lock);
+      return -1;
+    }
+    devaudit.s.pids[slot] = myproc()->pid;
+    devaudit.s.blocks[slot] = block;
+    release(&devaudit.lock);
+    b = bread(ROOTDEV, block);
+    result = b->data[0];
+    brelse(b);
+  } else if (op == DEV_RELEASE) {
+    acquire(&devaudit.lock);
+    if (!devaudit.s.active) {
+      release(&devaudit.lock);
+      return -1;
+    }
+    devaudit.s.controller_hart = cpuid();
+    devaudit.s.release_seq = next_locked();
+    release(&devaudit.lock);
+    result = virtio_disk_audit_release();
+  } else if (op == DEV_RESET) {
+    acquire(&devaudit.lock);
+    devaudit.s.active = 0;
+    devaudit.s.mode = DEV_MODE_NONE;
+    devaudit.s.waiters = 0;
+    release(&devaudit.lock);
+  } else if (op != DEV_SNAPSHOT) {
+    return -1;
+  }
+
+  ledger(out);
+  return result;
+}
+
+void
+devaudit_sleep(int pid, void *chan, int state, int condition_before,
+               int proc_after, int condition_after)
+{
+  acquire(&devaudit.lock);
+  if (!devaudit.s.active) {
+    release(&devaudit.lock);
+    return;
+  }
+  if ((devaudit.s.mode == DEV_MODE_CONSOLE ||
+       devaudit.s.mode == DEV_MODE_DISK) &&
+      devaudit.s.pid == pid && devaudit.s.wait_seq == 0) {
+    devaudit.s.wait_state = state;
+    devaudit.s.wait_chan = (uint64)chan;
+    devaudit.s.wait_seq = next_locked();
+    devaudit.s.sleep_seq = devaudit.s.wait_seq;
+    devaudit.s.waiters = 1;
+    devaudit.s.condition_before = condition_before;
+    devaudit.s.proc_after = proc_after;
+    devaudit.s.condition_after = condition_after;
+    if (condition_before != 1 || proc_after != 1 || condition_after != 0)
+      devaudit.s.lock_errors++;
+  } else if (devaudit.s.mode == DEV_MODE_QUEUE &&
+             devaudit.s.third_pid == pid &&
+             devaudit.s.desc_chan == (uint64)chan &&
+             devaudit.s.wait_seq == 0) {
+    devaudit.s.third_state = state;
+    devaudit.s.third_chan = (uint64)chan;
+    devaudit.s.wait_seq = next_locked();
+    devaudit.s.waiters = 1;
+    devaudit.s.condition_before = condition_before;
+    devaudit.s.proc_after = proc_after;
+    devaudit.s.condition_after = condition_after;
+    if (condition_before != 1 || proc_after != 1 || condition_after != 0)
+      devaudit.s.lock_errors++;
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_wakeup(int pid, void *chan, int proc_lock)
+{
+  acquire(&devaudit.lock);
+  if (!devaudit.s.active) {
+    release(&devaudit.lock);
+    return;
+  }
+  if ((devaudit.s.mode == DEV_MODE_CONSOLE ||
+       devaudit.s.mode == DEV_MODE_DISK) &&
+      devaudit.s.pid == pid && devaudit.s.wait_chan == (uint64)chan &&
+      devaudit.s.wake_seq == 0) {
+    devaudit.s.wake_chan = (uint64)chan;
+    devaudit.s.wake_seq = next_locked();
+    devaudit.s.waiters = 0;
+    held_locked(&devaudit.s.wake_proc_lock, proc_lock);
+  } else if (devaudit.s.mode == DEV_MODE_QUEUE &&
+             devaudit.s.third_pid == pid &&
+             devaudit.s.desc_chan == (uint64)chan) {
+    devaudit.s.waiters = 0;
+    held_locked(&devaudit.s.wake_proc_lock, proc_lock);
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_plic_claim(int irq, int hart)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_CONSOLE && irq == UART0_IRQ) {
+    devaudit.s.uart_claims++;
+    devaudit.s.uart_claim_harts |= 1 << hart;
+  } else if (devaudit.s.active &&
+             (devaudit.s.mode == DEV_MODE_DISK ||
+              devaudit.s.mode == DEV_MODE_QUEUE) && irq == VIRTIO0_IRQ) {
+    devaudit.s.virtio_claims++;
+    devaudit.s.virtio_claim_harts |= 1 << hart;
+    if (devaudit.s.mode == DEV_MODE_DISK && devaudit.s.irq_seq == 0)
+      devaudit.s.irq_seq = next_locked();
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_plic_complete(int irq, int hart)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_CONSOLE && irq == UART0_IRQ) {
+    devaudit.s.uart_completes++;
+    devaudit.s.uart_complete_harts |= 1 << hart;
+  } else if (devaudit.s.active &&
+             (devaudit.s.mode == DEV_MODE_DISK ||
+              devaudit.s.mode == DEV_MODE_QUEUE) && irq == VIRTIO0_IRQ) {
+    devaudit.s.virtio_completes++;
+    devaudit.s.virtio_complete_harts |= 1 << hart;
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_uart_rx(int c)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_CONSOLE) {
+    if (devaudit.s.rx_count == 0) {
+      devaudit.s.rx_first = c;
+      devaudit.s.rx_seq = next_locked();
+    }
+    devaudit.s.rx_last = c;
+    devaudit.s.rx_count++;
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_console_char(int c, uint64 before, uint64 after, int lock_held)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_CONSOLE) {
+    held_locked(&devaudit.s.publish_lock, lock_held);
+    if (devaudit.s.ring_before == 0 && devaudit.s.rx_count == 1)
+      devaudit.s.ring_before = before;
+    if (c == '\n')
+      devaudit.s.ring_after = after;
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_console_done(int pid, int n)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_CONSOLE &&
+      devaudit.s.pid == pid) {
+    devaudit.s.read_len = n;
+    devaudit.s.done_seq = next_locked();
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_desc_wait(int pid, void *chan, int free)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_QUEUE &&
+      devaudit.s.third_pid == 0) {
+    devaudit.s.third_pid = pid;
+    devaudit.s.desc_chan = (uint64)chan;
+    devaudit.s.free_held = free;
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_disk_begin(int pid, uint block, uint64 sector, int hart,
+                    uint64 desc, uint64 avail, uint64 used, int free,
+                    uint16 avail_idx, uint16 used_idx)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_DISK &&
+      devaudit.s.pid == pid) {
+    devaudit.s.block = block;
+    devaudit.s.sector = sector;
+    devaudit.s.submit_hart = hart;
+    devaudit.s.queue_desc = desc;
+    devaudit.s.queue_avail = avail;
+    devaudit.s.queue_used = used;
+    devaudit.s.free_before = free;
+    devaudit.s.avail_before = avail_idx;
+    devaudit.s.used_before = used_idx;
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_disk_program(int pid, int *idx, struct virtq_desc *desc,
+                      struct buf *b, int free, int lock_held)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active &&
+      (devaudit.s.mode == DEV_MODE_DISK || devaudit.s.mode == DEV_MODE_QUEUE))
+    held_locked(&devaudit.s.program_lock, lock_held);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_DISK &&
+      devaudit.s.pid == pid) {
+    devaudit.s.head = idx[0];
+    devaudit.s.d0 = idx[0];
+    devaudit.s.d1 = idx[1];
+    devaudit.s.d2 = idx[2];
+    devaudit.s.d0_addr = desc[idx[0]].addr;
+    devaudit.s.d0_len = desc[idx[0]].len;
+    devaudit.s.d0_flags = desc[idx[0]].flags;
+    devaudit.s.d0_next = desc[idx[0]].next;
+    devaudit.s.d1_addr = desc[idx[1]].addr;
+    devaudit.s.d1_len = desc[idx[1]].len;
+    devaudit.s.d1_flags = desc[idx[1]].flags;
+    devaudit.s.d1_next = desc[idx[1]].next;
+    devaudit.s.d2_addr = desc[idx[2]].addr;
+    devaudit.s.d2_len = desc[idx[2]].len;
+    devaudit.s.d2_flags = desc[idx[2]].flags;
+    devaudit.s.free_programmed = free;
+    devaudit.s.b_owner = b->disk;
+    devaudit.s.program_seq = next_locked();
+  } else if (devaudit.s.active && devaudit.s.mode == DEV_MODE_QUEUE) {
+    if (devaudit.s.submit0_seq == 0)
+      devaudit.s.submit0_seq = next_locked();
+    else if (devaudit.s.submit1_seq == 0)
+      devaudit.s.submit1_seq = next_locked();
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_disk_publish(uint16 avail, int lock_held)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active &&
+      (devaudit.s.mode == DEV_MODE_DISK || devaudit.s.mode == DEV_MODE_QUEUE))
+    held_locked(&devaudit.s.publish_lock, lock_held);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_DISK) {
+    devaudit.s.avail_after = avail;
+    devaudit.s.publish_seq = next_locked();
+  }
+  release(&devaudit.lock);
+}
+
+void
+devaudit_disk_notify(int lock_held)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active &&
+      (devaudit.s.mode == DEV_MODE_DISK || devaudit.s.mode == DEV_MODE_QUEUE))
+    held_locked(&devaudit.s.notify_lock, lock_held);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_DISK) {
+    devaudit.s.notify = 1;
+    devaudit.s.notify_seq = next_locked();
+  }
+  release(&devaudit.lock);
+}
+
+int
+devaudit_disk_complete(int id, struct buf *b, int status,
+                       uint16 used_before, uint16 used_after, int lock_held)
+{
+  int defer = 0;
+  (void)id;
+  (void)b;
+  acquire(&devaudit.lock);
+  if (devaudit.s.active &&
+      (devaudit.s.mode == DEV_MODE_DISK || devaudit.s.mode == DEV_MODE_QUEUE))
+    held_locked(&devaudit.s.complete_lock, lock_held);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_DISK &&
+      devaudit.s.deferred_held == 0) {
+    devaudit.s.device_status = status;
+    devaudit.s.used_before = used_before;
+    devaudit.s.used_after = used_after;
+    devaudit.s.complete_seq = next_locked();
+    devaudit.s.deferred_held = 1;
+    defer = 1;
+  } else if (devaudit.s.active && devaudit.s.mode == DEV_MODE_QUEUE &&
+             devaudit.s.deferred_held < 2) {
+    if (devaudit.s.deferred_held == 0)
+      devaudit.s.defer0_seq = next_locked();
+    else
+      devaudit.s.defer1_seq = next_locked();
+    devaudit.s.deferred_held++;
+    defer = 1;
+  }
+  release(&devaudit.lock);
+  return defer;
+}
+
+void
+devaudit_disk_reclaim(int pid, int free, int info, uint16 avail, uint16 used,
+                      int lock_held)
+{
+  acquire(&devaudit.lock);
+  if (devaudit.s.active &&
+      (devaudit.s.mode == DEV_MODE_DISK || devaudit.s.mode == DEV_MODE_QUEUE))
+    held_locked(&devaudit.s.reclaim_lock, lock_held);
+  if (devaudit.s.active && devaudit.s.mode == DEV_MODE_DISK &&
+      devaudit.s.pid == pid) {
+    devaudit.s.free_after = free;
+    devaudit.s.info_after = info;
+    devaudit.s.avail_after = avail;
+    devaudit.s.used_after = used;
+    devaudit.s.reclaim_seq = next_locked();
+    devaudit.s.deferred_after = 0;
+  } else if (devaudit.s.active && devaudit.s.mode == DEV_MODE_QUEUE) {
+    devaudit.s.reclaims++;
+    if (devaudit.s.reclaims == 3) {
+      devaudit.s.free_after = free;
+      devaudit.s.info_after = info;
+      devaudit.s.avail_after = avail;
+      devaudit.s.used_after = used;
+      devaudit.s.reclaim_seq = next_locked();
+      devaudit.s.deferred_after = 0;
+    }
+  }
+  release(&devaudit.lock);
+}
diff --git a/kernel/devaudit.h b/kernel/devaudit.h
new file mode 100644
index 0000000000000000000000000000000000000000..a1aec36643145582a4c0bf55e7be0a3868265e40
--- /dev/null
+++ b/kernel/devaudit.h
@@ -0,0 +1,139 @@
+#define DEV_SNAPSHOT      1
+#define DEV_ARM_CONSOLE   2
+#define DEV_DISK_READ     3
+#define DEV_ARM_QUEUE     4
+#define DEV_QUEUE_READ    5
+#define DEV_RELEASE       6
+#define DEV_RESET         7
+
+#define DEV_MODE_NONE     0
+#define DEV_MODE_CONSOLE  1
+#define DEV_MODE_DISK     2
+#define DEV_MODE_QUEUE    3
+
+struct buf;
+struct virtq_desc;
+
+struct devsnapshot {
+  uint64 active;
+  uint64 mode;
+  uint64 generation;
+  uint64 seq;
+
+  uint64 pid;
+  uint64 wait_state;
+  uint64 wait_chan;
+  uint64 wait_seq;
+  uint64 wake_chan;
+  uint64 wake_seq;
+  uint64 waiters;
+  uint64 condition_before;
+  uint64 proc_after;
+  uint64 condition_after;
+  uint64 wake_proc_lock;
+  uint64 publish_lock;
+  uint64 program_lock;
+  uint64 notify_lock;
+  uint64 complete_lock;
+  uint64 reclaim_lock;
+  uint64 lock_errors;
+
+  uint64 uart_claims;
+  uint64 uart_completes;
+  uint64 uart_claim_harts;
+  uint64 uart_complete_harts;
