diff --git a/kernel/bio.c b/kernel/bio.c
index de8603923839467477500181fb2040a6d20c152e..e6ad843e8afa4e8fddef743221d930ab9e379317 100644
--- a/kernel/bio.c
+++ b/kernel/bio.c
@@ -150,3 +150,15 @@ bunpin(struct buf *b)
   b->refcnt--;
   release(&bcache.lock);
 }
+
+int
+bioauditrefs(void)
+{
+  int refs = 0;
+
+  acquire(&bcache.lock);
+  for (struct buf *b = bcache.buf; b < bcache.buf + NBUF; b++)
+    refs += b->refcnt;
+  release(&bcache.lock);
+  return refs;
+}
