+int
+virtio_disk_audit_release(void)
+{
+  int released = 0;
+
+  acquire(&disk.vdisk_lock);
+  for (int i = 0; i < 2; i++) {
+    struct buf *b = disk.deferred[i];
+    if (b != 0) {
+      disk.deferred[i] = 0;
+      b->disk = 0;
+      wakeup(b);
+      released++;
+    }
+  }
+  release(&disk.vdisk_lock);
+  return released;
