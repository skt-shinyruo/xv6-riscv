+void
+virtio_disk_audit_ledger(int *free, int *info, int *deferred,
+                         uint16 *avail, uint16 *used, uint64 *desc_addr,
+                         uint64 *avail_addr, uint64 *used_addr, int *ready)
+{
+  acquire(&disk.vdisk_lock);
+  *free = free_count();
+  *info = info_count();
+  *deferred = 0;
+  for (int i = 0; i < 2; i++)
+    if (disk.deferred[i] != 0)
+      (*deferred)++;
+  *avail = disk.avail->idx;
+  *used = disk.used_idx;
+  *desc_addr = (uint64)disk.desc;
+  *avail_addr = (uint64)disk.avail;
+  *used_addr = (uint64)disk.used;
+  *ready = *R(VIRTIO_MMIO_QUEUE_READY);
+  release(&disk.vdisk_lock);
+}
diff --git a/user/devtrace.c b/user/devtrace.c
new file mode 100644
index 0000000000000000000000000000000000000000..144265f2596a295b7318fc3fbd6d84f73f6f7719
--- /dev/null
+++ b/user/devtrace.c
@@ -0,0 +1,237 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/devaudit.h"
+#include "user/user.h"
+
+static void
+fail(char *message)
+{
+  printf("DEV FAIL %s\n", message);
+  exit(1);
+}
+
+static void
+snap(struct devsnapshot *s)
+{
+  if (devprobe(DEV_SNAPSHOT, 0, s) < 0)
+    fail("snapshot");
+}
+
+static void
+after(char *phase)
+{
+  static struct devsnapshot s;
+  if (devprobe(DEV_RESET, 0, &s) < 0)
+    fail("reset");
+  printf("DEV AFTER phase=%s active=%ld waiters=%ld deferred=%ld "
+         "free_desc=%ld info=%ld buf_refs=%ld\n",
+         phase, s.active, s.waiters, s.deferred, s.free_desc, s.info_active,
+         s.buf_refs);
+}
+
+static int
+wait_for(int mode, int queue)
+{
+  static struct devsnapshot s;
+  for (int i = 0; i < 300; i++) {
+    snap(&s);
+    if (s.active && s.mode == mode) {
+      if (!queue && s.wait_seq != 0 && s.deferred_held == 1)
+        return 0;
+      if (queue && s.deferred_held == 2 && s.wait_seq != 0 &&
+          s.free_held == 2)
+        return 0;
+    }
+    pause(1);
+  }
+  return -1;
+}
+
+static void
+console_case(void)
+{
+  int pid = fork();
+  if (pid < 0)
+    fail("console fork");
+  if (pid == 0) {
+    static struct devsnapshot s;
+    char input[16];
+    char expected[] = "D14-input\n";
+    if (devprobe(DEV_ARM_CONSOLE, 0, &s) < 0)
+      exit(1);
+    int n = read(0, input, sizeof(input));
+    if (n != 10 || memcmp(input, expected, 10) != 0)
+      exit(1);
+    exit(0);
+  }
+
+  static struct devsnapshot s;
+  for (int i = 0; i < 300; i++) {
+    snap(&s);
+    if (s.active && s.mode == DEV_MODE_CONSOLE && s.pid == pid &&
+        s.wait_seq != 0 && s.wait_state == 2)
+      break;
+    if (i == 299)
+      fail("console wait");
+    pause(1);
+  }
+  printf("DEV CONSOLE_WAIT generation=%ld pid=%ld state=%ld chan=%ld seq=%ld\n",
+         s.generation, s.pid, s.wait_state, s.wait_chan, s.wait_seq);
+
+  int status = -1;
+  if (wait(&status) != pid)
+    fail("console wait pid");
+  pause(2);
+  snap(&s);
+  printf("DEV CONSOLE generation=%ld pid=%ld irq=10 wait_seq=%ld rx_seq=%ld "
+         "wake_seq=%ld done_seq=%ld claims=%ld completes=%ld claim_harts=%ld "
+         "complete_harts=%ld wait_chan=%ld wake_chan=%ld rx=%ld first=%ld "
+         "last=%ld read=%ld ring_before=%ld ring_after=%ld publish_lock=%ld "
+         "condition_before=%ld proc_after=%ld condition_after=%ld "
+         "wake_proc_lock=%ld lock_errors=%ld status=%d cleanup=1\n",
+         s.generation, s.pid, s.wait_seq, s.rx_seq, s.wake_seq, s.done_seq,
+         s.uart_claims, s.uart_completes, s.uart_claim_harts,
+         s.uart_complete_harts, s.wait_chan, s.wake_chan, s.rx_count,
+         s.rx_first, s.rx_last, s.read_len, s.ring_before, s.ring_after,
+         s.publish_lock, s.condition_before, s.proc_after, s.condition_after,
+         s.wake_proc_lock, s.lock_errors, status);
+  after("CONSOLE");
+  if (status != 0)
+    fail("console status");
+}
+
+static void
+disk_case(void)
+{
+  int pid = fork();
+  if (pid < 0)
+    fail("disk fork");
+  if (pid == 0) {
+    static struct devsnapshot s;
+    int value = devprobe(DEV_DISK_READ, 1999, &s);
+    exit(value < 0);
+  }
+  if (wait_for(DEV_MODE_DISK, 0) < 0)
+    fail("disk gate");
+  static struct devsnapshot s;
+  if (devprobe(DEV_RELEASE, 0, &s) != 1)
+    fail("disk release");
+  int status = -1;
+  if (wait(&status) != pid)
+    fail("disk wait pid");
+  snap(&s);
+  printf("DEV DISK generation=%ld pid=%ld block=%ld sector=%ld submit_hart=%ld "
+         "head=%ld d0=%ld d1=%ld d2=%ld d0_addr=%ld d0_len=%ld "
+         "d0_flags=%ld d0_next=%ld d1_addr=%ld d1_len=%ld d1_flags=%ld "
+         "d1_next=%ld d2_addr=%ld d2_len=%ld d2_flags=%ld queue_desc=%ld "
+         "queue_avail=%ld queue_used=%ld queue_ready=%ld free_before=%ld "
+         "free_programmed=%ld free_after=%ld avail_before=%ld avail_after=%ld "
+         "used_before=%ld used_after=%ld notify=%ld b_owner=%ld device_status=%ld "
+         "wait_chan=%ld wake_chan=%ld program_seq=%ld publish_seq=%ld "
+         "notify_seq=%ld sleep_seq=%ld irq_seq=%ld complete_seq=%ld "
+         "wake_seq=%ld reclaim_seq=%ld irq=1 claims=%ld completes=%ld "
+         "claim_harts=%ld complete_harts=%ld info_after=%ld read=%ld "
+         "program_lock=%ld publish_lock=%ld notify_lock=%ld complete_lock=%ld "
+         "reclaim_lock=%ld condition_before=%ld proc_after=%ld "
+         "condition_after=%ld wake_proc_lock=%ld lock_errors=%ld "
+         "status=%d cleanup=1\n",
+         s.generation, s.pid, s.block, s.sector, s.submit_hart, s.head,
+         s.d0, s.d1, s.d2, s.d0_addr, s.d0_len, s.d0_flags, s.d0_next,
+         s.d1_addr, s.d1_len, s.d1_flags, s.d1_next, s.d2_addr, s.d2_len,
+         s.d2_flags, s.queue_desc, s.queue_avail, s.queue_used, s.queue_ready,
+         s.free_before, s.free_programmed, s.free_after, s.avail_before,
+         s.avail_after, s.used_before, s.used_after, s.notify, s.b_owner,
+         s.device_status, s.wait_chan, s.wake_chan, s.program_seq,
+         s.publish_seq, s.notify_seq, s.sleep_seq, s.irq_seq, s.complete_seq,
+         s.wake_seq, s.reclaim_seq, s.virtio_claims, s.virtio_completes,
+         s.virtio_claim_harts, s.virtio_complete_harts, s.info_after,
+         s.read_value, s.program_lock, s.publish_lock, s.notify_lock,
+         s.complete_lock, s.reclaim_lock, s.condition_before, s.proc_after,
+         s.condition_after, s.wake_proc_lock, s.lock_errors, status);
+  after("DISK");
+  if (status != 0)
+    fail("disk status");
+}
+
+static void
+queue_case(void)
+{
+  static struct devsnapshot s;
+  if (devprobe(DEV_ARM_QUEUE, 0, &s) < 0)
+    fail("queue arm");
+  int expected[3];
+  for (int i = 0; i < 3; i++) {
+    int pid = fork();
+    if (pid < 0)
+      fail("queue fork");
+    if (pid == 0) {
+      static struct devsnapshot child;
+      int packed = (i << 16) | (1996 + i);
+      exit(devprobe(DEV_QUEUE_READ, packed, &child) < 0);
+    }
+    expected[i] = pid;
+  }
+  if (wait_for(DEV_MODE_QUEUE, 1) < 0)
+    fail("queue boundary");
+  static struct devsnapshot held;
+  snap(&held);
+  if (devprobe(DEV_RELEASE, 0, &s) != 2)
+    fail("queue release");
+  int statuses[3] = {-1, -1, -1};
+  for (int i = 0; i < 3; i++) {
+    int status = -1;
+    int pid = wait(&status);
+    if (pid < 0)
+      fail("queue wait");
+    for (int j = 0; j < 3; j++)
+      if (expected[j] == pid)
+        statuses[j] = status;
+  }
+  snap(&s);
+  printf("DEV QUEUE generation=%ld p0=%ld p1=%ld p2=%ld block0=%ld "
+         "block1=%ld block2=%ld free_before=%ld free_held=%ld free_after=%ld "
+         "deferred_held=%ld deferred_after=%ld third_pid=%ld third_state=%ld "
+         "third_chan=%ld desc_chan=%ld avail_before=%ld avail_after=%ld "
+         "used_before=%ld used_after=%ld submit0_seq=%ld submit1_seq=%ld "
+         "defer0_seq=%ld defer1_seq=%ld wait_seq=%ld release_seq=%ld "
+         "reclaim_seq=%ld irq=1 claims=%ld completes=%ld claim_harts=%ld "
+         "complete_harts=%ld controller_hart=%ld status0=%d status1=%d "
+         "status2=%d info_after=%ld program_lock=%ld publish_lock=%ld "
+         "notify_lock=%ld complete_lock=%ld reclaim_lock=%ld "
+         "condition_before=%ld proc_after=%ld condition_after=%ld "
+         "wake_proc_lock=%ld lock_errors=%ld cleanup=1\n",
+         s.generation, s.pids[0], s.pids[1], s.pids[2], s.blocks[0],
+         s.blocks[1], s.blocks[2], s.free_before, held.free_held, s.free_after,
+         held.deferred_held, s.deferred_after, held.third_pid, held.third_state,
+         held.third_chan, held.desc_chan, s.avail_before, s.avail_after,
+         s.used_before, s.used_after, s.submit0_seq, s.submit1_seq,
+         held.defer0_seq, held.defer1_seq, held.wait_seq, s.release_seq,
+         s.reclaim_seq, s.virtio_claims, s.virtio_completes,
+         s.virtio_claim_harts, s.virtio_complete_harts, s.controller_hart,
+         statuses[0], statuses[1], statuses[2], s.info_after, s.program_lock,
+         s.publish_lock, s.notify_lock, s.complete_lock, s.reclaim_lock,
+         s.condition_before, s.proc_after, s.condition_after, s.wake_proc_lock,
+         s.lock_errors);
+  after("QUEUE");
+  if (statuses[0] != 0 || statuses[1] != 0 || statuses[2] != 0)
+    fail("queue status");
+  printf("DEV PASS cases=3 cleanup=1\n");
+}
+
+int
+main(int argc, char **argv)
+{
+  if (argc != 2) {
+    fprintf(2, "usage: devtrace console|disk|queue\n");
+    exit(1);
+  }
+  if (strcmp(argv[1], "console") == 0)
+    console_case();
+  else if (strcmp(argv[1], "disk") == 0)
+    disk_case();
+  else if (strcmp(argv[1], "queue") == 0)
+    queue_case();
+  else
+    fail("mode");
+  exit(0);
+}
