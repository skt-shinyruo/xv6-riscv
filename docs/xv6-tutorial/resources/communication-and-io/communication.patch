 struct {
@@ -25,6 +26,31 @@ fileinit(void)
   initlock(&ftable.lock, "ftable");
 }
 
+void
+fileaudit(struct io_snapshot *snapshot)
+{
+  struct pipe *pipes[NFILE];
+  int npipes = 0;
+
+  acquire(&ftable.lock);
+  for (struct file *f = ftable.file; f < ftable.file + NFILE; f++) {
+    if (f->ref == 0)
+      continue;
+    snapshot->active_files++;
+    snapshot->file_refs += f->ref;
+    if (f->type == FD_PIPE) {
+      int seen = 0;
+      for (int i = 0; i < npipes; i++)
+        if (pipes[i] == f->pipe)
+          seen = 1;
+      if (!seen)
+        pipes[npipes++] = f->pipe;
+    }
+  }
+  snapshot->active_pipes = npipes;
+  release(&ftable.lock);
+}
+
 // Allocate a file structure.
 struct file *
 filealloc(void)
diff --git a/kernel/ioaudit.h b/kernel/ioaudit.h
new file mode 100644
index 0000000..d84f0fc
--- /dev/null
+++ b/kernel/ioaudit.h
@@ -0,0 +1,28 @@
+#ifndef IOAUDIT_H
+#define IOAUDIT_H
+
+#include "types.h"
+
+#define IO_CHAN_NONE 0
+#define IO_CHAN_READ 1
+#define IO_CHAN_WRITE 2
+#define IO_CHAN_OTHER 3
+#define IO_STATE_UNUSED 0
+#define IO_STATE_SLEEPING 2
+
+struct io_snapshot {
+  int fd_slots;
+  int active_files;
+  int file_refs;
+  int active_pipes;
+  int used_procs;
+  int free_pages;
+  int target_pid;
+  int target_state;
+  int target_chan;
+  int occupancy;
+  int readopen;
+  int writeopen;
+};
+
+#endif
