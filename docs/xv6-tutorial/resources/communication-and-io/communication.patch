+
+uint64
+sys_iosnapshot(void)
+{
+  int fd, pid;
+  uint64 addr;
+  struct proc *p = myproc();
+  struct io_snapshot snapshot;
+
+  memset(&snapshot, 0, sizeof(snapshot));
+  argint(0, &fd);
+  argint(1, &pid);
+  argaddr(2, &addr);
+  for (int i = 0; i < NOFILE; i++)
+    if (p->ofile[i] != 0)
+      snapshot.fd_slots++;
+  fileaudit(&snapshot);
+  snapshot.free_pages = freepagecount();
+  if (fd >= 0) {
+    if (fd >= NOFILE || p->ofile[fd] == 0 || p->ofile[fd]->type != FD_PIPE)
+      return -1;
+    pipeaudit(p->ofile[fd]->pipe, pid, &snapshot);
+  } else {
+    procaudit(pid, 0, 0, &snapshot);
+  }
+  if (copyout(p->pagetable, addr, (char *)&snapshot, sizeof(snapshot)) < 0)
+    return -1;
+  return 0;
+}
diff --git a/user/ioflow.c b/user/ioflow.c
new file mode 100644
index 0000000..806ef42
--- /dev/null
+++ b/user/ioflow.c
@@ -0,0 +1,384 @@
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "kernel/fcntl.h"
+#include "kernel/ioaudit.h"
+#include "user/user.h"
+
+static void
+fail(char *what)
+{
+  printf("IO FAIL %s\n", what);
+  exit(1);
+}
+
+static struct io_snapshot
+snapshot(int fd, int pid)
+{
+  struct io_snapshot value;
+  if (iosnapshot(fd, pid, &value) < 0)
+    fail("snapshot");
+  return value;
+}
+
+static void
+same_ledger(struct io_snapshot before, struct io_snapshot after)
+{
+  if (before.fd_slots != after.fd_slots ||
+      before.active_files != after.active_files ||
+      before.file_refs != after.file_refs ||
+      before.active_pipes != after.active_pipes ||
+      before.used_procs != after.used_procs ||
+      before.free_pages != after.free_pages)
+    fail("ledger");
+}
+
+static void
+print_after(char *phase, struct io_snapshot value)
+{
+  printf("IO AFTER phase=%s fd=%d files=%d refs=%d pipes=%d procs=%d free=%d\n",
+         phase, value.fd_slots, value.active_files, value.file_refs,
+         value.active_pipes, value.used_procs, value.free_pages);
+}
+
+static void
+wait_status(int pid, int expected)
+{
+  int status = 0x7fffffff;
+  int got = wait(&status);
+  if (got != pid || status != expected)
+    fail("wait-status");
+}
+
+static void
+read_all(int fd, char *buf, int n)
+{
+  int got = 0;
+  while (got < n) {
+    int r = read(fd, buf + got, n - got);
+    if (r <= 0)
+      fail("short-read");
+    got += r;
+  }
+}
+
+static struct io_snapshot
+wait_for_pipe(int fd, int pid, int chan, int occupancy)
+{
+  struct io_snapshot value;
+  for (int attempt = 0; attempt < 200; attempt++) {
+    value = snapshot(fd, pid);
+    if (value.target_state == IO_STATE_SLEEPING &&
+        value.target_chan == chan && value.occupancy == occupancy)
+      return value;
+    pause(1);
+  }
+  fail("not-blocked");
+  value = snapshot(fd, pid);
+  return value;
+}
+
+static void
+pipeline(struct io_snapshot base)
+{
+  int p[2], left, right, status, got1, got2, status1, status2;
+  char data[641], received[641];
+  int left_fd, right_fd;
+  struct io_snapshot after;
+
+  for (int i = 0; i < sizeof(data); i++)
+    data[i] = (char)(i % 251);
+  if (pipe(p) < 0 || (left = fork()) < 0)
+    fail("pipeline-setup");
+  if (left == 0) {
+    close(p[0]);
+    close(1);
+    left_fd = dup(p[1]);
+    if (left_fd != 1 || write(1, data, sizeof(data)) != sizeof(data))
+      exit(10);
+    close(p[1]);
+    close(1);
+    exit(0);
+  }
+  if ((right = fork()) < 0)
+    fail("pipeline-fork");
+  if (right == 0) {
+    close(p[1]);
+    close(0);
+    right_fd = dup(p[0]);
+    if (right_fd != 0)
+      exit(11);
+    close(p[0]);
+    read_all(0, received, sizeof(received));
+    if (memcmp(received, data, sizeof(data)) != 0 || read(0, received, 1) != 0)
+      exit(12);
+    close(0);
+    exit(0);
+  }
+  close(p[0]);
+  close(p[1]);
+  status = 0;
+  got1 = wait(&status1);
+  got2 = wait(&status2);
+  if (!((got1 == left && status1 == status && got2 == right && status2 == status) ||
+        (got1 == right && status1 == status && got2 == left && status2 == status)))
+    fail("pipeline-wait");
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("PIPELINE", after);
+  printf("IO PIPELINE left=%d right=%d left_fd=1 right_fd=0 bytes=641 eof=0 cleanup=1\n",
+         left, right);
+}
+
+static void
+empty_wakeup(struct io_snapshot base)
+{
+  int p[2], ready[2], child;
+  char byte;
+  struct io_snapshot observed, after;
+
+  if (pipe(p) < 0 || pipe(ready) < 0 || (child = fork()) < 0)
+    fail("empty-setup");
+  if (child == 0) {
+    close(p[1]);
+    close(ready[0]);
+    byte = 0;
+    if (write(ready[1], &byte, 1) != 1)
+      exit(20);
+    close(ready[1]);
+    if (read(p[0], &byte, 1) != 1 || byte != 'E')
+      exit(21);
+    close(p[0]);
+    exit(0);
+  }
+  close(p[0]);
+  close(ready[1]);
+  if (read(ready[0], &byte, 1) != 1)
+    fail("empty-ready");
+  close(ready[0]);
+  observed = wait_for_pipe(p[1], child, IO_CHAN_READ, 0);
+  if (observed.readopen != 1 || observed.writeopen != 1)
+    fail("empty-open");
+  if (write(p[1], "E", 1) != 1)
+    fail("empty-write");
+  close(p[1]);
+  wait_status(child, 0);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("EMPTY", after);
+  printf("IO EMPTY child=%d state=%d chan=%d occupancy=0 wake=1 cleanup=1\n",
+         child, observed.target_state, observed.target_chan);
+}
+
+static void
+full_wakeup(struct io_snapshot base)
+{
+  int p[2], child;
+  char buf[512], byte;
+  struct io_snapshot observed, after;
+
+  memset(buf, 'x', sizeof(buf));
+  if (pipe(p) < 0 || write(p[1], buf, sizeof(buf)) != sizeof(buf) ||
+      (child = fork()) < 0)
+    fail("full-setup");
+  if (child == 0) {
+    close(p[0]);
+    if (write(p[1], "y", 1) != 1)
+      exit(30);
+    close(p[1]);
+    exit(0);
+  }
+  close(p[1]);
+  observed = wait_for_pipe(p[0], child, IO_CHAN_WRITE, 512);
+  if (observed.readopen != 1 || observed.writeopen != 1)
+    fail("full-open");
+  read_all(p[0], buf, sizeof(buf));
+  for (int i = 0; i < sizeof(buf); i++)
+    if (buf[i] != 'x')
+      fail("full-prefix");
+  if (read(p[0], &byte, 1) != 1 || byte != 'y' || read(p[0], &byte, 1) != 0)
+    fail("full-order");
+  close(p[0]);
+  wait_status(child, 0);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("FULL", after);
+  printf("IO FULL child=%d state=%d chan=%d occupancy=512 wake=1 cleanup=1\n",
+         child, observed.target_state, observed.target_chan);
+}
+
+static void
+eof_case(struct io_snapshot base)
+{
+  int p[2];
+  char byte;
+  struct io_snapshot observed, after;
+
+  if (pipe(p) < 0)
+    fail("eof-setup");
+  close(p[1]);
+  observed = snapshot(p[0], 0);
+  if (observed.occupancy != 0 || observed.readopen != 1 || observed.writeopen != 0)
+    fail("eof-state");
+  if (read(p[0], &byte, 1) != 0)
+    fail("eof");
+  close(p[0]);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("EOF", after);
+  printf("IO EOF occupancy=0 read=0 cleanup=1\n");
+}
+
+static void
+broken_case(struct io_snapshot base)
+{
+  int p[2];
+  struct io_snapshot observed, after;
+
+  if (pipe(p) < 0)
+    fail("broken-setup");
+  close(p[0]);
+  observed = snapshot(p[1], 0);
+  if (observed.occupancy != 0 || observed.readopen != 0 || observed.writeopen != 1)
+    fail("broken-state");
+  if (write(p[1], "B", 1) != -1)
+    fail("broken");
+  close(p[1]);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("BROKEN", after);
+  printf("IO BROKEN occupancy=0 write=-1 cleanup=1\n");
+}
+
+static void
+killed_reader(struct io_snapshot base)
+{
+  int p[2], ready[2], child;
+  char byte;
+  struct io_snapshot observed, after;
+
+  if (pipe(p) < 0 || pipe(ready) < 0 || (child = fork()) < 0)
+    fail("kill-read-setup");
+  if (child == 0) {
+    close(p[1]);
+    close(ready[0]);
+    if (write(ready[1], "R", 1) != 1)
+      exit(40);
+    close(ready[1]);
+    read(p[0], &byte, 1);
+    exit(41);
+  }
+  close(p[0]);
+  close(ready[1]);
+  if (read(ready[0], &byte, 1) != 1)
+    fail("kill-read-ready");
+  close(ready[0]);
+  observed = wait_for_pipe(p[1], child, IO_CHAN_READ, 0);
+  if (kill(child) < 0)
+    fail("kill-read");
+  wait_status(child, -1);
+  close(p[1]);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("KILL_READ", after);
+  printf("IO KILL_READ child=%d state=%d chan=%d result=-1 cleanup=1\n",
+         child, observed.target_state, observed.target_chan);
+}
+
+static void
+killed_writer(struct io_snapshot base)
+{
+  int p[2], child;
+  char buf[512], byte;
+  struct io_snapshot observed, after;
+
+  memset(buf, 'w', sizeof(buf));
+  if (pipe(p) < 0 || write(p[1], buf, sizeof(buf)) != sizeof(buf) ||
+      (child = fork()) < 0)
+    fail("kill-write-setup");
+  if (child == 0) {
+    close(p[0]);
+    write(p[1], "W", 1);
+    exit(42);
+  }
+  close(p[1]);
+  observed = wait_for_pipe(p[0], child, IO_CHAN_WRITE, 512);
+  if (kill(child) < 0)
+    fail("kill-write");
+  wait_status(child, -1);
+  read_all(p[0], buf, sizeof(buf));
+  if (read(p[0], &byte, 1) != 0)
+    fail("kill-write-eof");
+  close(p[0]);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("KILL_WRITE", after);
+  printf("IO KILL_WRITE child=%d state=%d chan=%d committed=512 result=-1 cleanup=1\n",
+         child, observed.target_state, observed.target_chan);
+}
+
+static void
+fd_rollback(struct io_snapshot base)
+{
+  int fds[NOFILE], n = 0, p[2];
+  struct io_snapshot before, after;
+
+  while (snapshot(-1, 0).fd_slots < NOFILE) {
+    fds[n] = dup(0);
+    if (fds[n] < 0)
+      fail("fd-fill");
+    n++;
+  }
+  before = snapshot(-1, 0);
+  if (pipe(p) != -1)
+    fail("fd-rollback");
+  after = snapshot(-1, 0);
+  same_ledger(before, after);
+  for (int i = 0; i < n; i++)
+    close(fds[i]);
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("FD_ROLLBACK", after);
+  printf("IO FD_ROLLBACK filled=%d pipe=-1 cleanup=1\n", n);
+}
+
+static void
+device_case(struct io_snapshot base)
+{
+  int fd, n;
+  char buf[16];
+  struct io_snapshot after;
+
+  fd = open("README", O_RDONLY);
+  if (fd < 0)
+    fail("device-open");
+  n = read(fd, buf, sizeof(buf));
+  close(fd);
+  if (n != sizeof(buf) || memcmp(buf, "xv6 is a re-imple", 16) != 0)
+    fail("device-read");
+  after = snapshot(-1, 0);
+  same_ledger(base, after);
+  print_after("DEVICE", after);
+  printf("IO DEVICE read=16 cleanup=1\n");
+}
+
+int
+main(void)
+{
+  struct io_snapshot base = snapshot(-1, 0);
+  printf("IO BASE fd=%d files=%d refs=%d pipes=%d procs=%d free=%d\n",
+         base.fd_slots, base.active_files, base.file_refs, base.active_pipes,
+         base.used_procs, base.free_pages);
+  print_after("BASE", base);
+  pipeline(base);
+  empty_wakeup(base);
+  full_wakeup(base);
+  eof_case(base);
+  broken_case(base);
+  killed_reader(base);
+  killed_writer(base);
+  fd_rollback(base);
+  device_case(base);
+  print_after("PASS", snapshot(-1, 0));
+  printf("IO PASS cleanup=1\n");
+  exit(0);
+}
