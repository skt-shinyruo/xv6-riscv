 }
+
+int
+freepagecount(void)
+{
+  int count = 0;
+  struct run *r;
+
+  acquire(&kmem.lock);
+  for (r = kmem.freelist; r != 0; r = r->next)
+    count++;
+  release(&kmem.lock);
+  return count;
+}
