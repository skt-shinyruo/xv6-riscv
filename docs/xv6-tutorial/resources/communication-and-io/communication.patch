 #define PIPESIZE 512
 
@@ -132,3 +133,14 @@ piperead(struct pipe *pi, uint64 addr, int n)
   release(&pi->lock);
   return i;
 }
+
+void
+pipeaudit(struct pipe *pi, int pid, struct io_snapshot *snapshot)
+{
+  acquire(&pi->lock);
+  snapshot->occupancy = pi->nwrite - pi->nread;
+  snapshot->readopen = pi->readopen;
+  snapshot->writeopen = pi->writeopen;
+  release(&pi->lock);
+  procaudit(pid, &pi->nread, &pi->nwrite, snapshot);
+}
diff --git a/kernel/proc.c b/kernel/proc.c
index 611e94c..8ddf1ad 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -5,6 +5,7 @@
 #include "spinlock.h"
 #include "proc.h"
 #include "defs.h"
+#include "ioaudit.h"
 
 struct cpu cpus[NCPU];
 
@@ -690,3 +691,30 @@ procdump(void)
     printk("\n");
   }
 }
+
+void
+procaudit(int pid, void *read_chan, void *write_chan,
+          struct io_snapshot *snapshot)
+{
+  struct proc *p;
+
+  snapshot->used_procs = 0;
+  snapshot->target_pid = pid;
+  snapshot->target_state = UNUSED;
+  snapshot->target_chan = IO_CHAN_NONE;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED)
+      snapshot->used_procs++;
+    if (p->pid == pid) {
+      snapshot->target_state = p->state;
+      if (read_chan != 0 && p->chan == read_chan)
+        snapshot->target_chan = IO_CHAN_READ;
+      else if (write_chan != 0 && p->chan == write_chan)
+        snapshot->target_chan = IO_CHAN_WRITE;
+      else if (p->chan != 0)
+        snapshot->target_chan = IO_CHAN_OTHER;
+    }
+    release(&p->lock);
+  }
+}
