+static void
+case_fork_rollback(void)
+{
+  int ready[2], go[2], amount, holder, failed, setup, after_fork, growth;
+  int low_value, high_value, fast_value;
+  char *low;
+  uint64 top;
+  char *high = (char *)0x200000;
+  struct cowaudit_record record, fast;
+  struct cowaudit_snapshot low_before, low_after, high_after, low_fast;
+
+  low = alloc_pages(1, 0, &amount);
+  low[0] = 0x41;
+  must_pipe(ready);
+  must_pipe(go);
+  holder = fork();
+  if (holder < 0)
+    fail("rollback-holder");
+  if (holder == 0) {
+    put_byte(ready[1], 1);
+    get_byte(go[0]);
+    exit(low[0] == 0x41 ? 0 : 2);
+  }
+  get_byte(ready[0]);
+  top = (uint64)sbrk(0);
+  if (top >= (uint64)high)
+    fail("rollback-layout");
+  growth = (uint64)high + PGSIZE - top;
+  if (sbrklazy(growth) == SBRK_ERROR)
+    fail("rollback-grow");
+  high[0] = 0x52;
+  low_before = snapshot(getpid(), (uint64)low);
+  require_cow(&low_before, 2);
+  /* The high lazy mapping may leave empty intermediate tables until exit. */
+  setup = cowaudit(COWAUDIT_FREE, 0, 0);
+  arm_fail(7, 8);
+  failed = fork();
+  record = fetch_record();
+  if (failed != -1 || record.generation != 7 || record.fired != 1 ||
+      record.eligible != 8)
+    fail("rollback-trigger");
+  low_after = snapshot(getpid(), (uint64)low);
+  high_after = snapshot(getpid(), (uint64)high);
+  require_cow(&low_after, 2);
+  require_private(&high_after, 1);
+  if (low_after.pa != low_before.pa || low[0] != 0x41 || high[0] != 0x52)
+    fail("rollback-state");
+  after_fork = cowaudit(COWAUDIT_FREE, 0, 0);
+  if (after_fork != setup)
+    fail("rollback-fork-ledger");
+  low_value = (uchar)low[0];
+  high_value = (uchar)high[0];
+  put_byte(go[1], 1);
+  wait_for(holder, 0);
+  arm_fail(7, 0);
+  low[0] = 0x43;
+  fast = fetch_record();
+  low_fast = snapshot(getpid(), (uint64)low);
+  require_private(&low_fast, 1);
+  if (fast.eligible != 0 || low[0] != 0x43 || low_fast.pa != low_after.pa)
+    fail("rollback-preexisting");
+  fast_value = (uchar)low[0];
+  if (sbrk(-growth) == SBRK_ERROR)
+    fail("rollback-shrink-high");
+  close_pair(ready);
+  close_pair(go);
+  release_pages(amount);
+  printf("COW ROLLBACK generation=%d fork=%d fail_at=%d fired=%d eligible=%d "
+         "preexisting_pa=0x%lx "
+         "preexisting_flags=0x%x preexisting_ref=%d preexisting_cow=%d "
+         "new_parent_flags=0x%x new_parent_ref=%d new_parent_cow=%d "
+         "fast_flags=0x%x fast_ref=%d fast_cow=%d "
+         "fast_alloc=%d setup_free=%d after_fork_free=%d values=%d/%d/%d\n",
+         record.generation, failed, record.fail_at, record.fired,
+         record.eligible,
+         low_after.pa, low_after.flags, low_after.ref, low_after.cow,
+         high_after.flags, high_after.ref, high_after.cow, low_fast.flags,
+         low_fast.ref, low_fast.cow, fast.eligible, setup, after_fork,
+         low_value, high_value, fast_value);
+}
