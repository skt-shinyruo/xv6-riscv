+static void
+case_boundaries(void)
+{
+  int ready[2], go[2], amount, pid, status, base;
+  int guard_status, text_status, tail_status;
+  char *tail;
+  uint64 sp;
+  uint64 guard;
+  struct cowaudit_snapshot text_parent, text_child, guard_parent, guard_child;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  asm volatile("mv %0, sp" : "=r"(sp));
+  guard = PGROUNDDOWN(sp) - PGSIZE;
+  must_pipe(ready);
+  must_pipe(go);
+  pid = fork();
+  if (pid < 0)
+    fail("boundary-fork");
+  if (pid == 0) {
+    put_byte(ready[1], 1);
+    get_byte(go[0]);
+    *(volatile uchar *)guard = 0x7a;
+    exit(2);
+  }
+  get_byte(ready[0]);
+  text_parent = snapshot(getpid(), (uint64)&case_boundaries);
+  text_child = snapshot(pid, (uint64)&case_boundaries);
+  guard_parent = snapshot(getpid(), guard);
+  guard_child = snapshot(pid, guard);
+  if (text_parent.pa == 0 || text_parent.pa != text_child.pa ||
+      text_parent.ref < 2 || text_parent.ref != text_child.ref ||
+      (text_parent.flags & (PTE_R | PTE_X | PTE_U)) !=
+          (PTE_R | PTE_X | PTE_U) ||
+      (text_parent.flags & PTE_W) != 0 || text_parent.cow != 0 ||
+      guard_parent.pa == 0 || guard_child.pa == 0 ||
+      guard_parent.pa == guard_child.pa ||
+      (guard_parent.flags & PTE_U) != 0 || guard_parent.cow != 0 ||
+      (guard_child.flags & PTE_U) != 0 || guard_child.cow != 0)
+    fail("boundary-flags");
+  put_byte(go[1], 1);
+  if (wait(&status) != pid || status != -1)
+    fail("boundary-guard-kill");
+  guard_status = status;
+  close_pair(ready);
+  close_pair(go);
+
+  pid = fork();
+  if (pid < 0)
+    fail("boundary-text-fork");
+  if (pid == 0) {
+    *(volatile uint32 *)(uint64)&case_boundaries = 0;
+    exit(2);
+  }
+  if (wait(&status) != pid || status != -1)
+    fail("boundary-text-kill");
+  text_status = status;
+
+  tail = alloc_pages(1, 0, &amount);
+  tail[0] = 0x11;
+  if (sbrk(-(PGSIZE - 1)) == SBRK_ERROR)
+    fail("tail-shrink");
+  pid = fork();
+  if (pid < 0)
+    fail("tail-fork");
+  if (pid == 0) {
+    tail[PGSIZE - 1] = 0x22;
+    exit(tail[PGSIZE - 1] == 0x22 ? 0 : 2);
+  }
+  if (wait(&status) != pid || status != 0)
+    fail("boundary-tail-status");
+  tail_status = status;
+  if (sbrk(-(amount - (PGSIZE - 1))) == SBRK_ERROR)
+    fail("tail-release");
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("boundary-ledger");
+  printf("COW BOUNDARY text_pa=0x%lx text_flags=0x%x text_ref=%d "
+         "text_cow=%d guard_parent_pa=0x%lx guard_child_pa=0x%lx "
+         "guard_flags=0x%x/0x%x guard_cows=%d/%d "
+         "guard_status=%d text_status=%d tail_status=%d\n",
+         text_parent.pa, text_parent.flags, text_parent.ref, text_parent.cow,
+         guard_parent.pa, guard_child.pa, guard_parent.flags,
+         guard_child.flags, guard_parent.cow, guard_child.cow, guard_status,
+         text_status, tail_status);
+}
