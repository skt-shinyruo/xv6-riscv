+static void
+case_lazy_hole(void)
+{
+  int ready[2], go[2], done[2], finish[2], amount, pid, base;
+  char *p;
+  struct cowaudit_snapshot root_before, child_before, root_after, child_after;
+  int parent_value, child_value;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 1, &amount);
+  must_pipe(ready);
+  must_pipe(go);
+  must_pipe(done);
+  must_pipe(finish);
+  pid = fork();
+  if (pid < 0)
+    fail("lazy-fork");
+  if (pid == 0) {
+    put_byte(ready[1], 1);
+    get_byte(go[0]);
+    if (p[0] != 0)
+      exit(2);
+    p[0] = 0x55;
+    put_byte(done[1], p[0]);
+    get_byte(finish[0]);
+    exit(0);
+  }
+  get_byte(ready[0]);
+  root_before = snapshot(getpid(), (uint64)p);
+  child_before = snapshot(pid, (uint64)p);
+  if (root_before.pa != 0 || child_before.pa != 0)
+    fail("lazy-not-hole");
+  put_byte(go[1], 1);
+  child_value = get_byte(done[0]);
+  child_after = snapshot(pid, (uint64)p);
+  root_before = snapshot(getpid(), (uint64)p);
+  require_private(&child_after, 1);
+  if (root_before.pa != 0 || p[0] != 0)
+    fail("lazy-parent-zero");
+  p[0] = 0x66;
+  parent_value = p[0];
+  root_after = snapshot(getpid(), (uint64)p);
+  require_private(&root_after, 1);
+  if (root_after.pa == child_after.pa)
+    fail("lazy-independent");
+  put_byte(finish[1], 1);
+  wait_for(pid, 0);
+  close_pair(ready);
+  close_pair(go);
+  close_pair(done);
+  close_pair(finish);
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("lazy-ledger");
+  printf("COW LAZY before=0/0 before_flags=0x%x/0x%x "
+         "parent_pa=0x%lx child_pa=0x%lx after_flags=0x%x/0x%x "
+         "after_refs=%d/%d after_cows=%d/%d values=%d/%d\n",
+         root_before.flags, child_before.flags, root_after.pa, child_after.pa,
+         root_after.flags, child_after.flags, root_after.ref, child_after.ref,
+         root_after.cow, child_after.cow, parent_value, child_value);
+}
