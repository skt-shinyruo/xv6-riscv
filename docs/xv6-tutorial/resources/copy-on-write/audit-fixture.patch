+static void
+case_store_oom(void)
+{
+  int amount, pid, status, base, fast_value;
+  char *p;
+  struct cowaudit_record failed, fast;
+  struct cowaudit_snapshot parent;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 0, &amount);
+  p[0] = 0x31;
+  pid = fork();
+  if (pid < 0)
+    fail("oom-fork");
+  if (pid == 0) {
+    arm_fail(6, 1);
+    p[0] = 0x32;
+    exit(9);
+  }
+  if (wait(&status) != pid || status != -1)
+    fail("oom-status");
+  failed = fetch_record();
+  parent = snapshot(getpid(), (uint64)p);
+  require_cow(&parent, 1);
+  if (failed.generation != 6 || failed.eligible != 1 || failed.fired != 1 ||
+      p[0] != 0x31)
+    fail("oom-preserve");
+  arm_fail(6, 0);
+  p[0] = 0x33;
+  fast = fetch_record();
+  if (fast.eligible != 0 || p[0] != 0x33)
+    fail("oom-fast");
+  fast_value = (uchar)p[0];
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("oom-ledger");
+  printf("COW OOM generation=%d eligible=%d status=%d fail_at=%d fired=%d "
+         "old_pa=0x%lx "
+         "old_flags=0x%x old_ref=%d old_cow=%d fast_alloc=%d value=%d\n",
+         failed.generation, failed.eligible, status, failed.fail_at,
+         failed.fired, parent.pa, parent.flags,
+         parent.ref, parent.cow, fast.eligible, fast_value);
+}
