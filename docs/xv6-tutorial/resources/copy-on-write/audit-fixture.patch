+static void
+case_teardown(void)
+{
+  int ready[2], done[2], finish[2], bad_pipe[2], amount, pid, base;
+  int shrink_status, exec_status;
+  char *p;
+  struct cowaudit_snapshot parent, child;
+  struct {
+    int result;
+    int value;
+    struct cowaudit_snapshot before;
+    struct cowaudit_snapshot after;
+  } bad;
+  char *argv[] = {"echo", 0};
+  char *bad_argv[] = {"echo", exec_bigarg, exec_bigarg, 0};
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 0, &amount);
+  p[0] = 0x19;
+  must_pipe(ready);
+  must_pipe(done);
+  must_pipe(finish);
+  pid = fork();
+  if (pid < 0)
+    fail("teardown-fork");
+  if (pid == 0) {
+    put_byte(ready[1], 1);
+    if (sbrk(-PGSIZE) == SBRK_ERROR)
+      exit(2);
+    put_byte(done[1], 1);
+    get_byte(finish[0]);
+    exit(0);
+  }
+  get_byte(ready[0]);
+  get_byte(done[0]);
+  parent = snapshot(getpid(), (uint64)p);
+  child = snapshot(pid, (uint64)p);
+  if (parent.pa == 0 || parent.ref != 1 || child.pa != 0)
+    fail("teardown-shrink");
+  put_byte(finish[1], 1);
+  if (wait(&shrink_status) != pid || shrink_status != 0)
+    fail("teardown-shrink-status");
+  close_pair(ready);
+  close_pair(done);
+  close_pair(finish);
+  must_pipe(bad_pipe);
+  pid = fork();
+  if (pid < 0)
+    fail("teardown-bad-exec-fork");
+  if (pid == 0) {
+    bad.before = snapshot(getpid(), (uint64)p);
+    bad.result = exec("echo", bad_argv);
+    bad.after = snapshot(getpid(), (uint64)p);
+    bad.value = (uchar)p[0];
+    if (write(bad_pipe[1], &bad, sizeof(bad)) != sizeof(bad))
+      exit(4);
+    exit(0);
+  }
+  if (read(bad_pipe[0], &bad, sizeof(bad)) != sizeof(bad))
+    fail("teardown-bad-exec-result");
+  wait_for(pid, 0);
+  close_pair(bad_pipe);
+  if (bad.result != -1 || bad.before.pa == 0 ||
+      bad.before.pa != bad.after.pa || bad.before.flags != bad.after.flags ||
+      bad.before.ref != 2 || bad.after.ref != 2 ||
+      bad.before.cow != 1 || bad.after.cow != 1 || bad.value != 0x19)
+    fail("teardown-bad-exec-preserve");
+  pid = fork();
+  if (pid < 0)
+    fail("teardown-exec-fork");
+  if (pid == 0) {
+    exec("echo", argv);
+    exit(3);
+  }
+  if (wait(&exec_status) != pid || exec_status != 0)
+    fail("teardown-exec-status");
+  parent = snapshot(getpid(), (uint64)p);
+  if (parent.ref != 1 || parent.ref_errors != 0)
+    fail("teardown-exec");
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("teardown-ledger");
+  printf("COW TEARDOWN shrink_leaf=%d child_pa=0x%lx parent_pa=0x%lx "
+         "parent_flags=0x%x parent_ref=%d parent_cow=%d "
+         "exec_bad=%d bad_before_pa=0x%lx bad_after_pa=0x%lx "
+         "bad_flags=0x%x/0x%x bad_refs=%d/%d bad_cows=%d/%d bad_value=%d "
+         "exec_status=%d errors=%d\n",
+         child.pa != 0, child.pa, parent.pa, parent.flags, parent.ref,
+         parent.cow, bad.result, bad.before.pa, bad.after.pa,
+         bad.before.flags, bad.after.flags, bad.before.ref, bad.after.ref,
+         bad.before.cow, bad.after.cow, bad.value, exec_status,
+         parent.ref_errors);
+}
+
+static int
+run_cases(void)
+{
+  int completed = 0;
+  volatile char warm[256];
+  for (int i = 0; i < (int)sizeof(warm); i++)
+    warm[i] = (char)i;
+  if (warm[sizeof(warm) - 1] == 0x7f)
+    fail("warmup");
+  case_share_and_fast();
+  completed++;
+  case_multigeneration();
+  completed++;
+  case_lazy_hole();
+  completed++;
+  case_copyout();
+  completed++;
+  case_copyout_partial_oom();
+  completed++;
+  case_store_oom();
+  completed++;
+  case_fork_rollback();
+  completed++;
+  case_pair();
+  completed++;
+  case_boundaries();
+  completed++;
+  case_teardown();
+  completed++;
+  if (snapshot(getpid(), 0).ref_errors != 0)
+    fail("ref-errors");
+  return completed;
+}
+
+int
+main(void)
+{
+  int worker, status, base, after, errors;
+  struct cowaudit_snapshot before, after_snapshot;
+
+  if (cowaudit(COWAUDIT_RESET, 0, 0) < 0)
+    fail("reset");
+  memset(exec_bigarg, 'x', sizeof(exec_bigarg) - 1);
+  exec_bigarg[sizeof(exec_bigarg) - 1] = 0;
+  before = ledger_snapshot();
+  base = before.free_pages;
+  worker = fork();
+  if (worker < 0)
+    fail("worker-fork");
+  if (worker == 0) {
+    int cases = run_cases();
+    printf("COW PASS cases=%d\n", cases);
+    exit(0);
+  }
+  if (wait(&status) != worker || status != 0)
+    fail("worker-status");
+  after_snapshot = ledger_snapshot();
+  after = after_snapshot.free_pages;
+  errors = after_snapshot.ref_errors;
+  if (after != base || errors != 0 ||
+      after_snapshot.active_pages != before.active_pages ||
+      after_snapshot.ref_total != before.ref_total)
+    fail("cleanup-ledger");
+  printf("COW CLEAN base=%d after=%d errors=%d "
+         "active_before=%d active_after=%d refs_before=%d refs_after=%d\n",
+         base, after, errors, before.active_pages, after_snapshot.active_pages,
+         before.ref_total, after_snapshot.ref_total);
+  exit(0);
+}
