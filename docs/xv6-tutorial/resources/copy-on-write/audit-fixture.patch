+static void
+case_copyout(void)
+{
+  int ready[2], go[2], data[2], done[2], finish[2], result[2];
+  int amount, pid, base, parent_value;
+  char *p;
+  uchar pattern[4] = {0x61, 0x62, 0x63, 0x64};
+  uchar observed[4];
+  struct cowaudit_snapshot parent, child;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 0, &amount);
+  memset(p, 0x44, 4);
+  must_pipe(ready);
+  must_pipe(go);
+  must_pipe(data);
+  must_pipe(done);
+  must_pipe(finish);
+  must_pipe(result);
+  pid = fork();
+  if (pid < 0)
+    fail("copyout-fork");
+  if (pid == 0) {
+    put_byte(ready[1], 1);
+    get_byte(go[0]);
+    if (read(data[0], p, 4) != 4 || write(result[1], p, 4) != 4)
+      exit(2);
+    put_byte(done[1], 1);
+    get_byte(finish[0]);
+    exit(0);
+  }
+  get_byte(ready[0]);
+  if (write(data[1], pattern, 4) != 4)
+    fail("copyout-data");
+  put_byte(go[1], 1);
+  get_byte(done[0]);
+  if (read(result[0], observed, 4) != 4)
+    fail("copyout-result");
+  parent = snapshot(getpid(), (uint64)p);
+  child = snapshot(pid, (uint64)p);
+  require_cow(&parent, 1);
+  require_private(&child, 1);
+  if (parent.pa == child.pa || memcmp(observed, pattern, 4) != 0 ||
+      p[0] != 0x44)
+    fail("copyout-isolation");
+  parent_value = (uchar)p[0];
+  put_byte(finish[1], 1);
+  wait_for(pid, 0);
+  close_pair(ready);
+  close_pair(go);
+  close_pair(data);
+  close_pair(done);
+  close_pair(finish);
+  close_pair(result);
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("copyout-ledger");
+  printf("COW COPYOUT parent_pa=0x%lx child_pa=0x%lx "
+         "flags=0x%x/0x%x refs=%d/%d cows=%d/%d "
+         "parent=%d child=%d/%d/%d/%d\n",
+         parent.pa, child.pa, parent.flags, child.flags, parent.ref, child.ref,
+         parent.cow, child.cow, parent_value, observed[0], observed[1],
+         observed[2], observed[3]);
+}
