+static void
+case_pair(void)
+{
+  int ready[2], go[2], done[2], finish0[2], finish1[2];
+  int amount, pids[2], base;
+  int child_values[2];
+  char *p;
+  struct cowaudit_record request, record;
+  struct cowaudit_snapshot root, one, two;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 0, &amount);
+  p[0] = 0x71;
+  must_pipe(ready);
+  must_pipe(go);
+  must_pipe(done);
+  must_pipe(finish0);
+  must_pipe(finish1);
+  for (int i = 0; i < 2; i++) {
+    pids[i] = fork();
+    if (pids[i] < 0)
+      fail("pair-fork");
+    if (pids[i] == 0) {
+      put_byte(ready[1], 1);
+      get_byte(go[0]);
+      p[0] = 0x72 + i;
+      put_byte(done[1], p[0]);
+      get_byte(i == 0 ? finish0[0] : finish1[0]);
+      exit(0);
+    }
+  }
+  get_byte(ready[0]);
+  get_byte(ready[0]);
+  root = snapshot(getpid(), (uint64)p);
+  one = snapshot(pids[0], (uint64)p);
+  two = snapshot(pids[1], (uint64)p);
+  require_cow(&root, 3);
+  require_cow(&one, 3);
+  require_cow(&two, 3);
+  memset(&request, 0, sizeof(request));
+  request.generation = 8;
+  if (cowaudit(COWAUDIT_ARM_PAIR,
+               ((uint64)(uint)pids[0] << 32) | (uint)pids[1], &request) < 0)
+    fail("pair-arm");
+  put_byte(go[1], 1);
+  put_byte(go[1], 1);
+  child_values[0] = get_byte(done[0]);
+  child_values[1] = get_byte(done[0]);
+  root = snapshot(getpid(), (uint64)p);
+  one = snapshot(pids[0], (uint64)p);
+  two = snapshot(pids[1], (uint64)p);
+  record = fetch_record();
+  require_cow(&root, 1);
+  require_private(&one, 1);
+  require_private(&two, 1);
+  if (root.pa == one.pa || root.pa == two.pa || one.pa == two.pa ||
+      record.generation != 8 || record.arrived != 3 ||
+      record.gate_open != 1 || record.eligible != 2 ||
+      record.hart1 == record.hart2 || record.hart1 < 0 || record.hart2 < 0)
+    fail("pair-oracle");
+  put_byte(finish0[1], 1);
+  wait_for(pids[0], 0);
+  put_byte(finish1[1], 1);
+  wait_for(pids[1], 0);
+  close_pair(ready);
+  close_pair(go);
+  close_pair(done);
+  close_pair(finish0);
+  close_pair(finish1);
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("pair-ledger");
+  printf("COW PAIR generation=%d pids=%d/%d harts=%d/%d "
+         "arrived=%d gate_open=%d "
+         "eligible=%d old=0x%lx "
+         "new=0x%lx/0x%lx flags=0x%x/0x%x/0x%x refs=%d/%d/%d "
+         "cows=%d/%d/%d values=%d/%d\n", record.generation, pids[0],
+         pids[1], record.hart1, record.hart2, record.arrived,
+         record.gate_open, record.eligible,
+         root.pa, one.pa, two.pa, root.flags, one.flags, two.flags, root.ref,
+         one.ref, two.ref, root.cow, one.cow, two.cow, child_values[0],
+         child_values[1]);
+}
