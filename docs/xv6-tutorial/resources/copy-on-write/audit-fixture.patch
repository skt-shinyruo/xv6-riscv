+static void
+case_copyout_partial_oom(void)
+{
+  int ready[2], go[2], data[2], done[2], finish[2], result[2];
+  int amount, pid, base;
+  char *p;
+  uchar pattern[32];
+  struct cowaudit_record record;
+  struct cowaudit_snapshot parent1, parent2, child1, child2;
+  int first, second, child_first, child_second, parent_first, parent_second;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(2, 0, &amount);
+  memset(p, 0x41, 2 * PGSIZE);
+  for (int i = 0; i < 32; i++)
+    pattern[i] = 0x20 + i;
+  must_pipe(ready);
+  must_pipe(go);
+  must_pipe(data);
+  must_pipe(done);
+  must_pipe(finish);
+  must_pipe(result);
+  pid = fork();
+  if (pid < 0)
+    fail("partial-fork");
+  if (pid == 0) {
+    put_byte(ready[1], 1);
+    get_byte(go[0]);
+    arm_fail(5, 2);
+    first = read(data[0], p + PGSIZE - 16, 32);
+    record = fetch_record();
+    second = read(data[0], p + PGSIZE, 16);
+    child_first = p[PGSIZE - 16];
+    child_second = p[PGSIZE];
+    if (first != 16 || second != 16 ||
+        memcmp(p + PGSIZE - 16, pattern, 32) != 0)
+      exit(2);
+    if (write(result[1], &record, sizeof(record)) != sizeof(record) ||
+        write(result[1], &first, sizeof(first)) != sizeof(first) ||
+        write(result[1], &second, sizeof(second)) != sizeof(second) ||
+        write(result[1], &child_first, sizeof(child_first)) != sizeof(child_first) ||
+        write(result[1], &child_second, sizeof(child_second)) != sizeof(child_second))
+      exit(3);
+    put_byte(done[1], 1);
+    get_byte(finish[0]);
+    exit(0);
+  }
+  get_byte(ready[0]);
+  if (write(data[1], pattern, sizeof(pattern)) != sizeof(pattern))
+    fail("partial-data");
+  put_byte(go[1], 1);
+  get_byte(done[0]);
+  if (read(result[0], &record, sizeof(record)) != sizeof(record) ||
+      read(result[0], &first, sizeof(first)) != sizeof(first) ||
+      read(result[0], &second, sizeof(second)) != sizeof(second) ||
+      read(result[0], &child_first, sizeof(child_first)) != sizeof(child_first) ||
+      read(result[0], &child_second, sizeof(child_second)) != sizeof(child_second))
+    fail("partial-record");
+  parent1 = snapshot(getpid(), (uint64)(p + PGSIZE - 16));
+  parent2 = snapshot(getpid(), (uint64)(p + PGSIZE));
+  child1 = snapshot(pid, (uint64)(p + PGSIZE - 16));
+  child2 = snapshot(pid, (uint64)(p + PGSIZE));
+  require_cow(&parent1, 1);
+  require_cow(&parent2, 1);
+  require_private(&child1, 1);
+  require_private(&child2, 1);
+  if (parent1.pa == child1.pa || parent2.pa == child2.pa ||
+      record.generation != 5 ||
+      record.eligible != 2 || record.fail_at != 2 || record.fired != 1 ||
+      p[PGSIZE - 16] != 0x41 || p[PGSIZE] != 0x41)
+    fail("partial-oracle");
+  parent_first = (uchar)p[PGSIZE - 16];
+  parent_second = (uchar)p[PGSIZE];
+  put_byte(finish[1], 1);
+  wait_for(pid, 0);
+  close_pair(ready);
+  close_pair(go);
+  close_pair(data);
+  close_pair(done);
+  close_pair(finish);
+  close_pair(result);
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("partial-ledger");
+  printf("COW PARTIAL generation=%d eligible=%d first=%d retry=%d "
+         "fail_at=%d fired=%d "
+         "parent=0x%lx/0x%lx child=0x%lx/0x%lx "
+         "parent_flags=0x%x/0x%x child_flags=0x%x/0x%x "
+         "parent_refs=%d/%d child_refs=%d/%d "
+         "parent_cows=%d/%d child_cows=%d/%d parent_values=%d/%d "
+         "child_values=%d/%d\n",
+         record.generation, record.eligible, first, second, record.fail_at,
+         record.fired,
+         parent1.pa, parent2.pa, child1.pa, child2.pa,
+         parent1.flags, parent2.flags, child1.flags, child2.flags,
+         parent1.ref, parent2.ref, child1.ref, child2.ref,
+         parent1.cow, parent2.cow, child1.cow, child2.cow,
+         parent_first, parent_second, child_first, child_second);
+}
