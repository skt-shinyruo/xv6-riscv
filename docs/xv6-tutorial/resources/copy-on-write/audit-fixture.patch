diff --git a/user/cowtrace.c b/user/cowtrace.c
new file mode 100644
index 0000000..f988ebf
--- /dev/null
+++ b/user/cowtrace.c
@@ -0,0 +1,1028 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/riscv.h"
+#include "kernel/cowaudit.h"
+#include "user/user.h"
+
+#define LEAF_MASK (PTE_V | PTE_R | PTE_W | PTE_X | PTE_U)
+
+static char exec_bigarg[3001];
+
+static void
+fail(const char *why)
+{
+  printf("COW FAIL %s\n", why);
+  exit(1);
+}
+
+static void
+must_pipe(int fd[2])
+{
+  if (pipe(fd) < 0)
+    fail("pipe");
+}
+
+static void
+put_byte(int fd, int value)
+{
+  uchar byte = value;
+  if (write(fd, &byte, 1) != 1)
+    fail("write-byte");
+}
+
+static int
+get_byte(int fd)
+{
+  uchar byte;
+  if (read(fd, &byte, 1) != 1)
+    fail("read-byte");
+  return byte;
+}
+
+static void
+close_pair(int fd[2])
+{
+  close(fd[0]);
+  close(fd[1]);
+}
+
+static void
+wait_for(int pid, int expected)
+{
+  int status = 0x7777;
+  if (wait(&status) != pid || status != expected)
+    fail("wait-status");
+}
+
+static struct cowaudit_snapshot
+snapshot(int pid, uint64 va)
+{
+  struct cowaudit_snapshot result;
+  memset(&result, 0, sizeof(result));
+  result.va = va;
+  if (cowaudit(COWAUDIT_SNAPSHOT, pid, &result) < 0)
+    fail("snapshot");
+  return result;
+}
+
+static struct cowaudit_record
+fetch_record(void)
+{
+  struct cowaudit_record result;
+  memset(&result, 0, sizeof(result));
+  if (cowaudit(COWAUDIT_FETCH, 0, &result) < 0)
+    fail("fetch-record");
+  return result;
+}
+
+static struct cowaudit_snapshot
+ledger_snapshot(void)
+{
+  return snapshot(getpid(), 0);
+}
+
+static void
+arm_fail(int generation, int fail_at)
+{
+  uint64 arg = ((uint64)generation << 32) | (uint)fail_at;
+  if (cowaudit(COWAUDIT_ARM_FAIL, arg, 0) < 0)
+    fail("arm-fail");
+}
+
+static char *
+alloc_pages(int pages, int lazy, int *amount)
+{
+  uint64 top = (uint64)sbrk(0);
+  int pad = (PGSIZE - (top % PGSIZE)) % PGSIZE;
+  char *result;
+
+  if (pad != 0 && sbrk(pad) == SBRK_ERROR)
+    fail("align-sbrk");
+  result = lazy ? sbrklazy(pages * PGSIZE) : sbrk(pages * PGSIZE);
+  if (result == SBRK_ERROR)
+    fail("alloc-pages");
+  *amount = pad + pages * PGSIZE;
+  return result;
+}
+
+static void
+release_pages(int amount)
+{
+  if (sbrk(-amount) == SBRK_ERROR)
+    fail("release-pages");
+}
+
+static void
+require_cow(struct cowaudit_snapshot *s, int ref)
+{
+  if (s->pa == 0 || s->ref != ref || s->cow != 1 ||
+      (s->flags & LEAF_MASK) != (PTE_V | PTE_R | PTE_U))
+    fail("cow-snapshot");
+}
+
+static void
+require_private(struct cowaudit_snapshot *s, int ref)
+{
+  if (s->pa == 0 || s->ref != ref || s->cow != 0 ||
+      (s->flags & (PTE_V | PTE_R | PTE_W | PTE_U)) !=
+          (PTE_V | PTE_R | PTE_W | PTE_U))
+    fail("private-snapshot");
+}
+
+static void
+case_share_and_fast(void)
+{
+  int ready[2], go[2], result[2], amount, pid, base;
+  int parent_value;
+  char *p;
+  struct cowaudit_snapshot before_parent, before_child, after_parent, after_child;
+  struct cowaudit_record parent_record;
+  struct {
+    int value;
+    struct cowaudit_record record;
+    struct cowaudit_snapshot snapshot;
+  } child_result;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 0, &amount);
+  p[0] = 0x11;
+  must_pipe(ready);
+  must_pipe(go);
+  must_pipe(result);
+  pid = fork();
+  if (pid < 0)
+    fail("share-fork");
+  if (pid == 0) {
+    put_byte(ready[1], 1);
+    get_byte(go[0]);
+    arm_fail(1, 0);
+    p[0] = 0x33;
+    child_result.record = fetch_record();
+    child_result.value = p[0];
+    child_result.snapshot = snapshot(getpid(), (uint64)p);
+    require_private(&child_result.snapshot, 1);
+    if (child_result.snapshot.pa == 0)
+      exit(2);
+    if (write(result[1], &child_result, sizeof(child_result)) !=
+        sizeof(child_result))
+      exit(2);
+    exit(0);
+  }
+  get_byte(ready[0]);
+  before_parent = snapshot(getpid(), (uint64)p);
+  before_child = snapshot(pid, (uint64)p);
+  require_cow(&before_parent, 2);
+  require_cow(&before_child, 2);
+  if (before_parent.pa != before_child.pa)
+    fail("share-pa");
+  arm_fail(1, 0);
+  p[0] = 0x22;
+  parent_record = fetch_record();
+  after_parent = snapshot(getpid(), (uint64)p);
+  after_child = snapshot(pid, (uint64)p);
+  require_private(&after_parent, 1);
+  require_cow(&after_child, 1);
+  if (after_parent.pa == after_child.pa || p[0] != 0x22 ||
+      parent_record.eligible != 1)
+    fail("share-parent-split");
+  put_byte(go[1], 1);
+  if (read(result[0], &child_result, sizeof(child_result)) !=
+      sizeof(child_result))
+    fail("share-result");
+  wait_for(pid, 0);
+  if (child_result.value != 0x33 || child_result.record.eligible != 0 ||
+      child_result.record.fired != 0)
+    fail("share-fast-path");
+  parent_value = p[0];
+  close_pair(ready);
+  close_pair(go);
+  close_pair(result);
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("share-ledger");
+  printf("COW SHARE pa=0x%lx parent_new=0x%lx child_old=0x%lx "
+         "before_flags=0x%x/0x%x before_refs=%d/%d before_cows=%d/%d "
+         "after_flags=0x%x/0x%x after_refs=%d/%d after_cows=%d/%d "
+         "fast_flags=0x%x fast_ref=%d fast_cow=%d "
+         "parent_alloc=%d child_alloc=%d values=%d/%d\n",
+         before_parent.pa, after_parent.pa, after_child.pa,
+         before_parent.flags, before_child.flags, before_parent.ref,
+         before_child.ref, before_parent.cow, before_child.cow,
+         after_parent.flags, after_child.flags, after_parent.ref,
+         after_child.ref, after_parent.cow, after_child.cow,
+         child_result.snapshot.flags, child_result.snapshot.ref,
+         child_result.snapshot.cow, parent_record.eligible,
+         child_result.record.eligible, parent_value, child_result.value);
+}
+
+static void
+case_multigeneration(void)
+{
+  int ready[2], grand_go[2], child_go[2], finish[2], result[2];
+  int amount, pid, first, second, grand, base;
+  int first_result[2], second_result[2];
+  char *p;
+  struct cowaudit_snapshot before_root, before_child, before_grand;
+  struct cowaudit_snapshot after_root;
+  struct {
+    int pid;
+    int value;
+    struct cowaudit_snapshot snapshot;
+  } writer, observer;
+  int before_root_value, before_child_value, before_grand_value;
+  int after_root_value;
+
+  base = cowaudit(COWAUDIT_FREE, 0, 0);
+  p = alloc_pages(1, 0, &amount);
+  p[0] = 0x21;
+  must_pipe(ready);
+  must_pipe(grand_go);
+  must_pipe(child_go);
+  must_pipe(finish);
+  must_pipe(result);
+  pid = fork();
+  if (pid < 0)
+    fail("multi-fork1");
+  if (pid == 0) {
+    int grand = fork();
+    if (grand < 0)
+      exit(2);
+    if (grand == 0) {
+      int observed[2] = {getpid(), (uchar)p[0]};
+      if (write(ready[1], observed, sizeof(observed)) != sizeof(observed))
+        exit(3);
+      get_byte(grand_go[0]);
+      p[0] = 0x2a;
+      writer.pid = getpid();
+      writer.value = (uchar)p[0];
+      writer.snapshot = snapshot(getpid(), (uint64)p);
+      if (write(result[1], &writer, sizeof(writer)) != sizeof(writer))
+        exit(4);
+      get_byte(finish[0]);
+      exit(0);
+    }
+    {
+      int observed[2] = {getpid(), (uchar)p[0]};
+      int status;
+      if (write(ready[1], observed, sizeof(observed)) != sizeof(observed))
+        exit(5);
+      get_byte(child_go[0]);
+      observer.pid = getpid();
+      observer.value = (uchar)p[0];
+      observer.snapshot = snapshot(getpid(), (uint64)p);
+      if (write(result[1], &observer, sizeof(observer)) != sizeof(observer))
+        exit(6);
+      get_byte(finish[0]);
+      if (wait(&status) != grand || status != 0)
+        exit(7);
+      exit(0);
+    }
+  }
+  if (read(ready[0], first_result, sizeof(first_result)) != sizeof(first_result) ||
+      read(ready[0], second_result, sizeof(second_result)) != sizeof(second_result))
+    fail("multi-ready");
+  first = first_result[0];
+  second = second_result[0];
+  if (first != pid && second != pid)
+    fail("multi-child-pid");
+  grand = first == pid ? second : first;
+  before_root = snapshot(getpid(), (uint64)p);
+  before_child = snapshot(pid, (uint64)p);
+  before_grand = snapshot(grand, (uint64)p);
+  require_cow(&before_root, 3);
+  require_cow(&before_child, 3);
+  require_cow(&before_grand, 3);
+  if (before_root.pa != before_child.pa || before_root.pa != before_grand.pa)
+    fail("multi-pa");
+  before_root_value = (uchar)p[0];
+  before_child_value = first == pid ? first_result[1] : second_result[1];
+  before_grand_value = first == pid ? second_result[1] : first_result[1];
+  put_byte(grand_go[1], 1);
+  if (read(result[0], &writer, sizeof(writer)) != sizeof(writer) ||
+      writer.pid != grand)
+    fail("multi-writer");
+  put_byte(child_go[1], 1);
+  if (read(result[0], &observer, sizeof(observer)) != sizeof(observer) ||
+      observer.pid != pid)
+    fail("multi-observer");
+  after_root = snapshot(getpid(), (uint64)p);
+  require_cow(&after_root, 2);
+  require_cow(&observer.snapshot, 2);
+  require_private(&writer.snapshot, 1);
+  if (after_root.pa != observer.snapshot.pa ||
+      after_root.pa != before_root.pa || after_root.pa == writer.snapshot.pa ||
+      p[0] != 0x21 || observer.value != 0x21 || writer.value != 0x2a)
+    fail("multi-write-isolation");
+  after_root_value = (uchar)p[0];
+  put_byte(finish[1], 1);
+  put_byte(finish[1], 1);
+  wait_for(pid, 0);
+  close_pair(ready);
+  close_pair(grand_go);
+  close_pair(child_go);
+  close_pair(finish);
+  close_pair(result);
+  release_pages(amount);
+  if (cowaudit(COWAUDIT_FREE, 0, 0) != base)
+    fail("multi-ledger");
+  printf("COW MULTI root=%d child=%d grandchild=%d shared_pa=0x%lx "
+         "before_flags=0x%x/0x%x/0x%x before_refs=%d/%d/%d "
+         "before_cows=%d/%d/%d after_pa=0x%lx/0x%lx/0x%lx "
+         "after_flags=0x%x/0x%x/0x%x after_refs=%d/%d/%d "
+         "after_cows=%d/%d/%d before_values=%d/%d/%d "
+         "after_values=%d/%d/%d\n",
+         getpid(), pid, grand, before_root.pa, before_root.flags,
+         before_child.flags, before_grand.flags, before_root.ref,
+         before_child.ref, before_grand.ref, before_root.cow, before_child.cow,
+         before_grand.cow, after_root.pa, observer.snapshot.pa,
+         writer.snapshot.pa, after_root.flags, observer.snapshot.flags,
+         writer.snapshot.flags, after_root.ref, observer.snapshot.ref,
+         writer.snapshot.ref, after_root.cow, observer.snapshot.cow,
+         writer.snapshot.cow, before_root_value, before_child_value,
+         before_grand_value, after_root_value, observer.value, writer.value);
+}
