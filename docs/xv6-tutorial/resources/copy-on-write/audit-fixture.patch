diff --git a/kernel/cowaudit.c b/kernel/cowaudit.c
new file mode 100644
index 0000000..378adfe
--- /dev/null
+++ b/kernel/cowaudit.c
@@ -0,0 +1,212 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "proc.h"
+#include "defs.h"
+#include "cowaudit.h"
+
+extern struct proc proc[NPROC];
+
+// The learner supplies this narrow audit adapter. Its implementation may wrap
+// any COW bit and ownership structure chosen by the private candidate.
+extern uint cowproject_ref(uint64);
+extern uint cowproject_active(void);
+extern uint cowproject_total(void);
+extern uint cowproject_errors(void);
+extern int cowproject_free_pages(void);
+extern int cowproject_is_cow(pte_t);
+
+static struct {
+  struct spinlock lock;
+  int active;
+  struct cowaudit_record record;
+} audit;
+
+void
+cowauditinit(void)
+{
+  initlock(&audit.lock, "cowaudit");
+}
+
+static int
+copy_record(uint64 out)
+{
+  struct proc *p = myproc();
+  struct cowaudit_record record;
+
+  acquire(&audit.lock);
+  record = audit.record;
+  audit.active = 0;
+  audit.record.mode = COWAUDIT_MODE_NONE;
+  release(&audit.lock);
+  return copyout(p->pagetable, out, (char *)&record, sizeof(record));
+}
+
+static int
+snapshot_process(int pid, uint64 out)
+{
+  struct proc *caller = myproc();
+  struct cowaudit_snapshot snapshot;
+  struct proc *target = 0;
+  pte_t pte_value = 0;
+  pte_t *pte;
+  uint ref_again, active_again, total_again, errors_again;
+  int cow_again, free_again;
+
+  if (copyin(caller->pagetable, (char *)&snapshot, out, sizeof(snapshot)) < 0)
+    return -1;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == pid && p->state != UNUSED) {
+      target = p;
+      break;
+    }
+    release(&p->lock);
+  }
+  if (target == 0)
+    return -1;
+  snapshot.pid = target->pid;
+  snapshot.state = target->state;
+  snapshot.sz = target->sz;
+  snapshot.va = PGROUNDDOWN(snapshot.va);
+  snapshot.pa = 0;
+  snapshot.flags = 0;
+  snapshot.cow = 0;
+  snapshot.ref = 0;
+  pte = walk(target->pagetable, snapshot.va, 0);
+  if (pte != 0 && (*pte & PTE_V) != 0) {
+    pte_value = *pte;
+    snapshot.pa = PTE2PA(pte_value);
+    snapshot.flags = PTE_FLAGS(pte_value);
+    snapshot.cow = cowproject_is_cow(pte_value);
+    snapshot.ref = cowproject_ref(snapshot.pa);
+  }
+  release(&target->lock);
+  snapshot.free_pages = cowproject_free_pages();
+  snapshot.active_pages = cowproject_active();
+  snapshot.ref_total = cowproject_total();
+  snapshot.ref_errors = cowproject_errors();
+  cow_again = snapshot.pa == 0 ? 0 : cowproject_is_cow(pte_value);
+  ref_again = snapshot.pa == 0 ? 0 : cowproject_ref(snapshot.pa);
+  free_again = cowproject_free_pages();
+  active_again = cowproject_active();
+  total_again = cowproject_total();
+  errors_again = cowproject_errors();
+  if (cow_again != snapshot.cow || ref_again != snapshot.ref ||
+      free_again != snapshot.free_pages || active_again != snapshot.active_pages ||
+      total_again != snapshot.ref_total || errors_again != snapshot.ref_errors)
+    return -1;
+  return copyout(caller->pagetable, out, (char *)&snapshot, sizeof(snapshot));
+}
+
+int
+cowaudit_command(int op, uint64 arg, uint64 out)
+{
+  struct proc *p = myproc();
+  struct cowaudit_record requested;
+
+  if (op == COWAUDIT_RESET) {
+    acquire(&audit.lock);
+    memset(&audit.record, 0, sizeof(audit.record));
+    audit.active = 0;
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == COWAUDIT_FREE)
+    return cowproject_free_pages();
+  if (op == COWAUDIT_SNAPSHOT)
+    return snapshot_process((int)arg, out);
+  if (op == COWAUDIT_FETCH)
+    return copy_record(out);
+  if (op == COWAUDIT_ARM_FAIL) {
+    if ((arg >> 32) == 0)
+      return -1;
+    acquire(&audit.lock);
+    memset(&audit.record, 0, sizeof(audit.record));
+    audit.record.generation = arg >> 32;
+    audit.record.mode = COWAUDIT_MODE_FAIL;
+    audit.record.target1 = p->pid;
+    audit.record.fail_at = arg & 0xffffffff;
+    audit.active = 1;
+    release(&audit.lock);
+    return 0;
+  }
+  if (op == COWAUDIT_ARM_PAIR) {
+    if (copyin(p->pagetable, (char *)&requested, out, sizeof(requested)) < 0)
+      return -1;
+    if (requested.generation <= 0)
+      return -1;
+    acquire(&audit.lock);
+    memset(&audit.record, 0, sizeof(audit.record));
+    audit.record.generation = requested.generation;
+    audit.record.mode = COWAUDIT_MODE_PAIR;
+    audit.record.target1 = arg >> 32;
+    audit.record.target2 = arg & 0xffffffff;
+    audit.record.hart1 = -1;
+    audit.record.hart2 = -1;
+    audit.active = 1;
+    release(&audit.lock);
+    return 0;
+  }
+  return -1;
+}
+
+int
+cowaudit_kalloc_gate(void)
+{
+  struct proc *p;
+  int bit;
+
+  p = myproc();
+  if (p == 0)
+    return 0;
+  acquire(&audit.lock);
+  if (!audit.active || audit.record.generation <= 0 ||
+      (p->pid != audit.record.target1 && p->pid != audit.record.target2)) {
+    release(&audit.lock);
+    return 0;
+  }
+  if (audit.record.mode == COWAUDIT_MODE_FAIL) {
+    if (audit.record.fired) {
+      release(&audit.lock);
+      return 0;
+    }
+    audit.record.eligible++;
+    if (audit.record.fail_at != 0 &&
+        audit.record.eligible == audit.record.fail_at) {
+      audit.record.fired = 1;
+      release(&audit.lock);
+      return 1;
+    }
+    release(&audit.lock);
+    return 0;
+  }
+  if (audit.record.mode != COWAUDIT_MODE_PAIR || audit.record.gate_open) {
+    release(&audit.lock);
+    return 0;
+  }
+  bit = p->pid == audit.record.target1 ? 1 : 2;
+  if ((audit.record.arrived & bit) == 0) {
+    audit.record.arrived |= bit;
+    audit.record.eligible++;
+    if (bit == 1)
+      audit.record.hart1 = cpuid();
+    else
+      audit.record.hart2 = cpuid();
+  }
+  if (audit.record.arrived == 3)
+    audit.record.gate_open = 1;
+  release(&audit.lock);
+
+  while (1) {
+    int open;
+    acquire(&audit.lock);
+    open = audit.record.gate_open;
+    release(&audit.lock);
+    if (open)
+      break;
+  }
+  return 0;
+}
diff --git a/kernel/cowaudit.h b/kernel/cowaudit.h
new file mode 100644
index 0000000..2a732e0
--- /dev/null
+++ b/kernel/cowaudit.h
@@ -0,0 +1,39 @@
+#define COWAUDIT_RESET      1
+#define COWAUDIT_SNAPSHOT   2
+#define COWAUDIT_ARM_FAIL   3
+#define COWAUDIT_ARM_PAIR   4
+#define COWAUDIT_FETCH      5
+#define COWAUDIT_FREE       6
+
+#define COWAUDIT_MODE_NONE  0
+#define COWAUDIT_MODE_FAIL  1
+#define COWAUDIT_MODE_PAIR  2
+
+struct cowaudit_snapshot {
+  int pid;
+  int state;
+  int flags;
+  int cow;
+  int ref;
+  int free_pages;
+  int active_pages;
+  int ref_total;
+  int ref_errors;
+  uint64 va;
+  uint64 pa;
+  uint64 sz;
+};
+
+struct cowaudit_record {
+  int generation;
+  int mode;
+  int target1;
+  int target2;
+  int eligible;
+  int fail_at;
+  int fired;
+  int arrived;
+  int gate_open;
+  int hart1;
+  int hart2;
+};
